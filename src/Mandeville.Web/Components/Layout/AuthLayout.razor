@inherits LayoutComponentBase
@inject IConfiguration Configuration
@* Split-screen shell shared by sign-in, forgot-password, change-password and access-denied.
   Desktop: light blue hero on the left, a curved white form panel on the right.
   Phone: white header bar, hero banner, then the form on a curved white sheet. *@
<div class="auth-page">
    <div class="auth-split">
        <ThemeToggle Class="floating" />

        <header class="m-bar">
            <a class="m-brand" href="/account/signin" aria-label="@_group">
                <BrandMark Size="24" />
                <span class="m-brand-name">@_first<span>@_rest</span></span>
            </a>
            <div class="m-actions">
                <ThemeToggle />
                <details class="m-menu">
                    <summary aria-label="Menu"><Icon Name="menu" Size="22" Stroke="1.6" /></summary>
                    <nav>
                        <a href="/account/signin">Sign in</a>
                        <a href="/account/forgot">Forgot password</a>
                        @if (!string.IsNullOrWhiteSpace(_contactEmail))
                        {
                            <a href="@ContactHref">Contact us</a>
                        }
                    </nav>
                </details>
            </div>
        </header>

        <aside class="auth-hero" aria-label="Welcome">
            <div class="hero-inner">
                <div class="hero-brand">
                    <BrandMark Size="34" />
                    <span class="hero-name"><b>@_first</b><span>@_rest</span></span>
                    @if (!string.IsNullOrWhiteSpace(_ministers))
                    {
                        <span class="hero-rule" aria-hidden="true"></span>
                        <span class="hero-tag">@_ministers</span>
                    }
                </div>

                <div class="hero-copy">
                    <h2 class="hero-title">Planted in Mandeville.<br />Sent to <span class="hero-accent">Make Disciples.<svg viewBox="0 0 120 12" preserveAspectRatio="none" aria-hidden="true"><path d="M2 8c22-7 50-8 116-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" /></svg></span></h2>
                    <p class="hero-verse">“Go ye therefore, and teach all nations… and, lo, I am with you alway.”</p>
                    <p class="hero-ref">— MATTHEW 28:19–20</p>
                </div>
            </div>
        </aside>

        <main class="auth-panel">
            <div class="auth-card">
                @Body
            </div>
        </main>

        <div class="auth-waves" aria-hidden="true"></div>
        <p class="auth-foot">&copy; @DateTime.Now.Year @_group</p>
    </div>
</div>

@code {
    private string _group = "WAFIF Mandeville";
    private string _first = "WAFIF";
    private string _rest = "Mandeville";
    private string? _ministers;
    private string? _contactEmail;

    private string ContactHref => "mailto:" + _contactEmail;

    protected override void OnInitialized()
    {
        _group = Configuration["Church:GroupName"] ?? _group;
        var parts = _group.Split(' ', 2, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        _first = parts.Length > 0 ? parts[0] : _group;
        _rest = parts.Length > 1 ? parts[1] : string.Empty;
        _ministers = Configuration["Church:Ministers"];
        _contactEmail = Configuration["Church:ContactEmail"];
    }
}
