@page "/account/signin"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@inject AccountService Accounts
@inject NavigationManager Navigation

<PageTitle>Sign in</PageTitle>

<h1 class="auth-title">Sign in</h1>
<p class="auth-sub">Use the email address and password you were given.</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="auth-error" role="alert">@_error</div>
}

<EditForm Model="Input" FormName="signin" OnValidSubmit="SubmitAsync" method="post">
    <DataAnnotationsValidator />
    <label class="auth-label" for="email">Email</label>
    <InputText id="email" type="email" class="auth-input" @bind-Value="Input.Email" autocomplete="username" autofocus />
    <label class="auth-label" for="password">Password</label>
    <InputText id="password" type="password" class="auth-input" @bind-Value="Input.Password" autocomplete="current-password" />
    <ValidationSummary class="auth-error" />
    <button type="submit" class="btn btn-primary btn-sm auth-submit">Sign in</button>
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private SignInInput Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _error;

    private async Task SubmitAsync()
    {
        var (user, error) = await Accounts.ValidateAsync(Input.Email, Input.Password);
        if (user is null)
        {
            _error = error;
            return;
        }

        var principal = await Accounts.CreatePrincipalAsync(user);
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, principal,
            new AuthenticationProperties { IsPersistent = false });

        // A temporary password must be replaced before anything else
        var target = user.fblnMustChangePassword
            ? "/account/password" + (ReturnUrl is null ? "" : "?returnUrl=" + Uri.EscapeDataString(ReturnUrl))
            : AccountService.SafeReturnUrl(ReturnUrl) ?? AccountService.LandingFor(principal);

        Navigation.NavigateTo(target, forceLoad: true);
    }

    private sealed class SignInInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        public string? Email { get; set; }

        [Required(ErrorMessage = "Enter your password.")]
        public string? Password { get; set; }
    }
}
