@page "/account/password"
@layout AuthLayout
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using global::Mandeville.Library.Repository
@inject AccountService Accounts
@inject IAppUserRepository UserRepo
@inject NavigationManager Navigation

<PageTitle>Choose a password</PageTitle>

<h1 class="auth-title">@(_forced ? "Choose your own password" : "Change password")</h1>
<p class="auth-sub">@(_forced ? "You are using a temporary password. Choose one only you know." : "Enter your current password, then choose a new one.")</p>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="auth-error" role="alert">@_error</div>
}

<EditForm Model="Input" FormName="changepassword" OnValidSubmit="SubmitAsync" method="post">
    <DataAnnotationsValidator />
    <label class="auth-label" for="current">Current password</label>
    <InputText id="current" type="password" class="auth-input" @bind-Value="Input.Current" autocomplete="current-password" />
    <label class="auth-label" for="new">New password</label>
    <InputText id="new" type="password" class="auth-input" @bind-Value="Input.New" autocomplete="new-password" />
    <div class="auth-hint">At least 8 characters, with letters and a number.</div>
    <label class="auth-label" for="confirm">Repeat new password</label>
    <InputText id="confirm" type="password" class="auth-input" @bind-Value="Input.Confirm" autocomplete="new-password" />
    <ValidationSummary class="auth-error" />
    <button type="submit" class="btn btn-primary btn-sm auth-submit">Save password</button>
    @if (!_forced)
    {
        <a class="btn btn-ghost btn-sm" href="@_landing">Cancel</a>
    }
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;
    [SupplyParameterFromForm] private PasswordInput Input { get; set; } = new();
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _error;
    private bool _forced;
    private string _landing = "/";

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _forced = user.HasClaim(AppClaims.MustChange, "1");
        _landing = AccountService.LandingFor(user);
    }

    private async Task SubmitAsync()
    {
        var policy = AccountService.CheckPolicy(Input.New);
        if (policy is not null) { _error = policy; return; }

        var principal = (await AuthState).User;
        if (!Guid.TryParse(principal.FindFirstValue(ClaimTypes.NameIdentifier), out var key)) { _error = "Please sign in again."; return; }

        var account = (await UserRepo.SelectAppUser(key: key)).FirstOrDefault();
        if (account is null || !account.fblnActive) { _error = "Please sign in again."; return; }

        var (verified, _) = await Accounts.ValidateAsync(account.fstrEmail, Input.Current);
        if (verified is null) { _error = "Your current password is not correct."; return; }

        account.fstrPasswordHash = string.Empty; // replaced below
        var saved = await Accounts.SetPasswordAsync(account, Input.New!, mustChange: false, who: account.fstrDisplayName);
        if (saved.ToastType != ToastTypeModel.Success) { _error = saved.Message; return; }

        // Re-issue the cookie without the "must change" flag
        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, await Accounts.CreatePrincipalAsync(account));

        Navigation.NavigateTo(AccountService.SafeReturnUrl(ReturnUrl) ?? AccountService.LandingFor(await Accounts.CreatePrincipalAsync(account)), forceLoad: true);
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string? Current { get; set; }

        [Required(ErrorMessage = "Enter a new password.")]
        public string? New { get; set; }

        [Required(ErrorMessage = "Repeat the new password.")]
        [Compare(nameof(New), ErrorMessage = "The two new passwords do not match.")]
        public string? Confirm { get; set; }
    }
}
