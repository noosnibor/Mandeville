@page "/"
@page "/dashboard"
@attribute [PageAccess(PageKeys.Dashboard, "Dashboard", "Overview", "dashboard", Tint = "c1", Order = 0)]
@implements IDisposable
@inject IConfiguration Configuration
@inject IMemberRepository MemberRepo
@inject IVisitorRepository VisitorRepo
@inject IVisitorAttendanceRepository VisitorAttendanceRepo
@inject IFinanceRepository FinanceRepo
@inject IExpenditureRepository ExpenditureRepo
@inject IMemberAttendanceRepository MemberAttendanceRepo
@inject IServiceRepository ServiceRepo
@inject IPastoralContactRepository PastoralContactRepo

<PageTitle>Dashboard</PageTitle>

<div class="dk">

<div class="page-head dk-head">
    <div class="ph-title"><div><h1>Dashboard</h1><p>@(Configuration["Church:GroupName"] ?? "WAFIF Mandeville")</p></div></div>
    <span class="dk-date">@AppClock.Today.ToString("d MMM yyyy")</span>
</div>

@if (__error is not null)
{
    <div class="toast-bar toast-danger">@__error</div>
}
else if (!__loaded)
{
    <p class="hint">Loading the dashboard&hellip;</p>
}
else
{
    @* Tablet and desktop: stat cards (the strip below is for the phone) *@
    <div class="kcards">
        <div class="kcard" style="--c:#1c86f2"><div class="kc-h"><span>Total members</span><span class="kc-i"><Icon Name="users" Size="17" Stroke="1.8" /></span></div><b>@__totalMembers</b><small>On the roll</small></div>
        <div class="kcard" style="--c:#10b981"><div class="kc-h"><span>Active</span><span class="kc-i"><Icon Name="check" Size="17" Stroke="2" /></span></div><b>@__activeMembers</b><small><em>@ActivePercent%</em> of members</small></div>
        <div class="kcard" style="--c:#8b5cf6"><div class="kc-h"><span>Last service</span><span class="kc-i"><Icon Name="calendar" Size="17" Stroke="1.8" /></span></div><b>@__lastServicePresent</b><small>Members present</small></div>
        <div class="kcard" style="--c:#0ea5e9"><div class="kc-h"><span>Avg attendance</span><span class="kc-i"><Icon Name="chart" Size="17" Stroke="1.8" /></span></div><b>@__averageAttendance%</b><small>Of active members</small></div>
        <a class="kcard" style="--c:#f59e0b" href="members"><div class="kc-h"><span>Not seen</span><span class="kc-i"><Icon Name="eye" Size="17" Stroke="1.8" /></span></div><b>@__notSeen.Count</b><small>In 3+ weeks</small></a>
        <a class="kcard" style="--c:#ef4444" href="connect"><div class="kc-h"><span>Visitors</span><span class="kc-i"><Icon Name="link" Size="17" Stroke="1.8" /></span></div><b>@__unconnected.Count</b><small>Not connected yet</small></a>
    </div>

 @*    <div class="kstrip card dk-strip">
        <div class="on"><b>@__totalMembers</b><span>Total members</span></div>
        <div><b>@__activeMembers</b><span>Active (@ActivePercent%)</span></div>
        <div><b>@__lastServicePresent</b><span>Present last service</span></div>
        <div><b>@__averageAttendance%</b><span>Average attendance</span></div>
        <a class="warn" href="members"><b>@__notSeen.Count</b><span>Not seen in 3+ weeks</span></a>
        <a class="warn" href="connect"><b>@__unconnected.Count</b><span>Visitors not connected</span></a>
    </div> *@

    <div class="dk-grid">
        @* ---------- Attendance (members or visitors) ---------- *@
        <section class="dk-card">
            @{
                var series = __chart == "visitors" ? __perService : __membersPerService;
            }
            <div class="dk-ch">
                <h3>Attendance <small>Last @series.Count @(series.Count == 1 ? "service" : "services")</small></h3>
                <div class="dk-seg">
                    <button class="@(__chart == "members" ? "on" : "")" @onclick='() => __chart = "members"'>Members</button>
                    <button class="@(__chart == "visitors" ? "on" : "")" @onclick='() => __chart = "visitors"'>Visitors</button>
                </div>
            </div>
            @if (series.Count == 0)
            {
                <p class="hint">@(__chart == "visitors" ? "No visitor attendance has been recorded yet." : "No member check-ins have been recorded yet.")</p>
            }
            else
            {
                var top = Math.Max(1, series.Max(x => x.Count));
                <div class="dk-bars">
                    @foreach (var x in series)
                    {
                        <div class="dk-col"><em>@x.Count</em><i style="height:@(Pct(x.Count, top))%"></i></div>
                    }
                </div>
                <div class="dk-xl">
                    @foreach (var x in series) { <span>@x.Date.ToString("d MMM")</span> }
                </div>
            }
        </section>

        @* ---------- Needs attention (one list, three views) ---------- *@
        <section class="dk-card">
            <div class="dk-ch">
                <h3>Needs attention</h3>
                <div class="dk-seg">
                    <button class="@(__attn == "visit" ? "on" : "")" @onclick='() => __attn = "visit"'>Visit or call</button>
                    <button class="@(__attn == "flagged" ? "on" : "")" @onclick='() => __attn = "flagged"'>Flagged@(__flagged.Count > 0 ? " " + __flagged.Count : "")</button>
                    <button class="@(__attn == "conn" ? "on" : "")" @onclick='() => __attn = "conn"'>Not connected</button>
                </div>
            </div>

            @if (__attn == "visit")
            {
                @if (__notSeen.Count == 0) { <p class="hint">Everyone has been in recently.</p> }
                @foreach (var n in __notSeen.Take(3))
                {
                    <div class="dk-li">
                        <span class="dash-avatar" style="background:@AvatarStyle.Colour(n.Member.flngKey)">@AvatarStyle.Initials(n.Member.fstrFirstname, n.Member.fstrLastname)</span>
                        <div class="dk-t">
                            <b>@n.Member.FullName</b>
                            <small>@(n.LastSeen is { } ls ? "Last seen " + ls.ToString("d MMM") : "Never checked in") &middot; @(string.IsNullOrWhiteSpace(n.Member.fstrCarerName) ? "No carer" : "Carer: " + n.Member.fstrCarerName)</small>
                        </div>
                        <span class="chip @(n.Weeks is null ? "" : n.Weeks >= 4 ? "r" : "w")">@(n.Weeks is { } w ? $"{w} wks" : "Never")</span>
                    </div>
                }
                @if (__notSeen.Count > 3) { <small class="dk-more-n">and @(__notSeen.Count - 3) more</small> }
                <a class="dk-more" href="members">View members &rarr;</a>
            }
            else if (__attn == "flagged")
            {
                @if (__flagged.Count == 0) { <p class="hint">Nothing has been flagged. Carers can flag a member from the Pastoral Care page.</p> }
                @foreach (var f in __flagged.Take(3))
                {
                    <div class="dk-li">
                        <span class="dash-avatar" style="background:@AvatarStyle.Colour(f.flngMemberKey)">@AvatarStyle.Initials(f.fstrMemberName ?? "?", string.Empty)</span>
                        <div class="dk-t">
                            <b>@f.fstrMemberName</b>
                            <small>Flagged by @f.fstrCoreMemberName &middot; @f.fdtmContactDate.ToString("d MMM")</small>
                        </div>
                        <span class="chip r">Minister</span>
                    </div>
                }
                @if (__flagged.Count > 3) { <small class="dk-more-n">and @(__flagged.Count - 3) more</small> }
                <a class="dk-more" href="pastoral">Open Pastoral Care &rarr;</a>
            }
            else
            {
                @if (__unconnected.Count == 0) { <p class="hint">Everyone has a connector.</p> }
                @foreach (var v in __unconnected.Take(3))
                {
                    <div class="dk-li">
                        <span class="dash-avatar" style="background:@AvatarStyle.Colour(v.flngKey)">@AvatarStyle.Initials(v.fstrFirstname, v.fstrLastname)</span>
                        <div class="dk-t">
                            <b>@v.FullName</b>
                            @if (v.fdtmLastAttended is { } seen) { <small>Last attended @seen.ToString("d MMM")</small> }
                        </div>
                        @if (v.fdtmLastAttended is { } last)
                        {
                            var days = Math.Max(0, (AppClock.Today - last.Date).Days);
                            <span class="chip">@(days == 0 ? "today" : $"{days} days")</span>
                        }
                    </div>
                }
                @if (__unconnected.Count > 3) { <small class="dk-more-n">and @(__unconnected.Count - 3) more</small> }
                <a class="dk-more" href="connect">Assign connectors &rarr;</a>
            }
        </section>
    </div>

    @* Tablet and desktop: donut, bars and a line chart *@
    <div class="dk-grid dk-charts">
        <section class="dk-card">
            <div class="dk-ch"><h3>Members <small>@__totalMembers on the roll</small></h3></div>
            <div class="dn-donut" style="background:conic-gradient(#1c86f2 0 @(ActivePercent)%, #94a3b8 @(ActivePercent)% 100%)"><div><b>@(ActivePercent)%</b><span>active</span></div></div>
            <div class="dn-lg"><span><i style="background:#1c86f2"></i><b>@__activeMembers</b> Active</span><span><i style="background:#94a3b8"></i><b>@(__totalMembers - __activeMembers)</b> Inactive</span></div>
        </section>

        <section class="dk-card">
            <div class="dk-ch"><h3>Care coverage <small>@CarePercent% have a carer</small></h3></div>
            <div class="dn-hb">
                <div><div class="dn-t"><span>With a carer</span><b>@__careCovered</b></div><div class="dn-tr"><i style="width:@(CarePercent)%;background:linear-gradient(90deg,#38a8ff,#1670d6)"></i></div></div>
                <div><div class="dn-t"><span>Without a carer</span><b>@(__careTotal - __careCovered)</b></div><div class="dn-tr"><i style="width:@(100 - CarePercent)%;background:#f59e0b"></i></div></div>
                <div><div class="dn-t"><span>Core members</span><b>@__coreCount</b></div><div class="dn-tr"><i style="width:@(__totalMembers == 0 ? 0 : (int)Math.Round(100.0 * __coreCount / __totalMembers))%;background:#ec4899"></i></div></div>
            </div>
            <a class="dk-more" href="pastoral">Assign carers &rarr;</a>
        </section>

        <section class="dk-card">
            @{
                var lineTop = Math.Max(1m, __months.Count == 0 ? 1m : __months.Max(x => Math.Max(x.In, x.Out)));
            }
            <div class="dk-ch"><h3>Collection balance <small>Last 6 months</small></h3></div>
            <div class="dn-big"><b class="@(__balance < 0 ? "neg" : "")">@Money(__balance)</b><span>+ @Money(__collected) collected</span></div>
            <div class="dn-klg"><span><i style="background:#10b981"></i>Collected</span><span><i style="background:#ef4444"></i>Spent @Money(__spent)</span></div>
            <svg class="dn-line" viewBox="0 0 490 216" role="img" aria-label="Collected and spent over the last 6 months">
                <defs><linearGradient id="dnFill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#10b981" stop-opacity=".28" /><stop offset="1" stop-color="#10b981" stop-opacity="0" /></linearGradient></defs>
                @foreach (var gy in new[] { 50, 90, 130, 170 }) { <line class="dn-grid" x1="40" x2="470" y1="@gy" y2="@gy" /> }
                @if (__months.Count > 1)
                {
                    <path d="@LineArea(lineTop)" fill="url(#dnFill)" />
                    <polyline points="@LinePoints(lineTop, true)" fill="none" stroke="#10b981" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" />
                    <polyline points="@LinePoints(lineTop, false)" fill="none" stroke="#ef4444" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" />
                    @for (var i = 0; i < __months.Count; i++)
                    {
                        <circle class="dn-dot" cx="@LineX(i)" cy="@LineY(__months[i].In, lineTop)" r="3.5" fill="#10b981" />
                        <circle class="dn-dot" cx="@LineX(i)" cy="@LineY(__months[i].Out, lineTop)" r="3.5" fill="#ef4444" />
                        @* Razor reserves the text element name, so the SVG label is written out as markup *@
                        @((MarkupString)$"<text class=\"dn-xl\" x=\"{LineX(i)}\" y=\"208\" text-anchor=\"middle\">{__months[i].Label}</text>")
                    }
                }
            </svg>
        </section>
    </div>

    <div class="dk-grid two dk-phone">
        <section class="dk-card">
            <div class="dk-ch"><h3>Care coverage</h3><small class="dk-pct">@CarePercent% have a carer</small></div>
            <div class="dk-track"><i style="width:@(CarePercent)%"></i></div>
            <div class="dk-pl"><span>With a carer</span><b>@__careCovered</b></div>
            <div class="dk-pl"><span>Without a carer</span><b>@(__careTotal - __careCovered)</b></div>
            <div class="dk-pl"><span>Core members</span><b>@__coreCount</b></div>
            <a class="dk-more" href="pastoral">Assign carers &rarr;</a>
        </section>

        <section class="dk-card">
            <div class="dk-ch"><h3>Collection balance</h3></div>
            <div class="dk-big @(__balance < 0 ? "neg" : "")">@Money(__balance)</div>
            <div class="dk-pl"><span>Collected</span><b class="in">+ @Money(__collected)</b></div>
            <div class="dk-pl"><span>Spent</span><b class="out">&#8722; @Money(__spent)</b></div>
        </section>
    </div>
}

</div>

@code {
    #region Private fields

    private readonly CancellationTokenSource __cts = new();

    private bool __loaded;
    private string __chart = "members";
    private string __attn = "visit";
    private string? __error;

    private int __totalMembers, __activeMembers;
    private decimal __collected, __spent;
    private List<(string Label, decimal In, decimal Out)> __months = [];
    private List<VisitorModel> __unconnected = [];
    private List<(DateTime Date, int Count)> __perService = [];

    // Member attendance
    private List<(DateTime Date, int Count)> __membersPerService = [];
    private List<NotSeenMember> __notSeen = [];
    private int __lastServicePresent, __averageAttendance;
    private DateTime? __lastServiceDate;

    // Pastoral care
    private List<PastoralContactModel> __flagged = [];
    private int __careCovered, __careTotal, __coreCount;
    private int CarePercent => __careTotal == 0 ? 0 : (int)Math.Round(100.0 * __careCovered / __careTotal);

    /// <summary>An active member who has not checked in for a while (Weeks is null when they never have).</summary>
    private sealed record NotSeenMember(MemberModel Member, DateTime? LastSeen, int? Weeks);

    #endregion

    #region Calculated values

    private decimal __balance => __collected - __spent;
    private int ActivePercent => __totalMembers == 0 ? 0 : (int)Math.Round(100.0 * __activeMembers / __totalMembers);
    /// <summary>Bar height as a percentage of the tallest bar (never below 4 so a bar is always visible).</summary>
    private static int Pct(int value, int max) => Math.Max(4, (int)Math.Round(100.0 * value / max));

    private static string Money(decimal value) => "$" + value.ToString("N2");

    #endregion

    #region Line chart helpers

    /// <summary>X position of month i on the 490 x 216 chart (six months spread from 40 to 470).</summary>
    private int LineX(int i) => __months.Count <= 1 ? 40 : 40 + (int)Math.Round(i * 430.0 / (__months.Count - 1));

    /// <summary>Y position of a value: 170 is zero, 50 is the highest value on the chart.</summary>
    private static int LineY(decimal value, decimal top) => 170 - (int)Math.Round((double)(value / top) * 120);

    private string LinePoints(decimal top, bool collected) =>
        string.Join(' ', __months.Select((m, i) => $"{LineX(i)},{LineY(collected ? m.In : m.Out, top)}"));

    /// <summary>The soft fill under the collected line.</summary>
    private string LineArea(decimal top) =>
        $"M{LineX(0)},{LineY(__months[0].In, top)} " + string.Join(' ', __months.Select((m, i) => $"L{LineX(i)},{LineY(m.In, top)}"))
        + $" L{LineX(__months.Count - 1)},190 L{LineX(0)},190Z";

    #endregion

    #region Member attendance

    /// <summary>Works out present-per-service, the average, and who has not been seen in 3+ weeks.</summary>
    private async Task LoadMemberAttendanceAsync(List<MemberModel> members, CancellationToken ct)
    {
        var today = AppClock.Today;
        var services = await ServiceRepo.SelectService(fromDate: today.AddDays(-120), toDate: today, cancellationToken: ct);
        var attendance = await MemberAttendanceRepo.SelectMemberAttendance(active: true, cancellationToken: ct);

        // Present per service: only services that have at least one check-in, latest eight.
        var counts = attendance.GroupBy(a => a.flngServiceKey).ToDictionary(g => g.Key, g => g.Select(a => a.flngMemberKey).Distinct().Count());
        __membersPerService = services
            .Where(s => counts.ContainsKey(s.flngKey))
            .OrderByDescending(s => s.fdtmServiceDate).Take(8)
            .Select(s => (Date: s.fdtmServiceDate.Date, Count: counts[s.flngKey]))
            .OrderBy(x => x.Date).ToList();

        if (__membersPerService.Count > 0)
        {
            __lastServiceDate = __membersPerService[^1].Date;
            __lastServicePresent = __membersPerService[^1].Count;
            __averageAttendance = __activeMembers == 0 ? 0
                : (int)Math.Round(__membersPerService.Average(p => Math.Min(100.0, 100.0 * p.Count / __activeMembers)));
        }

        // Not seen in 3+ weeks. Skipped completely until some check-ins exist, so a new system does not list everyone.
        if (attendance.Count == 0) return;

        var lastSeen = attendance.GroupBy(a => a.flngMemberKey).ToDictionary(g => g.Key, g => g.Max(a => a.fdtmCheckedInAt));
        var cutoff = today.AddDays(-21);

        __notSeen = members
            .Where(m => m.fstrMembershipStatus == "Active" && (m.fdtmJoinDate is null || m.fdtmJoinDate.Value.Date <= cutoff))
            .Select(m => lastSeen.TryGetValue(m.flngKey, out var seen) ? new NotSeenMember(m, seen, (int)((today - seen.Date).TotalDays / 7)) : new NotSeenMember(m, null, null))
            .Where(n => n.LastSeen is null || n.LastSeen.Value.Date < cutoff)
            .OrderBy(n => n.LastSeen ?? DateTime.MinValue)
            .ToList();
    }

    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        var ct = __cts.Token;
        try
        {
            var members = await MemberRepo.SelectMember(active: true, cancellationToken: ct);
            __totalMembers = members.Count;
            __activeMembers = members.Count(m => m.fstrMembershipStatus == "Active");

            await LoadMemberAttendanceAsync(members, ct);

            // Pastoral care: members flagged for the minister, and how many active members have a carer
            __flagged = await PastoralContactRepo.SelectPastoralContact(flaggedUnresolved: true, cancellationToken: ct);
            var careable = members.Where(m => m.fstrMembershipStatus == "Active" && !m.fblnCoreMember).ToList();
            __careTotal = careable.Count;
            __careCovered = careable.Count(m => m.flngCarerKey is not null);
            __coreCount = members.Count(m => m.fblnCoreMember && m.fstrMembershipStatus == "Active");

            // Visitors per service: group attendance by service date and keep the latest eight.
            var attendance = await VisitorAttendanceRepo.SelectVisitorAttendance(active: true, cancellationToken: ct);
            __perService = attendance
                .GroupBy(a => a.fdtmServiceDate.Date)
                .Select(g => (Date: g.Key, Count: g.Select(a => a.flngVisitorKey).Distinct().Count()))
                .OrderByDescending(x => x.Date).Take(8).OrderBy(x => x.Date).ToList();

            // Visitors who still have no connector (follow-up member).
            __unconnected = (await VisitorRepo.SelectVisitor(unassigned: true, active: true, cancellationToken: ct))
                .OrderBy(v => v.fdtmLastAttended ?? DateTime.MaxValue).ToList();

            // Current collection balance = everything collected minus everything spent.
            var collections = await FinanceRepo.SelectFinance(active: true, cancellationToken: ct);
            var expenses = await ExpenditureRepo.SelectExpenditure(active: true, cancellationToken: ct);
            __collected = collections.Sum(f => f.fcurAmount);
            __spent = expenses.Sum(e => e.fcurAmount);

            // The last six months, for the line chart
            var firstMonth = new DateTime(AppClock.Today.Year, AppClock.Today.Month, 1).AddMonths(-5);
            __months = Enumerable.Range(0, 6).Select(i =>
            {
                var m = firstMonth.AddMonths(i);
                return (m.ToString("MMM"),
                    collections.Where(f => f.flngYear == m.Year && f.flngMonth == m.Month).Sum(f => f.fcurAmount),
                    expenses.Where(e => e.fdtmExpenseDate.Year == m.Year && e.fdtmExpenseDate.Month == m.Month).Sum(e => e.fcurAmount));
            }).ToList();
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex) { __error = "The dashboard could not be loaded: " + ex.Message; }

        __loaded = true;
    }

    public void Dispose()
    {
        __cts.Cancel();
        __cts.Dispose();
    }

    #endregion
}
