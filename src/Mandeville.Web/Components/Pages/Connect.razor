@page "/connect"
@attribute [PageAccess(PageKeys.Connect, "Connections", "People", "link", Tint = "c4", Short = "Connections", Tabs = "Team lead,My team members", OwnOnlyOption = true, Bar = true, Order = 30)]
@using System.Security.Claims
@using Mandeville.Web.Dashboards
@inject FollowUpBadge FollowUps
@implements IDisposable

<PageTitle>Connections &amp; Prayerline</PageTitle>

<div class="mod wide vpage">
<div class="mhead"><span class="mhead-ico"><Icon Name="link" Size="26" Stroke="1.5" /></span><div><h1>Connections &amp; Prayerline</h1><p>The team lead sorts the visitors. Team members follow them up.</p></div></div>

@if (__ready)
{
    @if (FollowUps.Count > 0)
    {
        <div class="due-notice">
            <Icon Name="bell" Size="18" Stroke="1.6" />
            <div class="due-body">
                <b>@FollowUps.Count follow-up @(FollowUps.Count == 1 ? "call is" : "calls are") due</b>
                <ul>
                    @foreach (var c in FollowUps.Calls.Take(5))
                    {
                        <li><strong>@c.Visitor</strong> <span>to be called by @(c.Member ?? "no one yet") &middot; came to @c.Service@(c.DaysLate > 0 ? $" · {c.DaysLate} day(s) late" : " · due today")</span></li>
                    }
                </ul>
                @if (FollowUps.Count > 5) { <small>and @(FollowUps.Count - 5) more</small> }
            </div>
        </div>
    }

    @if (__isLead && __showLeadTab && __showTeamTab)
    {
        <div class="tabs tabs-seg">
            <button class="tab @(__tab == 0 ? "active" : "")" @onclick="() => __tab = 0"><Icon Name="users" Size="18" /><span class="tl-d">Team Lead</span><span class="tl-m">Lead</span></button>
            <button class="tab @(__tab == 1 ? "active" : "")" @onclick="() => __tab = 1"><Icon Name="user" Size="18" /><span class="tl-d">My Team Members</span><span class="tl-m">My Team</span></button>
        </div>
    }

    <div class="with-side"><div class="side-main">
    @if (__isLead && __showLeadTab && __tab == 0)
    {
        <ConnectLeadTab OnChanged="OnLeadChanged" />
    }
    else
    {
        @* A team member sees only their own list; the lead and administrators can look at any team member's list *@
        <ConnectMemberTab MemberKey="__myKey" CanPick="__isLead" OnChanged="OnTeamChanged" />
    }
    </div>
    <aside><RoleSidePanel @key="PanelKey" Kind="@(__isLead && __showLeadTab && __tab == 0 ? "connect-lead" : "connect-team")" ServiceDate="@__leadDate" MemberKey="@__teamMember" /></aside>
    </div>
}
</div>

@code {
    #region Private Fields

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool __ready;
    private bool __isLead, __showLeadTab, __showTeamTab;
    private Guid? __myKey;
    private int __tab;
    private int __panelKey;
    private string PanelKey => $"{__tab}-{__panelKey}";
    private string? __leadDate;
    private Guid? __teamMember;

    private async Task OnLeadChanged(string date) { __leadDate = date; __panelKey++; await FollowUps.RefreshAsync(); }

    private async Task OnTeamChanged(Guid? member) { __teamMember = member; __panelKey++; await FollowUps.RefreshAsync(); }

    private void OnBadgeChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => FollowUps.Changed -= OnBadgeChanged;

    #endregion

    protected override async Task OnInitializedAsync()
    {
        FollowUps.Changed += OnBadgeChanged;
        var user = AuthState is null ? null : (await AuthState).User;

        // A role set to "own records only" sees just the people given to that member; any other role runs the team
        // and sees the tabs it was given.
        __isLead = user is not null && !user.OwnOnly(PageKeys.Connect);
        __showLeadTab = user?.CanTab(PageKeys.Connect, "Team lead") ?? false;
        __showTeamTab = user?.CanTab(PageKeys.Connect, "My team members") ?? false;
        __tab = __showLeadTab ? 0 : 1;
        __myKey = Guid.TryParse(user?.FindFirstValue(AppClaims.MemberKey), out var key) ? key : null;
        __teamMember = __myKey;
        __ready = true;
    }
}
