@page "/evangelism"
@attribute [PageAccess(PageKeys.Evangelism, "Evangelism", "Outreach", "mega", Tint = "c2", Short = "Evangelism", Tabs = "Team lead,My assignments", OwnOnlyOption = true, Order = 210)]
@using System.Security.Claims

<PageTitle>Evangelism</PageTitle>

<div class="mod wide">
<div class="mhead"><span class="mhead-ico"><Icon Name="mega" Size="26" Stroke="1.5" /></span><div><h1>Evangelism</h1><p>Plan the Saturdays, ask who can serve, and record what happened.</p></div></div>

@if (__ready)
{
    @if (!__showLeadTab && !__showTeamTab)
    {
        <p class="empty">Your role has not been given a tab on this page yet. An administrator can tick Team lead or My assignments under Roles &amp; access.</p>
    }
    else
    {
        @if (__isLead && __showLeadTab && __showTeamTab)
        {
            <div class="tabs">
                <button class="tab @(__tab == 0 ? "active" : "")" @onclick="() => __tab = 0"><Icon Name="users" Size="18" />Team Lead</button>
                <button class="tab @(__tab == 1 ? "active" : "")" @onclick="() => __tab = 1"><Icon Name="user" Size="18" />My Assignments</button>
            </div>
        }

        @if (__isLead && __showLeadTab && __tab == 0)
        {
            <EvangelismLeadTab />
        }
        else
        {
            <EvangelismMemberTab MemberKey="__myKey" />
        }
    }
}
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool __ready;
    private bool __isLead, __showLeadTab, __showTeamTab;
    private Guid? __myKey;
    private int __tab;

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;

        // A role set to "own records only" sees just its own assignments; any other role runs the team and sees the tabs it was given
        __isLead = user is not null && !user.OwnOnly(PageKeys.Evangelism);
        __showLeadTab = user?.CanTab(PageKeys.Evangelism, "Team lead") ?? false;
        __showTeamTab = user?.CanTab(PageKeys.Evangelism, "My assignments") ?? false;
        __tab = __showLeadTab ? 0 : 1;
        __myKey = Guid.TryParse(user?.FindFirstValue(AppClaims.MemberKey), out var key) ? key : null;
        __ready = true;
    }
}
