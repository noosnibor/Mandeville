@page "/visitors"
@attribute [PageAccess(PageKeys.Visitors, "Visitors", "People", "userplus", Tint = "c3", Tabs = "Add visitor,Returning visitor,Thank you messages", Bar = true, Order = 20)]

<PageTitle>Visitors</PageTitle>

<div class="mod wide vpage">
<div class="mhead"><span class="mhead-ico"><Icon Name="userplus" Size="26" Stroke="1.5" /></span><div><h1>Visitors</h1><p>Welcome guests and record their visits. The Connections team takes it from the altar.</p></div></div>

@if ((__canAdd ? 1 : 0) + (__canReturning ? 1 : 0) + (__canThank ? 1 : 0) > 1)
{
    <div class="tabs tabs-seg">
        @if (__canAdd) { <button class="tab @(__tab == 0 ? "active" : "")" @onclick="() => __tab = 0"><Icon Name="userplus" Size="18" />Add Visitor</button> }
        @if (__canReturning) { <button class="tab @(__tab == 1 ? "active" : "")" @onclick="() => __tab = 1"><Icon Name="refresh" Size="18" /><span class="tl-d">Returning Visitor</span><span class="tl-m">Return</span></button> }
        @if (__canThank) { <button class="tab @(__tab == 2 ? "active" : "")" @onclick="() => __tab = 2"><Icon Name="mail" Size="18" /><span class="tl-d">Thank You Messages</span><span class="tl-m">Message</span></button> }
    </div>
}

<div class="with-side"><div class="side-main">
@switch (__tab)
{
    case 0:
        <AddVisitorTab OnChanged="() => __panelKey++" OnServiceChosen="s => { __viewDate = s; __panelKey++; }" />
        break;
    case 2:
        <VisitorThankYouTab OnChanged="() => __panelKey++" />
        break;
    default:
        <ReturningVisitorTab OnChanged="() => __panelKey++" />
        break;
}
</div>
<aside><RoleSidePanel @key="__panelKey" ServiceDate="@__viewDate" Kind="@(__tab == 0 ? "visit-add" : __tab == 2 ? "visit-thank" : "visit-return")" /></aside>
</div>
</div>

@code {
    #region Private Fields

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private int __tab;
    private int __panelKey;
    private string? __viewDate;
    private bool __canAdd = true, __canReturning = true, __canThank = true;

    #endregion

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;

        // Only the tabs this person's role was given are shown
        __canAdd = user?.CanTab(PageKeys.Visitors, "Add visitor") ?? false;
        __canReturning = user?.CanTab(PageKeys.Visitors, "Returning visitor") ?? false;
        __canThank = user?.CanTab(PageKeys.Visitors, "Thank you messages") ?? false;
        __tab = __canAdd ? 0 : __canReturning ? 1 : 2;
    }
}
