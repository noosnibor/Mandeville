@page "/pastoral"
@attribute [PageAccess(PageKeys.Pastoral, "Pastoral Care", "People", "heart", Tint = "c5", Short = "Pastoral", OwnOnlyOption = true, Order = 50)]
@implements IDisposable
@using System.Security.Claims
@using global::Mandeville.Web.Dashboards
@inject IMemberRepository MemberRepo
@inject IPastoralAssignmentRepository AssignmentRepo
@inject IPastoralContactRepository ContactRepo
@inject IMemberAttendanceRepository AttendanceRepo

<PageTitle>Pastoral Care</PageTitle>

<div class="mod wide vpage pst">
<div class="mhead"><span class="mhead-ico"><Icon Name="heart" Size="26" Stroke="1.5" /></span><div><h1>Pastoral Care</h1><p>@(__staff ? "Core members caring for members, supporting the minister" : "The members you care for and your private care log")</p></div></div>

<div class="with-side"><div class="side-main">

<ToastBar Toast="__toast" />

@if (!__ready)
{
    <p class="hint">Loading&hellip;</p>
}
else if (!__staff && __myKey is null)
{
    <div class="card"><p class="empty" style="margin:0">Your account is not linked to a Core Member yet. Please ask the administrator to link it.</p></div>
}
else
{
    @if (__staff)
    {
        <div class="tabs tabs-seg">
            <button class="tab @(__tab == "caseloads" ? "active" : "")" @onclick='() => __tab = "caseloads"'>Caseloads</button>
            <button class="tab @(__tab == "assign" ? "active" : "")" @onclick='() => __tab = "assign"'><span class="tl-d">Assign members</span><span class="tl-m">Assign</span></button>
            <button class="tab @(__tab == "log" ? "active" : "")" @onclick='() => __tab = "log"'><span class="tl-d">Care log</span><span class="tl-m">Log</span></button>
            <button class="tab @(__tab == "minister" ? "active" : "")" @onclick='() => SwitchTabAsync("minister")'><span class="tl-d">Minister's list</span><span class="tl-m">Minister</span></button>
        </div>
    }
    else
    {
        <div class="tabs tabs-seg">
            <button class="tab @(__tab == "mine" ? "active" : "")" @onclick='() => __tab = "mine"'>My caseload</button>
            <button class="tab @(__tab == "log" ? "active" : "")" @onclick='() => __tab = "log"'>My log</button>
        </div>
    }

    @* ======================= Caseloads (administrator / minister) ======================= *@
    @if (__staff && __tab == "caseloads")
    {
        <div class="vk four">
            @foreach (var bar in Bars().Where(b => b.Label != "Contacted"))
            {
                var meta = BarMeta(bar.Label);
                <div class="vkc" style="--c:@meta.Colour"><div class="vk-h"><span>@bar.Label</span><span class="vk-i"><Icon Name="@meta.Icon" Size="17" Stroke="1.8" /></span></div><b>@bar.Value</b><small>@meta.Sub</small></div>
            }
        </div>

        @if (CoreMembers.Count == 0)
        {
            <div class="empty-state"><div class="empty-ico"><Icon Name="heart" Size="30" Stroke="1.6" /></div><h3>No core members yet</h3><p>Tick "Core member" on a member's record (Members page) and they will appear here.</p></div>
        }
        <div class="care-grid">
            @foreach (var core in CoreMembers)
            {
                var mine = CareOf(core.flngKey);
                var state = WorstState(mine);
                var lastLog = LastLogOf(core.flngKey);
                <div class="care-card @state.Css" @onclick="() => __openCarer = core.flngKey">
                    <div class="care-top">
                        <div class="care-av" style="background:@AvatarStyle.Colour(core.flngKey)">@AvatarStyle.Initials(core.fstrFirstname, core.fstrLastname)</div>
                        <div class="care-nm"><b>@core.FullName</b><small>Core member</small></div>
                        <span class="care-tag @state.Css">@state.Text</span>
                    </div>
                    <div class="care-stats">
                        <div><b>@mine.Count</b><span>Members</span></div>
                        <div><b>@mine.Count(c => c.State is "w" or "o")</b><span>Due now</span></div>
                        <div><b>@(lastLog is null ? "-" : lastLog.Value.ToString("d MMM"))</b><span>Last log</span></div>
                    </div>
                    <div class="care-faces">
                        @foreach (var c in mine.Take(4))
                        {
                            <i style="background:@AvatarStyle.Colour(c.MemberKey)" title="@c.Name">@Initials(c.Name)</i>
                        }
                        @if (mine.Count > 4) { <small>+@(mine.Count - 4) more</small> }
                        @if (mine.Count == 0) { <small>No members assigned yet</small> }
                    </div>
                </div>
            }
        </div>
    }

    @* ======================= Assign members (administrator / minister) ======================= *@
    @if (__staff && __tab == "assign")
    {
        var careable = __members.Where(m => m.fstrMembershipStatus == "Active" && !m.fblnCoreMember).ToList();
        var noCarer = careable.Count(m => m.flngCarerKey is null);
        <div class="as-seg" role="group" aria-label="Filter members">
            <button class="@(__assignFilter == "none" ? "on" : "")" @onclick='() => __assignFilter = "none"'>Unassigned<b>@noCarer</b></button>
            <button class="@(__assignFilter == "has" ? "on" : "")" @onclick='() => __assignFilter = "has"'>Assigned<b>@(careable.Count - noCarer)</b></button>
            <button class="@(__assignFilter == "all" ? "on" : "")" @onclick='() => __assignFilter = "all"'>All<b>@careable.Count</b></button>
        </div>
        <div class="mfilter">
            <input type="text" placeholder="Search name" aria-label="Search members" @bind="__assignSearch" @bind:event="oninput" />
        </div>
        var assignList = AssignList();
        @if (CoreMembers.Count == 0)
        {
            <div class="empty-state"><div class="empty-ico"><Icon Name="users" Size="30" Stroke="1.6" /></div><h3>No core members yet</h3><p>Mark at least one member as a Core Member first (Members page).</p></div>
        }
        else if (assignList.Count == 0)
        {
            <div class="empty-state"><div class="empty-ico"><Icon Name="check" Size="30" Stroke="1.8" /></div><h3>No members match</h3><p>Try another filter or clear the search.</p></div>
        }
        else
        {
            <div class="ao-list">
                @foreach (var m in assignList.Take(60))
                {
                    <div class="ao-row">
                        <div class="ao-av" style="background:@AvatarStyle.Colour(m.flngKey)">@AvatarStyle.Initials(m.fstrFirstname, m.fstrLastname)</div>
                        <div class="ao-nm">
                            <b>@m.FullName</b>
                            <small>@(m.flngCarerKey is null ? "No carer yet" : "Cared for")</small>
                        </div>
                        @if (m.flngCarerKey is Guid ck)
                        {
                            <span class="ao-chip"><i style="background:@AvatarStyle.Colour(ck)">@Initials(m.fstrCarerName)</i>@FirstWord(m.fstrCarerName)<Icon Name="chevron" Size="14" Stroke="2" />
                                <select @onchange="e => AssignAsync(m.flngKey, e.Value?.ToString())" aria-label="Carer for @m.FullName">
                                    <option value="" selected="@(m.flngCarerKey is null)">Assign to&hellip;</option>
                                    @foreach (var core in CoreMembers.Where(c => c.flngKey != m.flngKey))
                                    {
                                        <option value="@core.flngKey" selected="@(m.flngCarerKey == core.flngKey)">@core.FullName (@CareOf(core.flngKey).Count)</option>
                                    }
                                    <option value="remove">Remove carer</option>
                                </select>
                            </span>
                        }
                        else
                        {
                            <span class="ao-chip none"><Icon Name="plus" Size="14" Stroke="2.2" />Assign<Icon Name="chevron" Size="14" Stroke="2" />
                                <select @onchange="e => AssignAsync(m.flngKey, e.Value?.ToString())" aria-label="Carer for @m.FullName">
                                    <option value="">Assign to&hellip;</option>
                                    @foreach (var core in CoreMembers.Where(c => c.flngKey != m.flngKey))
                                    {
                                        <option value="@core.flngKey">@core.FullName (@CareOf(core.flngKey).Count)</option>
                                    }
                                </select>
                            </span>
                        }
                    </div>
                }
            </div>
            @if (assignList.Count > 60) { <p class="hint">Showing the first 60. Use the search to narrow the list.</p> }
        }
    }

    @* ======================= My caseload (Pastoral Care account) ======================= *@
    @if (!__staff && __tab == "mine")
    {
        var mine = CareOf(__myKey!.Value);
        <div class="vk">
            <div class="vkc" style="--c:#1c86f2"><div class="vk-h"><span>In your care</span><span class="vk-i"><Icon Name="users" Size="17" Stroke="1.8" /></span></div><b>@mine.Count</b><small>Members</small></div>
            <div class="vkc" style="--c:#f59e0b"><div class="vk-h"><span>Due</span><span class="vk-i"><Icon Name="clock" Size="17" Stroke="1.8" /></span></div><b>@mine.Count(c => c.State is "w" or "o")</b><small>For a contact</small></div>
            <div class="vkc" style="--c:#10b981"><div class="vk-h"><span>Last log</span><span class="vk-i"><Icon Name="check" Size="17" Stroke="2" /></span></div><b>@(LastLogOf(__myKey.Value)?.ToString("d MMM") ?? "-")</b><small>Yours</small></div>
        </div>
        @if (mine.Count == 0)
        {
            <div class="empty-state"><div class="empty-ico"><Icon Name="heart" Size="30" Stroke="1.6" /></div><h3>No members yet</h3><p>No members have been given to you yet.</p></div>
        }
        else
        {
            <div class="ao-list">
                @foreach (var c in mine)
                {
                    <div class="ao-row mine">
                        <div class="ao-av" style="background:@AvatarStyle.Colour(c.MemberKey)">@Initials(c.Name)</div>
                        <div class="ao-nm">
                            <b>@c.Name</b>
                            <small>@c.Detail</small>
                        </div>
                        <span class="care-tag @c.State">@c.StateText</span>
                        <div class="ao-btns">
                            <button class="btn btn-sm p" @onclick="() => StartLog(__myKey, c.MemberKey, null)">Log</button>
                            <button class="btn btn-sm" @onclick="() => __history = c">History</button>
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* ======================= Care log ======================= *@
    @if (__tab == "log")
    {
        @if (__staff)
        {
            <div class="mfilter">
                <select @bind="__logFilterCarer">
                    <option value="">All carers</option>
                    @foreach (var core in CoreMembers) { <option value="@core.flngKey">@core.FullName</option> }
                </select>
            </div>
        }
        var entries = LogEntries(); string? __grp = null;
        @if (entries.Count == 0)
        {
            <div class="empty-state"><div class="empty-ico"><Icon Name="note" Size="30" Stroke="1.6" /></div><h3>No contacts logged yet</h3><p>Care contacts you log will appear here.</p></div>
        }
        @foreach (var c in entries.Take(80))
        {
            var grp = LogGroup(c.fdtmContactDate);
            if (grp != __grp)
            {
                __grp = grp;
                <div class="plg-day">@grp</div>
            }
            <div class="plg-card @(c.fblnFlagForMinister && !c.fblnFlagResolved ? "flag" : "")">
                <div class="plg-top">
                    <div class="plg-pair">
                        @if (__staff) { <div class="ao-av" style="background:@AvatarStyle.Colour(c.flngCoreMemberKey)">@Initials(c.fstrCoreMemberName)</div> }
                        <div class="ao-av" style="background:@AvatarStyle.Colour(c.flngMemberKey)">@Initials(c.fstrMemberName)</div>
                    </div>
                    <div class="plg-who"><b>@c.fstrMemberName</b><small>@(__staff ? "by " + c.fstrCoreMemberName + " · " : "")@c.fdtmContactDate.ToString("d MMM yyyy")</small></div>
                    <span class="plg-meth"><Icon Name="@MethodIcon(c.fstrMethod)" Size="14" Stroke="2" /><span>@c.fstrMethod</span></span>
                </div>
                @if (!string.IsNullOrWhiteSpace(c.fstrNotes)) { <div class="plg-note">@c.fstrNotes</div> }
                @if (c.fdtmNextContactDate is { } nx) { <small class="care-next">Next contact: @nx.ToString("d MMM yyyy")</small> }
                @if (c.fblnFlagForMinister || CanEdit(c) || __isAdmin)
                {
                    <div class="plg-foot">
                        @if (c.fblnFlagForMinister)
                        {
                            <span class="plg-flag @(c.fblnFlagResolved ? "done" : "")">@(c.fblnFlagResolved ? "Flag resolved" : "Flagged for the minister")</span>
                        }
                        <div class="plg-act">
                            @if (CanEdit(c)) { <button type="button" title="Edit" aria-label="Edit" @onclick="() => StartLog(c.flngCoreMemberKey, c.flngMemberKey, c)"><Icon Name="edit" Size="15" Stroke="1.8" /></button> }
                            @if (CanEdit(c) || __isAdmin) { <button type="button" class="d" title="Delete" aria-label="Delete" @onclick="() => DeleteContactAsync(c)"><Icon Name="trash" Size="15" Stroke="1.8" /></button> }
                        </div>
                    </div>
                }
            </div>
        }
    }

    @* ======================= Minister's list ======================= *@
    @if (__staff && __tab == "minister")
    {
        var flagged = FlaggedContacts();
        <div class="plg-day first">Flagged by carers<span>@flagged.Count open</span></div>
        @if (flagged.Count == 0)
        {
            <div class="empty-state"><div class="empty-ico"><Icon Name="check" Size="30" Stroke="1.8" /></div><h3>Nothing flagged</h3><p>Nothing is flagged right now.</p></div>
        }
        else
        {
            <div class="ao-list">
                @foreach (var c in flagged)
                {
                    <div class="ao-row flagrow">
                        <div class="ao-av" style="background:@AvatarStyle.Colour(c.flngMemberKey)">@Initials(c.fstrMemberName)</div>
                        <div class="ao-nm">
                            <b>@c.fstrMemberName</b>
                            <small>Flagged by @c.fstrCoreMemberName &middot; @c.fdtmContactDate.ToString("d MMM")</small>
                            @if (!string.IsNullOrWhiteSpace(c.fstrNotes)) { <p class="care-note">@c.fstrNotes</p> }
                        </div>
                        <button class="btn btn-sm p" @onclick="() => ResolveAsync(c)">Resolved</button>
                    </div>
                }
            </div>
        }

        var attention = NeedsAttention();
        <div class="plg-day">Needs attention<span>Not seen in 3+ weeks, no recent care contact</span></div>
        @if (attention.Count == 0)
        {
            <div class="empty-state"><div class="empty-ico"><Icon Name="heart" Size="30" Stroke="1.6" /></div><h3>All looked after</h3><p>Everyone who has been away is being looked after.</p></div>
        }
        else
        {
            <div class="ao-list">
                @foreach (var a in attention.Take(30))
                {
                    <div class="ao-row">
                        <div class="ao-av" style="background:@AvatarStyle.Colour(a.Member.flngKey)">@AvatarStyle.Initials(a.Member.fstrFirstname, a.Member.fstrLastname)</div>
                        <div class="ao-nm">
                            <b>@a.Member.FullName</b>
                            <small>@(a.LastSeen is { } ls ? "Last seen " + ls.ToString("d MMM") : "Never checked in") &middot; @(string.IsNullOrWhiteSpace(a.Member.fstrCarerName) ? "No carer assigned" : "Carer: " + a.Member.fstrCarerName)</small>
                        </div>
                        <span class="care-tag @(a.Member.flngCarerKey is null ? "o" : "w")">@(a.Member.flngCarerKey is null ? "No carer" : "No contact")</span>
                    </div>
                }
            </div>
        }
    }

    @if ((__tab is "caseloads" or "mine" or "log") && (__staff ? CoreMembers.Count > 0 : CareOf(__myKey!.Value).Count > 0))
    {
        <button class="fab" @onclick="() => StartLog(__staff ? null : __myKey, null, null)"><Icon Name="plus" Size="16" />Log contact</button>
    }

    @* ======================= Core member caseload drawer ======================= *@
    @if (__openCarer is { } carerKey && CoreMembers.FirstOrDefault(c => c.flngKey == carerKey) is { } carer)
    {
        var list = CareOf(carerKey);
        <div class="drawer-backdrop" @onclick="() => __openCarer = null">
            <aside class="drawer" role="dialog" aria-modal="true" aria-label="Caseload" @onclick:stopPropagation="true">
                <div class="drawer-cover" style="background:@AvatarStyle.Cover(carer.flngKey)">
                    <button class="drawer-close" aria-label="Close" @onclick="() => __openCarer = null">&#10005;</button>
                </div>
                <div class="drawer-top">
                    <div class="drawer-avatar" style="background:@AvatarStyle.Colour(carer.flngKey)">@AvatarStyle.Initials(carer.fstrFirstname, carer.fstrLastname)</div>
                    <h3>@carer.FullName</h3>
                    <small>Core member</small>
                    <div class="drawer-stats">
                        <div><b>@list.Count</b><span>Members</span></div>
                        <div><b>@list.Count(c => c.State is "w" or "o")</b><span>Due now</span></div>
                        <div><b>@(LastLogOf(carerKey)?.ToString("d MMM") ?? "-")</b><span>Last log</span></div>
                    </div>
                </div>
                <div class="drawer-card">
                    <h4>Members in their care</h4>
                    @if (list.Count == 0) { <p class="hint" style="margin:0">Nobody assigned yet. Use the Assign members tab.</p> }
                    @foreach (var c in list)
                    {
                        <div class="care-u tight">
                            <div class="care-av sm" style="background:@AvatarStyle.Colour(c.MemberKey)">@Initials(c.Name)</div>
                            <div class="care-ut"><b>@c.Name</b><small>@c.Detail</small></div>
                            <span class="care-tag @c.State">@c.StateText</span>
                        </div>
                    }
                </div>
                <div class="drawer-foot">
                    <button class="p" @onclick="() => { var k = carerKey; __openCarer = null; StartLog(k, null, null); }">Log contact</button>
                </div>
            </aside>
        </div>
    }

    @* ======================= One member's history (carer) ======================= *@
    @if (__history is not null)
    {
        <Modal Title="@__history.Name" Subtitle="Your care history (private)" Icon="heart" OnClose="() => __history = null">
            <ChildContent>
                @{ var past = __contacts.Where(c => c.flngMemberKey == __history.MemberKey && c.flngCoreMemberKey == __history.CarerKey).OrderByDescending(c => c.fdtmContactDate).ToList(); }
                @if (past.Count == 0) { <p class="hint">Nothing logged yet.</p> }
                @foreach (var c in past)
                {
                    <div class="care-tl">
                        <i></i>
                        <div class="care-tl-head"><b>@c.fstrMethod</b><small>@c.fdtmContactDate.ToString("d MMM yyyy")</small>
                            @if (c.fblnFlagForMinister) { <span class="care-flag-chip">@(c.fblnFlagResolved ? "Flag resolved" : "Flagged for the minister")</span> }</div>
                        @if (!string.IsNullOrWhiteSpace(c.fstrNotes)) { <p>@c.fstrNotes</p> }
                    </div>
                }
            </ChildContent>
            <Footer>
                <button class="btn btn-sm" @onclick="() => __history = null">Close</button>
            </Footer>
        </Modal>
    }

    @* ======================= Log contact popup ======================= *@
    @if (__log is not null)
    {
        <Modal Title="@(__logIsEdit ? "Edit contact" : "Log contact")" Subtitle="Record how you cared for a member" Icon="heart" OnClose="() => __log = null">
            <ChildContent>
                <div class="modal-sec">Who</div>
                <div class="form-grid">
                    @if (__staff)
                    {
                        <div class="field">
                            <label>Core member</label>
                            <select @bind="__logCarer" disabled="@__logIsEdit">
                                <option value="">-- choose --</option>
                                @foreach (var core in CoreMembers) { <option value="@core.flngKey">@core.FullName</option> }
                            </select>
                        </div>
                    }
                    <div class="field">
                        <label>Member</label>
                        <select @bind="__logMember" disabled="@__logIsEdit">
                            <option value="">-- choose --</option>
                            @foreach (var c in LogMemberChoices()) { <option value="@c.MemberKey">@c.Name</option> }
                        </select>
                    </div>
                </div>

                <div class="modal-sec">How</div>
                <div class="care-pills">
                    @foreach (var method in FixedLists.CareMethods)
                    {
                        var chosen = method;
                        <button type="button" class="care-pill @(__log.fstrMethod == chosen ? "on" : "")" @onclick="() => __log.fstrMethod = chosen">@chosen</button>
                    }
                </div>

                <div class="modal-sec">Details</div>
                <div class="form-grid">
                    <div class="field"><label>Date</label><input type="date" @bind="__log.fdtmContactDate" /></div>
                    <div class="field"><label>Next contact</label><input type="date" @bind="__log.fdtmNextContactDate" /></div>
                </div>
                <div class="field"><label>Notes (private)</label><textarea maxlength="1000" placeholder="Only you, the minister and the administrator can read this" @bind="__log.fstrNotes"></textarea></div>

                <label class="care-flag">
                    <input type="checkbox" @bind="__log.fblnFlagForMinister" />
                    <span><b>Flag for the minister</b><br />Adds this member to the minister's list for follow-up</span>
                </label>
            </ChildContent>
            <Footer>
                <button class="btn btn-primary btn-sm" @onclick="SaveLogAsync">Save contact</button>
                <button class="btn btn-sm" @onclick="() => __log = null">Cancel</button>
            </Footer>
        </Modal>
    }
}

</div>
<aside><RoleSidePanel Kind="pastoral" Data="PanelData()" /></aside>
</div>
</div>

@code {
    #region Private Fields

    private const int DefaultGapDays = 21;

    private readonly CancellationTokenSource __cts = new();

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool __ready, __staff, __isAdmin;
    private Guid? __myKey;
    private string __tab = "mine";
    private ToastMessageModel? __toast;

    private List<MemberModel> __members = [];
    private List<PastoralAssignmentModel> __assignments = [];
    private List<PastoralContactModel> __contacts = [];
    private List<CareItem> __care = [];
    private Dictionary<Guid, DateTime> __lastSeen = [];
    private bool __hasAttendance;

    private Guid? __openCarer;
    private CareItem? __history;
    private string __assignFilter = "none";
    private string? __assignSearch;
    private Guid? __logFilterCarer;

    // Log popup
    private PastoralContactModel? __log;
    private bool __logIsEdit;
    private Guid? __logCarer, __logMember;

    /// <summary>One member in a carer's care, with the state of the relationship.</summary>
    private sealed record CareItem(Guid MemberKey, Guid CarerKey, string Name, DateTime AssignedOn, PastoralContactModel? Last, string State, string StateText, string Detail);
    private sealed record BarItem(string Label, int Value, string From, string To);
    private sealed record AwayItem(MemberModel Member, DateTime? LastSeen);

    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        var user = AuthState is null ? null : (await AuthState).User;
        __isAdmin = user?.IsInRole(AppRoles.Administrator) ?? false;

        // A role set to "own records only" sees just its caseload; any other role sees every caseload (staff view)
        __staff = user is not null && !user.OwnOnly(PageKeys.Pastoral);
        __myKey = Guid.TryParse(user?.FindFirstValue(AppClaims.MemberKey), out var k) ? k : null;
        __tab = __staff ? "caseloads" : "mine";

        await LoadAsync();
        __ready = true;
    }

    public void Dispose()
    {
        __cts.Cancel();
        __cts.Dispose();
    }

    #endregion

    #region Loading

    /// <summary>
    /// Privacy: a Pastoral Care account only ever loads its own caseload and its own log. The filter is applied
    /// here in the query, never by hiding things on screen.
    /// </summary>
    private async Task LoadAsync()
    {
        var ct = __cts.Token;
        if (__staff)
        {
            __members = await MemberRepo.SelectMember(active: true, cancellationToken: ct);
            __assignments = await AssignmentRepo.SelectPastoralAssignment(cancellationToken: ct);
            __contacts = await ContactRepo.SelectPastoralContact(cancellationToken: ct);

            if (__tab == "minister")
                await LoadAttendanceAsync(ct);
        }
        else if (__myKey is Guid mine)
        {
            __assignments = await AssignmentRepo.SelectPastoralAssignment(coreMemberKey: mine, cancellationToken: ct);
            __contacts = await ContactRepo.SelectPastoralContact(coreMemberKey: mine, cancellationToken: ct);
        }

        BuildCare();
    }

    private async Task LoadAttendanceAsync(CancellationToken ct)
    {
        var attendance = await AttendanceRepo.SelectMemberAttendance(active: true, cancellationToken: ct);
        __hasAttendance = attendance.Count > 0;
        __lastSeen = attendance.GroupBy(a => a.flngMemberKey).ToDictionary(g => g.Key, g => g.Max(a => a.fdtmCheckedInAt));
    }

    /// <summary>Works out, for every assignment, when the carer last made contact and what is due next.</summary>
    private void BuildCare()
    {
        var today = AppClock.Today;
        __care = __assignments.Select(a =>
        {
            var last = __contacts
                .Where(c => c.flngMemberKey == a.flngMemberKey && c.flngCoreMemberKey == a.flngCoreMemberKey)
                .OrderByDescending(c => c.fdtmContactDate).FirstOrDefault();

            string state, text, detail;
            if (last is null)
            {
                var overdue = (today - a.fdtmAssignedOn.Date).TotalDays > DefaultGapDays;
                state = overdue ? "o" : "i";
                text = overdue ? "Overdue" : "New";
                detail = "Not contacted yet";
            }
            else
            {
                var due = (last.fdtmNextContactDate ?? last.fdtmContactDate.AddDays(DefaultGapDays)).Date;
                (state, text) = due < today ? ("o", "Overdue") : due <= today.AddDays(7) ? ("w", "Due soon") : ("ok", "On track");
                detail = $"{last.fstrMethod} {last.fdtmContactDate:d MMM} · next {due:d MMM}";
            }

            return new CareItem(a.flngMemberKey, a.flngCoreMemberKey, a.fstrMemberName ?? "Member", a.fdtmAssignedOn, last, state, text, detail);
        }).OrderBy(c => c.Name).ToList();
    }

    private async Task SwitchTabAsync(string tab)
    {
        __tab = tab;
        if (tab == "minister") await LoadAttendanceAsync(__cts.Token);
    }

    #endregion

    #region Calculated lists

    private List<MemberModel> CoreMembers => __members
        .Where(m => m.fblnCoreMember && m.fstrMembershipStatus == "Active")
        .OrderBy(m => m.fstrFirstname).ThenBy(m => m.fstrLastname).ToList();

    private List<CareItem> CareOf(Guid carerKey) => __care.Where(c => c.CarerKey == carerKey).ToList();

    private DateTime? LastLogOf(Guid carerKey) =>
        __contacts.Where(c => c.flngCoreMemberKey == carerKey).Select(c => (DateTime?)c.fdtmContactDate).Max();

    private static (string Css, string Text) WorstState(List<CareItem> items)
    {
        if (items.Count == 0) return ("i", "No members");
        if (items.Any(i => i.State == "o")) return ("o", "Overdue");
        if (items.Any(i => i.State == "w")) return ("w", "Due soon");
        return ("ok", "On track");
    }

    /// <summary>Colour, hint and icon for one summary card on the Caseloads tab.</summary>
    private static (string Colour, string Sub, string Icon) BarMeta(string label) => label switch
    {
        "Assigned" => ("#1c86f2", "In care", "users"),
        "Unassigned" => ("#94a3b8", "No carer", "user"),
        "Overdue" => ("#e11d48", "Call now", "clock"),
        "Flagged" => ("#f59e0b", "For minister", "heart"),
        _ => ("#1c86f2", "", "users")
    };

    /// <summary>Heading a care-log entry is grouped under.</summary>
    private static string LogGroup(DateTime date) => (AppClock.Today - date.Date).TotalDays <= 7 ? "This week" : "Earlier";

    /// <summary>Icon for the way a contact was made.</summary>
    private static string MethodIcon(string? method)
    {
        var m = (method ?? "").ToLowerInvariant();
        if (m.Contains("call") || m.Contains("phone")) return "phone";
        if (m.Contains("visit")) return "house";
        if (m.Contains("text") || m.Contains("whatsapp") || m.Contains("message")) return "message";
        return "note";
    }

    private static string FirstWord(string? name) => string.IsNullOrWhiteSpace(name) ? "" : name.Trim().Split(' ')[0];

    private static string Initials(string? name)
    {
        var parts = (name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch { 0 => "?", 1 => AvatarStyle.Initials(parts[0], null), _ => AvatarStyle.Initials(parts[0], parts[^1]) };
    }

    private List<MemberModel> AssignList()
    {
        var q = __members.Where(m => m.fstrMembershipStatus == "Active" && !m.fblnCoreMember);
        q = __assignFilter switch
        {
            "none" => q.Where(m => m.flngCarerKey is null),
            "has" => q.Where(m => m.flngCarerKey is not null),
            _ => q
        };
        if (!string.IsNullOrWhiteSpace(__assignSearch))
            q = q.Where(m => m.FullName.Contains(__assignSearch.Trim(), StringComparison.OrdinalIgnoreCase));
        return q.OrderBy(m => m.fstrFirstname).ThenBy(m => m.fstrLastname).ToList();
    }

    private List<PastoralContactModel> LogEntries()
    {
        var q = __contacts.AsEnumerable();
        if (!__staff && __myKey is Guid mine) q = q.Where(c => c.flngCoreMemberKey == mine);
        if (__staff && __logFilterCarer is Guid f) q = q.Where(c => c.flngCoreMemberKey == f);
        return q.OrderByDescending(c => c.fdtmContactDate).ToList();
    }

    private List<PastoralContactModel> FlaggedContacts() =>
        __contacts.Where(c => c.fblnFlagForMinister && !c.fblnFlagResolved).OrderByDescending(c => c.fdtmContactDate).ToList();

    /// <summary>Active members not seen for 3+ weeks whose carer (if any) has not made contact in that time either.</summary>
    private List<AwayItem> NeedsAttention()
    {
        if (!__hasAttendance) return [];
        var cutoff = AppClock.Today.AddDays(-21);

        return __members
            .Where(m => m.fstrMembershipStatus == "Active" && !m.fblnCoreMember && (m.fdtmJoinDate is null || m.fdtmJoinDate.Value.Date <= cutoff))
            .Select(m => new AwayItem(m, __lastSeen.TryGetValue(m.flngKey, out var seen) ? seen : null))
            .Where(a => a.LastSeen is null || a.LastSeen.Value.Date < cutoff)
            .Where(a => !__contacts.Any(c => c.flngMemberKey == a.Member.flngKey && c.fdtmContactDate.Date >= cutoff))
            .OrderBy(a => a.LastSeen ?? DateTime.MinValue)
            .ToList();
    }

    private List<BarItem> Bars()
    {
        var today = AppClock.Today;
        var careable = __members.Count(m => m.fstrMembershipStatus == "Active" && !m.fblnCoreMember);
        return
        [
            new("Assigned", __care.Count, "#4ea1ff", "#1670d6"),
            new("Unassigned", Math.Max(0, careable - __care.Count), "#b9c4d9", "#8b99b3"),
            new("Contacted", __care.Count(c => c.Last is not null && (today - c.Last.fdtmContactDate.Date).TotalDays <= DefaultGapDays), "#7cc0ff", "#3b82f6"),
            new("Overdue", __care.Count(c => c.State == "o"), "#fb7185", "#e11d48"),
            new("Flagged", FlaggedContacts().Count, "#fcd34d", "#f59e0b")
        ];
    }

    #endregion

    #region Side summary (one per tab)

    /// <summary>The summary beside the page: its figures follow the tab that is open.</summary>
    private RolePanelData PanelData()
    {
        var today = AppClock.Today;
        var monthStart = new DateTime(today.Year, today.Month, 1);
        var monthContacts = __contacts.Where(c => c.fdtmContactDate.Date >= monthStart).ToList();
        var lastLogged = __contacts.Count == 0 ? "-" : __contacts.Max(c => c.fdtmContactDate).ToString("d MMM");
        var overdue = __care.Count(c => c.State == "o");
        var dueWeek = __care.Count(c => c.State == "w");
        var core = CoreMembers;

        string Name(Guid key) => core.FirstOrDefault(m => m.flngKey == key)?.fstrFirstname ?? "-";
        var loads = core.Select(m => (m.flngKey, Count: __care.Count(c => c.CarerKey == m.flngKey))).OrderByDescending(x => x.Count).ToList();

        switch (__tab)
        {
            case "assign":
                var careable = __members.Where(m => m.fstrMembershipStatus == "Active" && !m.fblnCoreMember).ToList();
                var without = careable.Count(m => m.flngCarerKey is null);
                return new RolePanelData
                {
                    Title = "Assign",
                    Tiles =
                    [
                        new("Without a carer", without.ToString(), without > 0),
                        new("With a carer", (careable.Count - without).ToString()),
                        new("Active members", careable.Count.ToString()),
                        new("Lightest caseload", loads.Count == 0 ? "-" : $"{Name(loads[^1].flngKey)} · {loads[^1].Count}")
                    ]
                };

            case "log" when __staff:
                var top = monthContacts.GroupBy(c => c.fstrMethod).OrderByDescending(g => g.Count()).FirstOrDefault();
                return new RolePanelData
                {
                    Title = "Care log",
                    Tiles =
                    [
                        new("Contacts this month", monthContacts.Count.ToString()),
                        new("Most used method", top is null ? "-" : $"{top.Key} · {top.Count()}"),
                        new("Flagged this month", monthContacts.Count(c => c.fblnFlagForMinister).ToString()),
                        new("Last logged", lastLogged)
                    ]
                };

            case "log":
                return new RolePanelData
                {
                    Title = "My log",
                    Tiles =
                    [
                        new("Contacts this month", monthContacts.Count.ToString()),
                        new("Total logged", __contacts.Count.ToString()),
                        new("Open flags", FlaggedContacts().Count.ToString(), FlaggedContacts().Count > 0),
                        new("Last logged", lastLogged)
                    ]
                };

            case "minister":
                var attention = NeedsAttention();
                var open = FlaggedContacts().Count;
                return new RolePanelData
                {
                    Title = "Minister's list",
                    Tiles =
                    [
                        new("Open flags", open.ToString(), open > 0),
                        new("Flags resolved this month", monthContacts.Count(c => c.fblnFlagForMinister && c.fblnFlagResolved).ToString()),
                        new("Needs attention", attention.Count.ToString(), attention.Count > 0),
                        new("Away with no carer", attention.Count(a => a.Member.flngCarerKey is null).ToString())
                    ]
                };

            case "mine":
                return new RolePanelData
                {
                    Title = "My caseload",
                    Tiles =
                    [
                        new("Members in my care", __care.Count.ToString()),
                        new("Due for a contact", (overdue + dueWeek).ToString(), overdue + dueWeek > 0),
                        new("My contacts this month", monthContacts.Count.ToString()),
                        new("Last logged", lastLogged)
                    ]
                };

            default:
                var busiest = loads.FirstOrDefault();
                return new RolePanelData
                {
                    Title = "Caseloads",
                    Tiles =
                    [
                        new("Members in care", __care.Count.ToString()),
                        new("Core members", core.Count.ToString()),
                        new("Due this week", dueWeek.ToString()),
                        new("Overdue", overdue.ToString(), overdue > 0),
                        new("Busiest carer", busiest.Count == 0 ? "-" : $"{Name(busiest.flngKey)} · {busiest.Count}"),
                        new("Core members with none", core.Count(m => __care.All(c => c.CarerKey != m.flngKey)).ToString())
                    ]
                };
        }
    }

    #endregion

    #region Assign

    private async Task AssignAsync(Guid memberKey, string? choice)
    {
        if (!__staff) return; // only the administrator and the minister give members to carers

        Guid? carer = Guid.TryParse(choice, out var g) ? g : null;
        if (carer is null && choice != "remove") return; // "Assign to..." placeholder

        __toast = await AssignmentRepo.AssignPastoralCare(memberKey, carer, AppConstants.Who, __cts.Token);
        await LoadAsync();
    }

    #endregion

    #region Log a contact

    private bool CanEdit(PastoralContactModel c) => !__staff && __myKey == c.flngCoreMemberKey;

    /// <summary>Members a chosen carer looks after (the choices in the Member drop-down).</summary>
    private List<CareItem> LogMemberChoices()
    {
        var carer = __staff ? __logCarer : __myKey;
        return carer is Guid k ? CareOf(k) : [];
    }

    private void StartLog(Guid? carerKey, Guid? memberKey, PastoralContactModel? existing)
    {
        __logIsEdit = existing is not null;
        __logCarer = __staff ? carerKey : __myKey;
        __logMember = memberKey;
        __log = existing is null
            ? new PastoralContactModel { fdtmContactDate = AppClock.Today, fdtmNextContactDate = AppClock.Today.AddDays(14), fstrMethod = "Phone call" }
            : new PastoralContactModel
            {
                flngKey = existing.flngKey, flngCoreMemberKey = existing.flngCoreMemberKey, flngMemberKey = existing.flngMemberKey,
                fdtmContactDate = existing.fdtmContactDate, fstrMethod = existing.fstrMethod, fstrNotes = existing.fstrNotes,
                fdtmNextContactDate = existing.fdtmNextContactDate, fblnFlagForMinister = existing.fblnFlagForMinister,
                fblnFlagResolved = existing.fblnFlagResolved
            };
    }

    private async Task SaveLogAsync()
    {
        if (__log is null) return;
        var ct = __cts.Token;

        // Privacy: a Pastoral Care account can only ever write as itself, about someone in its own care
        var carer = __staff ? __logCarer : __myKey;
        if (carer is null || __logMember is null)
        {
            __toast = new() { ToastType = ToastTypeModel.Warning, Message = "Choose the member you contacted" };
            return;
        }

        var link = await AssignmentRepo.SelectPastoralAssignment(coreMemberKey: carer, memberKey: __logMember, cancellationToken: ct);
        if (link.Count == 0)
        {
            __toast = new() { ToastType = ToastTypeModel.Warning, Message = "That member is not in this carer's care" };
            return;
        }

        if (__logIsEdit)
        {
            var own = await ContactRepo.SelectPastoralContact(key: __log.flngKey, coreMemberKey: __myKey, cancellationToken: ct);
            if (!__staff && own.Count == 0)
            {
                __toast = new() { ToastType = ToastTypeModel.Danger, Message = "You can only change your own entries" };
                return;
            }
        }

        __log.flngCoreMemberKey = carer.Value;
        __log.flngMemberKey = __logMember.Value;
        __log.fstrWho = AppConstants.Who;

        __toast = await ContactRepo.AddOrUpdatePastoralContact(__log, insert: !__logIsEdit, ct);
        if (!__toast.IsSuccess) return;

        __log = null;
        await LoadAsync();
    }

    private async Task DeleteContactAsync(PastoralContactModel c)
    {
        var ct = __cts.Token;
        if (!__isAdmin)
        {
            // A carer may only remove their own entries
            var own = await ContactRepo.SelectPastoralContact(key: c.flngKey, coreMemberKey: __myKey, cancellationToken: ct);
            if (__myKey is null || own.Count == 0)
            {
                __toast = new() { ToastType = ToastTypeModel.Danger, Message = "You can only remove your own entries" };
                return;
            }
        }

        __toast = await ContactRepo.DeletePastoralContact(c.flngKey, AppConstants.Who, ct);
        await LoadAsync();
    }

    private async Task ResolveAsync(PastoralContactModel c)
    {
        if (!__staff) return;
        c.fblnFlagResolved = true;
        c.fstrWho = AppConstants.Who;
        __toast = await ContactRepo.AddOrUpdatePastoralContact(c, insert: false, __cts.Token);
        await LoadAsync();
    }

