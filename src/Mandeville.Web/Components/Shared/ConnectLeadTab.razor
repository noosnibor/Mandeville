@implements IDisposable
@inject IVisitorRepository VisitorRepo
@inject IVisitorAttendanceRepository AttendanceRepo
@inject IDepartmentRepository DepartmentRepo
@inject IMemberRepository MemberRepo

<ToastBar Toast="__toast" />

<div class="vkpi card">
    <div><b>@__rows.Count</b><span>Visitors</span></div>
    <div><b>@__rows.Count(r => r.Altar)</b><span>Went to the altar</span></div>
    <div><b class="@(__rows.Count(r => r.Altar && r.AssignTo is null) > 0 ? "warn" : "")">@__rows.Count(r => r.Altar && r.AssignTo is null)</b><span>Altar, not assigned</span></div>
</div>

@* ---------- Referred by Member care: waiting for the team lead to choose a connecter ---------- *@
@if (__referrals.Count > 0)
{
    <div class="ref-lead card">
        <h2><span class="ref-ico"><Icon Name="userplus" Size="18" Stroke="1.7" /></span>Referred by Member care <span class="chip g ref-count">@__referrals.Count waiting</span></h2>
        <p class="ref-sub">Choose who follows each person up.</p>
        @foreach (var v in __referrals)
        {
            var visitor = v;
            <div class="ref-row">
                <div class="ucard-avatar" style="background:@AvatarStyle.Colour(visitor.flngKey)">@AvatarStyle.Initials(visitor.fstrFirstname, visitor.fstrLastname)</div>
                <div class="ref-who"><b>@visitor.FullName</b><small>@(string.IsNullOrWhiteSpace(visitor.fstrPhoneNumber) ? "No phone" : visitor.fstrPhoneNumber) &middot; referred @(visitor.fdtmReferralDate?.ToString("d MMM") ?? "")</small></div>
                <span class="ref-tag">@visitor.fstrReferralReason</span>
                <select class="ref-pick" aria-label="Assign @visitor.FullName to" @bind="__refAssign[visitor.flngKey]">
                    <option value="">Assign to...</option>
                    @foreach (var m in __connectors) { <option value="@m.flngKey">@m.FullName</option> }
                </select>
            </div>
        }
        <div class="ref-actions"><button class="ref-go ref-save" @onclick="SaveReferralsAsync">Save</button></div>
    </div>
}

<div class="cl-line">
    <span class="svc-line-label">Service date</span>
    <input class="mdate" type="date" max="@AppClock.Today.ToString("yyyy-MM-dd")" @bind="__date" />
    <button class="svc-pill on" @onclick="LoadClickAsync">Load</button>
</div>

@* ---------- Team workload ---------- *@
<div class="wl card">
    <div class="wl-head">
        <span class="svc-ico"><Icon Name="users" Size="18" Stroke="1.5" /></span>
        <b>Team workload</b>
        <span class="wl-total">@__workload.Sum(w => w.flngAssigned) assigned@(NotAssigned() > 0 ? $" · {NotAssigned()} waiting" : "")</span>
    </div>
    <div class="wl-row">
        @foreach (var w in __workload)
        {
            var mine = __rows.Where(r => r.Altar && r.AssignTo == w.flngMemberKey).ToList();
            var prayer = mine.Count(r => r.Reason == "Prayer");
            var membership = mine.Count(r => r.Reason == "Membership");
            <div class="wl-card">
                <div class="wl-top">
                    <i style="background:@AvatarStyle.Colour(w.flngMemberKey)">@InitialsOf(w.FullName)</i>
                    <div><b>@w.FullName</b><small>@(mine.Count == 0 ? "None this service" : $"{prayer} prayer · {membership} membership")</small></div>
                </div>
                <div class="wl-n"><span>Assigned</span><strong>@w.flngAssigned</strong></div>
                <div class="wl-bar"><i style="width:@(MaxAssigned() == 0 ? 0 : w.flngAssigned * 100 / MaxAssigned())%"></i></div>
            </div>
        }
        @if (NotAssigned() > 0)
        {
            <div class="wl-card un">
                <div class="wl-top"><i>?</i><div><b>Not assigned</b><small>Altar calls waiting</small></div></div>
                <div class="wl-n"><span>Waiting</span><strong>@NotAssigned()</strong></div>
                <div class="wl-bar"><i style="width:@(Math.Min(100, NotAssigned() * 100 / Math.Max(1, __rows.Count(r => r.Altar))))%"></i></div>
            </div>
        }
        @if (__workload.Count == 0) { <span class="mwl-empty plain"><Icon Name="info" Size="18" Stroke="1.6" />No one has been assigned yet.</span> }
    </div>
</div>

<div class="cl-card card">
    <p class="cl-hint">Tick the box for anyone who went to the altar, choose the reason, then choose who follows them up. For the reason Membership, the team member calls them and adds them to Incoming members once they confirm.</p>

    @foreach (var r in __rows)
    {
        var row = r;
        <div class="lrow @(row.Altar ? "altar" : "")">
            <div class="ucard-avatar" style="background:@AvatarStyle.Colour(row.Visitor.flngKey)">@AvatarStyle.Initials(row.Visitor.fstrFirstname, row.Visitor.fstrLastname)</div>
            <div class="ucard-text">
                <b>@row.Visitor.FullName</b>
                <small>@row.Visitor.fstrAgeGroup &middot; @row.Visitor.fstrGender &middot; @(string.IsNullOrWhiteSpace(row.Visitor.fstrPhoneNumber) ? "No phone" : row.Visitor.fstrPhoneNumber)</small>
            </div>
            <label class="lcheck"><input type="checkbox" class="mswitch" @bind="row.Altar" /><span class="altar-pill">Altar</span></label>
            @if (row.Altar)
            {
                <select @bind="row.Reason">
                    <option value="">Reason for the altar...</option>
                    @foreach (var reason in FixedLists.AltarReasons) { <option value="@reason">@reason</option> }
                </select>
                <select @bind="row.AssignTo">
                    <option value="">-- assign to --</option>
                    @foreach (var m in __connectors) { <option value="@m.flngKey">@m.FullName</option> }
                </select>
            }
            else
            {
                <span class="hint lbasic">Basic card only</span>
            }
        </div>
    }
    @if (__rows.Count == 0) { <p class="empty">No visitors attended on this date.</p> }

    @if (__rows.Count > 0)
    {
        <div class="lbar"><span><Icon Name="userplus" Size="22" Stroke="1.5" />Membership people are called first, then added to Incoming members.</span><button class="btn btn-primary" @onclick="SaveAsync"><Icon Name="check" Size="18" />Save Changes</button></div>
    }
</div>

@code {
    #region Private Fields

    private readonly CancellationTokenSource __cts = new();

    /// <summary>Raised with the service date ("yyyy-MM-dd") after loading or saving, so the summary refreshes.</summary>
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    private DateTime? __date = AppClock.Today;
    private List<VisitorModel> __referrals = [];
    private Dictionary<Guid, Guid?> __refAssign = [];
    private List<LeadRow> __rows = [];
    private List<MemberModel> __connectors = [];
    private List<ConnectWorkloadModel> __workload = [];
    private Guid? __teamDepartmentKey;
    private ToastMessageModel? __toast;

    /// <summary>One visitor for the chosen service, with what the team lead has decided so far.</summary>
    private sealed class LeadRow
    {
        public required VisitorModel Visitor { get; init; }
        public VisitorAttendanceModel? Attendance { get; init; }
        public bool Altar { get; set; }
        public string? Reason { get; set; }
        public Guid? AssignTo { get; set; }

        // What was saved when the list was loaded, used to find what changed.
        public bool WasAltar { get; init; }
        public string? WasReason { get; init; }
        public Guid? WasAssignTo { get; init; }
    }

    #endregion

    protected override async Task OnInitializedAsync()
    {
        // The connection team is the department whose name contains "connect" (when one exists); otherwise any active member can be chosen.
        var departments = await DepartmentRepo.SelectDepartment(active: true, cancellationToken: __cts.Token);
        __teamDepartmentKey = departments.FirstOrDefault(d => d.fstrName.Contains("connect", StringComparison.OrdinalIgnoreCase))?.flngKey;

        __connectors = await MemberRepo.SelectMember(membershipStatus: "Active", departmentKey: __teamDepartmentKey, cancellationToken: __cts.Token);
        await LoadAsync();
    }

    public void Dispose()
    {
        __cts.Cancel();
        __cts.Dispose();
    }

    #region Display helpers

    /// <summary>Two-letter initials from a full name.</summary>
    private static string InitialsOf(string? name) =>
        string.Concat((name ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    #endregion

    #region Loading

    /// <summary>Loads the visitors who attended the chosen service, with their altar reason and connector.</summary>
    private int NotAssigned() => __rows.Count(r => r.Altar && r.AssignTo is null);

    private int MaxAssigned() => __workload.Count == 0 ? 0 : __workload.Max(w => w.flngAssigned);

    private async Task LoadClickAsync()
    {
        await LoadAsync();
        await NotifyAsync();
    }

    /// <summary>Tells the page which service date is on screen so the summary can follow it.</summary>
    private Task NotifyAsync() => OnChanged.InvokeAsync((__date ?? AppClock.Today).ToString("yyyy-MM-dd"));

    private async Task LoadAsync()
    {
        if (__date is null)
        {
            __rows = [];
            return;
        }

        var visitors = await VisitorRepo.SelectVisitor(attendedOn: __date.Value.Date, cancellationToken: __cts.Token);
        var attendance = await AttendanceRepo.SelectVisitorAttendance(serviceDate: __date.Value.Date, cancellationToken: __cts.Token);
        var byVisitor = attendance.GroupBy(a => a.flngVisitorKey).ToDictionary(g => g.Key, g => g.First());

        // People already moved to Incoming members (or already members) are no longer on this list.
        __rows = visitors.Where(v => v.fstrStatus is "Visitor" or "Regular Visitor").Select(v =>
        {
            byVisitor.TryGetValue(v.flngKey, out var a);
            var altar = !string.IsNullOrWhiteSpace(a?.fstrAltarReason);

            // "Member" is the old name of the reason Membership.
            var reason = FixedLists.IsMembershipReason(a?.fstrAltarReason) ? "Membership" : a?.fstrAltarReason;

            return new LeadRow
            {
                Visitor = v, Attendance = a,
                Altar = altar, WasAltar = altar,
                Reason = reason, WasReason = reason,
                AssignTo = v.flngFollowUpMemberKey, WasAssignTo = v.flngFollowUpMemberKey
            };
        }).ToList();

        __workload = await VisitorRepo.SelectConnectWorkload(__teamDepartmentKey, __cts.Token);
        await LoadReferralsAsync();
    }

    /// <summary>Visitors Member care has referred who still have no connecter, oldest first.</summary>
    private async Task LoadReferralsAsync()
    {
        var all = await VisitorRepo.SelectVisitor(cancellationToken: __cts.Token);
        __referrals = all.Where(v => v.fstrReferralReason is not null && v.flngFollowUpMemberKey is null && v.fstrStatus is "Visitor" or "Regular Visitor")
                         .OrderBy(v => v.fdtmReferralDate).ThenBy(v => v.fstrLastname).ToList();
        __refAssign = __referrals.ToDictionary(v => v.flngKey, _ => (Guid?)null);
    }

    /// <summary>Assigns every referred visitor the lead has chosen a connecter for.</summary>
    private async Task SaveReferralsAsync()
    {
        var chosen = __referrals.Where(v => __refAssign.GetValueOrDefault(v.flngKey) is not null).ToList();
        if (chosen.Count == 0)
        {
            __toast = new() { ToastType = ToastTypeModel.Warning, Message = "Choose a team member for at least one referral" };
            return;
        }

        foreach (var v in chosen)
        {
            var assign = await VisitorRepo.AssignVisitorConnect(v.flngKey, __refAssign[v.flngKey], AppConstants.Who, __cts.Token);
            if (!assign.IsSuccess)
            {
                __toast = assign;
                await LoadAsync();
                return;
            }
        }

        await LoadAsync();
        await NotifyAsync();
        __toast = new() { ToastType = ToastTypeModel.Success, Message = $"Assigned. {chosen.Count} referral(s) now with the team" };
    }

    #endregion

    #region Saving

    /// <summary>
    /// Saves every row that changed: the altar reason on the attendance and the connector on the visitor.
    /// Membership does not move the person: their team member calls first and adds them to Incoming members.
    /// </summary>
    private async Task SaveAsync()
    {
        var missing = __rows.Count(r => r.Altar && string.IsNullOrWhiteSpace(r.Reason));
        if (missing > 0)
        {
            __toast = new() { ToastType = ToastTypeModel.Warning, Message = $"Choose the reason for the altar for {missing} visitor(s)" };
            return;
        }

        var saved = 0;
        foreach (var row in __rows.Where(Changed))
        {
            var failure = await SaveRowAsync(row);
            if (failure is not null)
            {
                __toast = failure;
                await LoadAsync();
                return;
            }
            saved++;
        }

        await LoadAsync();
        await NotifyAsync();
        __toast = new()
        {
            ToastType = saved == 0 ? ToastTypeModel.Primary : ToastTypeModel.Success,
            Message = saved == 0 ? "Nothing to save" : $"Saved. {saved} visitor(s) updated and shown to the team"
        };
    }

    private static bool Changed(LeadRow r) =>
        r.Altar != r.WasAltar
        || (r.Altar && (r.Reason != r.WasReason || r.AssignTo != r.WasAssignTo));

    /// <summary>Returns a failure toast, or null when the row saved.</summary>
    private async Task<ToastMessageModel?> SaveRowAsync(LeadRow row)
    {
        var ct = __cts.Token;

        // 1. The altar reason lives on the visit.
        if (row.Attendance is not null)
        {
            row.Attendance.fstrAltarReason = row.Altar ? row.Reason : null;
            row.Attendance.fstrWho = AppConstants.Who;
            var attendance = await AttendanceRepo.AddOrUpdateVisitorAttendance(row.Attendance, false, ct);
            if (!attendance.IsSuccess) return attendance;
        }

        if (!row.Altar) return null;

        // 2. The connector who follows the person up.
        if (row.AssignTo != row.WasAssignTo)
        {
            var assign = await VisitorRepo.AssignVisitorConnect(row.Visitor.flngKey, row.AssignTo, AppConstants.Who, ct);
            if (!assign.IsSuccess) return assign;
        }

        // 3. A new follow-up starts with a call due today.
        var v = row.Visitor;
        if (row.AssignTo is not null && v.fdtmNextContactDate is null)
        {
            v.fdtmNextContactDate = AppClock.Today;
            v.fstrWho = AppConstants.Who;
            var update = await VisitorRepo.AddOrUpdateVisitor(v, false, ct);
            if (!update.IsSuccess) return update;
        }

        return null;
    }

    #endregion
}
