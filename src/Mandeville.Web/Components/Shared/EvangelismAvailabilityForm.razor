@* The grid a member fills in: tap each Saturday and area they can serve, or say they are not available this month.
   Used on the member's private page, in My assignments, and by the team lead when answering for someone. *@

<label class="ev-na">
    <input type="checkbox" checked="@NotAvailable" @onchange="OnNotAvailableAsync" />
    <span>I am not available this month</span>
</label>

@if (NotAvailable)
{
    <p class="hint">No problem. We will not schedule you this month.</p>
}
else
{
    <p class="hint">Tap every Saturday and area you can serve. You will be scheduled at least once and at most twice in the month.</p>

    @foreach (var day in Days)
    {
        <div class="ev-day">
            <div class="evg-date"><b>@day.Day</b><span>@day.ToString("MMM")</span></div>
            <div class="ev-day-name">@day.ToString("dddd d MMMM")</div>
            <div class="ev-opts">
                @foreach (var o in Options.Where(x => x.Date.Date == day).OrderBy(x => x.Area))
                {
                    var key = Key(o.Date, o.Area);
                    <button type="button" class="ev-opt @(Selected.Contains(key) ? "on" : "")" @onclick="() => Toggle(key)">@EvangelismRules.ShortArea(o.Area)</button>
                }
            </div>
        </div>
    }
    @if (Options.Count == 0) { <p class="empty">No sessions have been planned for this month yet.</p> }
}

@code {
    #region Parameters

    /// <summary>The Saturday and area pairs the member can pick from.</summary>
    [Parameter] public List<(DateTime Date, string Area)> Options { get; set; } = [];

    /// <summary>What is ticked, as "yyyy-MM-dd|Area". The same set is changed in place, so the page that owns it sees the ticks.</summary>
    [Parameter] public HashSet<string> Selected { get; set; } = [];

    [Parameter] public bool NotAvailable { get; set; }
    [Parameter] public EventCallback<bool> NotAvailableChanged { get; set; }

    #endregion

    private IEnumerable<DateTime> Days => Options.Select(o => o.Date.Date).Distinct().OrderBy(d => d);

    public static string Key(DateTime date, string area) => $"{date:yyyy-MM-dd}|{area}";

    /// <summary>Turns a "yyyy-MM-dd|Area" key back into its two parts.</summary>
    public static (DateTime Date, string Area) Parse(string key)
    {
        var parts = key.Split('|', 2);
        return (DateTime.ParseExact(parts[0], "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture), parts[1]);
    }

    private void Toggle(string key)
    {
        if (!Selected.Remove(key)) Selected.Add(key);
    }

    private async Task OnNotAvailableAsync(ChangeEventArgs e)
    {
        NotAvailable = e.Value is true;
        await NotAvailableChanged.InvokeAsync(NotAvailable);
    }
}
