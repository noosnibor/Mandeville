@using System.Security.Cryptography
@using QRCoder
@implements IDisposable
@inject IServiceRepository ServiceRepo
@inject IMemberAttendanceRepository AttendanceRepo
@inject IMemberRepository MemberRepo
@inject IVisitingAttendanceRepository VisitingRepo
@inject IBranchRepository BranchRepo
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IJSRuntime JS

<ToastBar Toast="__toast" />

<div class="att-layout @(__service is null ? "att-list" : "att-detail")">
    @* ---------- Services as cards ---------- *@
    <div class="card att-services">
        <h2><span class="h2-ico"><Icon Name="calendar" Size="20" Stroke="1.6" /></span>Services <span class="pill-ok">@FilteredServices().Count @(FilteredServices().Count == 1 ? "service" : "services")</span></h2>

        <label class="att-searchbox">
            <Icon Name="search" Size="18" Stroke="1.5" />
            <input type="text" class="att-search" placeholder="Search by name or date (e.g. Sunday or 08)" aria-label="Search services" value="@__serviceSearch" @oninput="OnServiceSearch" />
        </label>

        @foreach (var s in PageServices())
        {
            <div class="scard @(__service?.flngKey == s.flngKey ? "selected" : "")" @onclick="() => SelectServiceAsync(s)">
                <div class="scard-date"><b>@s.fdtmServiceDate.ToString("dd")</b><span>@s.fdtmServiceDate.ToString("MMM")</span></div>
                <div class="scard-text">
                    <b>@s.fstrServiceName</b>
                    <small>@s.fdtmServiceDate.ToString("ddd dd MMM yyyy")</small>
                    <div class="scard-meta">
                        @if (s.ftimStartTime.HasValue) { <span><Icon Name="clock" Size="13" /> @(s.ftimStartTime.Value.ToString("hh\\:mm"))</span> }
                        <span class="@(PresentCount(s.flngKey) > 0 ? "hi" : "")"><Icon Name="users" Size="13" /> @PresentCount(s.flngKey) present</span>
                    </div>
                </div>
                @if (s.IsOpenNow) { <span class="pill-ok">Open</span> }
                <span class="scard-go" aria-hidden="true"><Icon Name="chevronright" Size="18" Stroke="1.8" /></span>
            </div>
        }
        @if (__services.Count == 0) { <p class="empty">No services yet.</p> }
        else if (FilteredServices().Count == 0) { <p class="empty">No service matches your search.</p> }

        <Pager Page="__servicePage" PageSize="ServicePageSize" Total="FilteredServices().Count" PageChanged="SetServicePage" />

        @if (__loadingAll)
        {
            <div class="load-box">
                Loading all services&hellip;
                <div class="loadbar" role="progressbar" aria-label="Loading services"><i></i></div>
            </div>
        }
        else if (!__allLoaded)
        {
            <div class="load-box">
                <span class="load-info"><Icon Name="info" Size="18" Stroke="1.5" />Showing the last 120 days. Older services are not loaded yet.</span>
                <div><button class="btn btn-primary btn-sm" @onclick="LoadAllServicesAsync"><Icon Name="download" Size="16" Stroke="1.8" />Load all services</button></div>
            </div>
        }
    </div>

    <div class="att-main">
        @if (__service is null)
        {
            <div class="card att-empty">
                <span class="att-empty-ico"><Icon Name="calendar" Size="34" Stroke="1.4" /></span>
                <b>No service selected</b>
                <p>Pick a service on the left to see its attendance.</p>
            </div>
        }
        else
        {
            @* Phone only: a way back to the list of services (the list and the service are separate screens on a phone) *@
            <button class="att-back" @onclick="BackToList"><Icon Name="chevronleft" Size="18" Stroke="2" />Services</button>

            @* ---------- Selected service summary ---------- *@
            <div class="card att-head">
                <span class="att-head-ico"><Icon Name="calendar" Size="24" Stroke="1.6" /></span>
                <div class="att-head-text">
                    @if (__service.fblnCheckInOpen) { <span class="hd-live">Check-in open</span> }
                    <h2>@__service.fstrServiceName</h2>
                    <div class="att-head-meta">
                        <span><Icon Name="calendar" Size="15" /> @__service.fdtmServiceDate.ToString("ddd dd MMM yyyy")</span>
                        @if (__service.ftimStartTime.HasValue) { <span><Icon Name="clock" Size="15" /> @(__service.ftimStartTime.Value.ToString("hh\\:mm"))</span> }
                        <span class="att-m-present"><Icon Name="users" Size="15" /> @(__attendance.Count + __visiting.Count) present</span>
                    </div>
                    <div class="hd-bar"><i style="width:@(LivePercent)%"></i></div>
                </div>
                @* Tablet and desktop only: headline numbers *@
                <div class="hd-stats">
                    <div><b>@__attendance.Count<span> / @__members.Count</span></b><small>members present &middot; @LivePercent%</small></div>
                    <div><b>@__visiting.Count</b><small>visiting</small></div>
                </div>
                @if (__service.fblnCheckInOpen)
                {
                    <span class="pill-ok">Check-in open</span>
                }
                else
                {
                    <button class="btn-record" title="Open check-in" @onclick="OpenAsync"><Icon Name="plus" Size="18" Stroke="2" />Record Attendance</button>
                }
            </div>

            @* Phone only: switch between the members, the visiting members and the QR code *@
            <div class="att-seg" role="tablist">
                <button role="tab" class="@(ShowQrTab || ShowVisitingTab ? "" : "on") @(ShowVisitingTab ? "" : "don")" @onclick='() => __attTab = "checked"'>Members &middot; @__attendance.Count</button>
                <button role="tab" class="@(ShowVisitingTab ? "on" : "")" @onclick='() => __attTab = "visiting"'>Visiting &middot; @__visiting.Count</button>
                @if (__service.fblnCheckInOpen)
                {
                    <button role="tab" class="@(ShowQrTab ? "on" : "")" @onclick='() => __attTab = "qr"'>QR code</button>
                }
            </div>

            @if (__service.fblnCheckInOpen)
            {
                @* ---------- QR check-in ---------- *@
                <div class="card att-qrcard @(ShowQrTab ? "" : "att-hide")">
                    <h2><span class="h2-ico"><Icon Name="scan" Size="20" Stroke="1.6" /></span>Check-in <span class="pill-ok">Open</span></h2>
                    <div class="qr-box">
                        @if (!string.IsNullOrEmpty(__qrImage))
                        {
                            <img class="qr-img" src="@__qrImage" alt="Check-in QR code" width="240" height="240" />
                        }
                        <div>
                            <p class="hint" style="margin-top:0">Window: @__service.fdtmCheckInOpens?.ToString("HH:mm") to @__service.fdtmCheckInCloses?.ToString("HH:mm"). The code stays the same for this service, so it can be printed or put on a screen.</p>
                            <p class="qr-link"><a href="@__checkInUrl" target="_blank" rel="noopener">@__checkInUrl</a></p>
                            <button class="btn btn-sm att-copy" @onclick="CopyLinkAsync"><Icon Name="link" Size="16" Stroke="1.8" />@(__copied ? "Link copied" : "Copy check-in link")</button>
                            @if (__localOnly)
                            {
                                <div class="qr-warn">
                                    This address only works on this computer, so a phone cannot open it after scanning.
                                    Set <b>Church:PublicBaseUrl</b> in appsettings.json to your website address (or run the
                                    <b>network</b> profile and use this PC's network address), then open check-in again.
                                </div>
                            }
                            <div class="actions">
                                <button class="btn btn-sm" title="Refresh the code now" @onclick="RotateAsync"><Icon Name="refresh" Size="16" Stroke="1.8" />Refresh</button>
                                <button class="btn btn-sm btn-danger" title="Close check-in" @onclick="CloseAsync"><Icon Name="x" Size="16" Stroke="1.8" />Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            @* ---------- Checked in people as cards ---------- *@
            <div class="card att-checkedcard @(ShowQrTab || ShowVisitingTab ? "att-hide" : "") @(ShowVisitingTab ? "att-vis" : "")">
                <h2><span class="h2-ico"><Icon Name="users" Size="20" Stroke="1.6" /></span>Checked in @if (__service.fblnCheckInOpen) { <span class="live-badge">Live</span> } else { <span class="pill-ok">@__attendance.Count present</span> }</h2>

                <div class="live-count">
                    <b>@__attendance.Count</b>
                    <div class="live-track"><i style="width:@(LivePercent)%"></i></div>
                    <div class="live-line"><span>of @__members.Count active members</span><span>@LivePercent%</span></div>
                </div>

                <div class="mfilter" style="margin-bottom:.4rem">
                    <select @bind="__manualMember">
                        <option value="">Mark a member by hand...</option>
                        @foreach (var m in __members) { <option value="@m.flngKey">@m.FullName</option> }
                    </select>
                    <button class="btn btn-dark btn-sm" @onclick="AddManualAsync"><Icon Name="check" Size="16" Stroke="2" />Mark present</button>
                </div>

                @foreach (var a in __attendance)
                {
                    <div class="ucard @(__fresh.Contains(a.flngKey) ? "fresh" : "")">
                        <div class="ucard-avatar" style="background:@AvatarStyle.Colour(a.flngMemberKey)">@AvatarStyle.Initials(a.fstrMemberFirstname, a.fstrMemberLastname)</div>
                        <div class="ucard-text"><b>@a.MemberName</b><small>@a.fdtmCheckedInAt.ToString("HH:mm")</small></div>
                        <span class="tag @(a.fstrMethod == "QR" ? "" : "m")">@a.fstrMethod</span>
                        <button class="ucard-remove" title="Remove" aria-label="Remove" @onclick="() => RemoveAsync(a)">&#10005;</button>
                    </div>
                }
                @if (__attendance.Count == 0)
                {
                    <div class="att-empty">
                        <span class="att-empty-ico"><Icon Name="users" Size="34" Stroke="1.4" /></span>
                        <b>No attendance recorded yet</b>
                        <p>@(__service.fblnCheckInOpen ? "Nobody has checked in yet. Members appear here as they scan the code." : "Pick a service on the left, or click \"Record Attendance\" to start taking attendance. Check-in stays open until 90 minutes after the start time (at least two hours), and you can close it any time.")</p>
                    </div>
                }
            </div>

            @* ---------- Visiting members: WAFIF members from other branches (not on the member list) ---------- *@
            <div class="card att-visitcard @(ShowVisitingTab ? "" : "att-hide")">
                <h2><span class="h2-ico"><Icon Name="userplus" Size="20" Stroke="1.6" /></span>Visiting members <span class="pill-ok">@__visiting.Count</span></h2>

                <div class="vis-tiles">
                    <div><b>@__attendance.Count</b><small>Members of @__members.Count active</small></div>
                    <div class="v"><b>@__visiting.Count</b><small>Visiting from other branches</small></div>
                </div>

                <button class="btn-record vis-add" @onclick="OpenVisitSheetAsync"><Icon Name="plus" Size="18" Stroke="2" />Add visiting member</button>

                @if (__visiting.Count > 0)
                {
                    <div class="vis-label">Visiting today</div>
                    @foreach (var v in __visiting)
                    {
                        var visit = v;
                        <div class="ucard">
                            <div class="ucard-avatar" style="background:@AvatarStyle.Colour(visit.flngVisitingMemberKey)">@AvatarStyle.Initials(visit.fstrFirstname, visit.fstrLastname)</div>
                            <div class="ucard-text"><b>@visit.FullName</b><small>@visit.fdtmCheckedInAt.ToString("HH:mm") &middot; @(visit.fstrMethod == "QR" ? "Scanned" : "By hand")</small></div>
                            <span class="vis-branch">@visit.fstrBranch</span>
                            <button class="ucard-remove" title="Remove" aria-label="Remove" @onclick="() => RemoveVisitingAsync(visit)">&#10005;</button>
                        </div>
                    }
                }
                else
                {
                    <div class="att-empty">
                        <span class="att-empty-ico"><Icon Name="userplus" Size="34" Stroke="1.4" /></span>
                        <b>No visiting members yet</b>
                        <p>Add a WAFIF member from another branch. Next time they can check in by QR.</p>
                    </div>
                }
            </div>
        }
    </div>
</div>

@if (__visitOpen)
{
    <Modal Title="Add visiting member" Subtitle="For WAFIF members from another branch. They are not added to your member list." Icon="userplus" CssClass="mem-edit vis-sheet" OnClose="() => __visitOpen = false">
        <ChildContent>
            @if (KnownToShow.Any())
            {
                <div class="modal-sec">Been here before</div>
                <div class="vis-known">
                    @foreach (var k in KnownToShow)
                    {
                        var known = k;
                        <button type="button" class="vis-chip" @onclick="() => PickKnown(known)"><b>@known.FullName</b><small>@known.fstrBranch</small></button>
                    }
                </div>
            }

            <div class="form-grid">
                <div class="field">
                    <label>Title</label>
                    <select @bind="__vTitle">
                        <option value="">(none)</option>
                        @foreach (var title in FixedLists.Titles) { <option value="@title">@title</option> }
                    </select>
                </div>
                <div class="field"><label>First name</label><input type="text" maxlength="50" @bind="__vFirst" /></div>
                <div class="field"><label>Last name</label><input type="text" maxlength="50" @bind="__vLast" /></div>
                <div class="field">
                    <label>Branch</label>
                    <select @bind="__vBranch">
                        <option value="">Choose a branch</option>
                        @foreach (var b in BranchChoices) { <option value="@b">@b</option> }
                    </select>
                </div>
            </div>
            <p class="hint">Not on the list? An administrator can add it in Setup, Branches.</p>
        </ChildContent>
        <Footer>
            <button class="btn btn-primary btn-sm" disabled="@__visitBusy" @onclick="SaveVisitingAsync">Mark Present</button>
            <button class="btn btn-sm" @onclick="() => __visitOpen = false">Cancel</button>
        </Footer>
    </Modal>
}

@code {
    #region Private Fields

    private readonly CancellationTokenSource __cts = new();
    private List<ServiceModel> __services = [];
    private List<MemberModel> __members = [];
    private List<MemberAttendanceModel> __attendance = [];
    private ServiceModel? __service;
    private Guid? __manualMember;
    private ToastMessageModel? __toast;
    private string __qrImage = string.Empty;   // the QR code as a PNG picture (data address)
    private string __checkInUrl = string.Empty;
    private bool __localOnly;
    private Timer? __liveTimer;
    private bool __refreshing;
    private readonly HashSet<Guid> __fresh = [];
    private Dictionary<Guid, int> __counts = [];
    private string __attTab = "checked";      // phone: "checked" (people) or "qr" (the code)
    private bool __copied;

    // Visiting members (WAFIF members from other branches)
    private List<VisitingAttendanceModel> __visiting = [];
    private List<VisitingMemberModel> __known = [];
    private List<string> __branches = [];

    /// <summary>The active branches from Setup, plus the chosen one if it was since made inactive.</summary>
    private IEnumerable<string> BranchChoices =>
        string.IsNullOrWhiteSpace(__vBranch) || __branches.Contains(__vBranch) ? __branches : __branches.Append(__vBranch);
    private bool __visitOpen, __visitBusy;
    private string __vTitle = string.Empty, __vFirst = string.Empty, __vLast = string.Empty, __vBranch = string.Empty;

    /// <summary>True when the Visiting tab is chosen on a phone.</summary>
    private bool ShowVisitingTab => __attTab == "visiting";

    /// <summary>Known visiting members who are not already marked present at this service (the "Been here before" quick picks).</summary>
    private IEnumerable<VisitingMemberModel> KnownToShow => __known.Where(k => !__visiting.Any(v => v.flngVisitingMemberKey == k.flngKey)).Take(8);

    /// <summary>True when the QR tab is chosen on a phone and check-in is open (otherwise the people list is shown).</summary>
    private bool ShowQrTab => __attTab == "qr" && __service is { fblnCheckInOpen: true };

    // Service list paging, search and "load all"
    private const int ServicePageSize = 6;
    private int __servicePage = 1;
    private string __serviceSearch = string.Empty;
    private bool __allLoaded, __loadingAll;

    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        __members = await MemberRepo.SelectMember(membershipStatus: "Active", cancellationToken: __cts.Token);
        await LoadServicesAsync();
        await LoadCountsAsync();

        // Pull in new check-ins every few seconds while check-in is open, so the usher sees people appear as they scan.
        __liveTimer = new Timer(_ => _ = InvokeAsync(OnLiveTickAsync), null, AppConstants.LiveRefreshEvery, AppConstants.LiveRefreshEvery);
    }

    public void Dispose()
    {
        __liveTimer?.Dispose();
        __cts.Cancel();
        __cts.Dispose();
    }

    /// <summary>Quietly refreshes the checked-in list and highlights anybody new.</summary>
    private async Task OnLiveTickAsync()
    {
        if (__refreshing || __service is not { fblnCheckInOpen: true }) return;
        __refreshing = true;
        try
        {
            var before = __attendance.Select(a => a.flngKey).ToHashSet();
            await RefreshAttendanceAsync();
            __fresh.Clear();
            foreach (var a in __attendance.Where(a => !before.Contains(a.flngKey))) __fresh.Add(a.flngKey);
            StateHasChanged();
        }
        catch (OperationCanceledException) { /* page closed */ }
        catch (ObjectDisposedException) { /* page closed */ }
        finally { __refreshing = false; }
    }

    private int LivePercent => __members.Count == 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * __attendance.Count / __members.Count));

    #endregion

    #region Services

    private async Task LoadServicesAsync()
    {
        // The last 120 days to start with; every service once "Load all services" has been pressed.
        __services = await ServiceRepo.SelectService(fromDate: __allLoaded ? null : AppClock.Today.AddDays(-120), cancellationToken: __cts.Token);
        if (__service is not null)
            __service = __services.FirstOrDefault(s => s.flngKey == __service.flngKey);
        BuildQr();
    }

    /// <summary>How many people (members and visiting members) were present at each service, shown on the service cards.</summary>
    private async Task LoadCountsAsync()
    {
        var all = await AttendanceRepo.SelectMemberAttendance(cancellationToken: __cts.Token);
        var visits = await VisitingRepo.SelectVisitingAttendance(cancellationToken: __cts.Token);
        // Members and visiting members both count as present
        __counts = all.Select(a => a.flngServiceKey).Concat(visits.Select(v => v.flngServiceKey))
            .GroupBy(k => k).ToDictionary(g => g.Key, g => g.Count());
    }

    /// <summary>Gets every service, not just the recent ones, while a loading bar shows.</summary>
    private async Task LoadAllServicesAsync()
    {
        __loadingAll = true;
        StateHasChanged();
        try
        {
            __allLoaded = true;
            await LoadServicesAsync();
            await LoadCountsAsync();
        }
        catch (OperationCanceledException) { throw; }
        catch (Exception)
        {
            __allLoaded = false;
            __toast = new() { ToastType = ToastTypeModel.Danger, Message = "Could not load all services. Try again." };
        }
        finally
        {
            __loadingAll = false;
        }
    }

    private void OnServiceSearch(ChangeEventArgs e)
    {
        __serviceSearch = e.Value?.ToString() ?? string.Empty;
        __servicePage = 1;
    }

    private void SetServicePage(int page) => __servicePage = page;

    /// <summary>Services matching the search box (service name or the date as written on the card).</summary>
    private List<ServiceModel> FilteredServices()
    {
        var q = __serviceSearch.Trim();
        if (q.Length == 0) return __services;

        return __services.Where(s =>
            s.fstrServiceName.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            s.fdtmServiceDate.ToString("ddd dd MMM yyyy").Contains(q, StringComparison.OrdinalIgnoreCase) ||
            s.fdtmServiceDate.ToString("dd MMMM yyyy").Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private List<ServiceModel> PageServices()
    {
        var all = FilteredServices();
        var pages = Math.Max(1, (all.Count + ServicePageSize - 1) / ServicePageSize);
        __servicePage = Math.Min(Math.Max(1, __servicePage), pages);
        return all.Skip((__servicePage - 1) * ServicePageSize).Take(ServicePageSize).ToList();
    }

    private int PresentCount(Guid serviceKey) => __counts.TryGetValue(serviceKey, out var n) ? n : 0;

    /// <summary>Phone: returns from a service to the list of services.</summary>
    private void BackToList()
    {
        __service = null;
        __attTab = "checked";
    }

    /// <summary>Copies the check-in link so it can be pasted into a message.</summary>
    private async Task CopyLinkAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", __checkInUrl);
            __copied = true;
            StateHasChanged();
            await Task.Delay(2000, __cts.Token);
            __copied = false;
        }
        catch (Exception) { /* clipboard not available; the link is still shown above */ }
    }

    private async Task SelectServiceAsync(ServiceModel s)
    {
        __attTab = "checked";
        __service = s;
        BuildQr();
        await RefreshAttendanceAsync();
    }

    private async Task RefreshAttendanceAsync()
    {
        __attendance = __service is null ? [] : await AttendanceRepo.SelectMemberAttendance(serviceKey: __service.flngKey, cancellationToken: __cts.Token);
        __visiting = __service is null ? [] : await VisitingRepo.SelectVisitingAttendance(serviceKey: __service.flngKey, cancellationToken: __cts.Token);
        if (__service is not null) __counts[__service.flngKey] = __attendance.Count + __visiting.Count;
    }

    #endregion

    #region Check-in (QR)

    private static string NewToken() => Convert.ToHexString(RandomNumberGenerator.GetBytes(8));

    private async Task OpenAsync()
    {
        if (__service is null) return;
        var start = __service.fdtmServiceDate.Date + (__service.ftimStartTime ?? new TimeSpan(9, 0, 0));
        var now = AppClock.Now;

        // Pressing Open means "open now": the window starts 30 minutes before the service, or right now if that time has already
        // passed, and it stays open until 90 minutes after the start, or two hours from now if that is later. (Before, a service on
        // another day or at an earlier time got a window that was already over, so scanning said "Check-in is closed".)
        var opens = start.AddMinutes(-30) < now ? start.AddMinutes(-30) : now;
        var closes = start.AddMinutes(90) > now.AddHours(2) ? start.AddMinutes(90) : now.AddHours(2);
        __toast = await ServiceRepo.OpenCheckIn(__service.flngKey, NewToken(), opens, closes, AppConstants.Who, __cts.Token);
        await LoadServicesAsync();
    }

    private async Task RotateAsync()
    {
        if (__service is null) return;
        __toast = await ServiceRepo.RotateCheckInToken(__service.flngKey, NewToken(), AppConstants.Who, __cts.Token);
        await LoadServicesAsync();
    }

    private async Task CloseAsync()
    {
        if (__service is null) return;
        __toast = await ServiceRepo.CloseCheckIn(__service.flngKey, AppConstants.Who, __cts.Token);
        await LoadServicesAsync();
    }

    /// <summary>Builds the check-in link and its QR code (a PNG picture, so it scales cleanly and needs no System.Drawing).</summary>
    private void BuildQr()
    {
        if (__service is null || !__service.fblnCheckInOpen || string.IsNullOrEmpty(__service.fstrCheckInToken))
        {
            __qrImage = string.Empty;
            __checkInUrl = string.Empty;
            return;
        }

        // Use the public address from settings when there is one, because phones cannot reach "localhost".
        var configured = Configuration["Church:PublicBaseUrl"]?.Trim().TrimEnd('/');
        var baseUri = string.IsNullOrWhiteSpace(configured) ? Navigation.BaseUri.TrimEnd('/') : configured;
        __checkInUrl = $"{baseUri}/checkin/{__service.fstrCheckInToken}";

        var host = Uri.TryCreate(__checkInUrl, UriKind.Absolute, out var uri) ? uri.Host : string.Empty;
        __localOnly = host is "localhost" or "127.0.0.1" or "::1" or "[::1]";

        // Medium error correction + big modules + black on white with a quiet border keeps the code easy to scan.
        // A picture is used instead of inline SVG: the SVG had no viewBox, so the page's CSS size cut the code off and it could not be read.
        using var generator = new QRCodeGenerator();
        using var data = generator.CreateQrCode(__checkInUrl, QRCodeGenerator.ECCLevel.M);
        var png = new PngByteQRCode(data).GetGraphic(12, [0, 0, 0], [255, 255, 255], true);
        __qrImage = "data:image/png;base64," + Convert.ToBase64String(png);
    }

    #endregion

    #region Manual attendance

    private async Task AddManualAsync()
    {
        if (__service is null || __manualMember is null) return;
        var model = new MemberAttendanceModel
        {
            flngServiceKey = __service.flngKey,
            flngMemberKey = __manualMember.Value,
            fdtmCheckedInAt = AppClock.Now,
            fstrMethod = "Manual",
            fstrWho = AppConstants.Who
        };
        __toast = await AttendanceRepo.AddOrUpdateMemberAttendance(model, true, __cts.Token);
        if (__toast.IsSuccess) { __manualMember = null; await RefreshAttendanceAsync(); }
    }

    private async Task RemoveAsync(MemberAttendanceModel a)
    {
        __toast = await AttendanceRepo.DeleteMemberAttendance(a.flngKey, AppConstants.Who, __cts.Token);
        if (__toast.IsSuccess) await RefreshAttendanceAsync();
    }

    #endregion

    #region Visiting members

    /// <summary>Opens the sheet with a clean form, the visitors who came before, and the branches already used.</summary>
    private async Task OpenVisitSheetAsync()
    {
        __vTitle = __vFirst = __vLast = __vBranch = string.Empty;
        __known = await VisitingRepo.SelectKnownVisitors(__cts.Token);
        __branches = (await BranchRepo.SelectBranch(active: true, cancellationToken: __cts.Token)).Select(b => b.fstrName).ToList();
        __visitOpen = true;
    }

    /// <summary>A visitor who has been here before: fills the form in one tap.</summary>
    private void PickKnown(VisitingMemberModel known)
    {
        __vTitle = known.fstrTitle ?? string.Empty;
        __vFirst = known.fstrFirstname;
        __vLast = known.fstrLastname;
        __vBranch = known.fstrBranch;
    }

    /// <summary>Saves the visitor (found by name and branch, or created) and marks them present.</summary>
    private async Task SaveVisitingAsync()
    {
        if (__service is null || __visitBusy) return;

        var branch = __vBranch.Trim();
        if (string.IsNullOrWhiteSpace(__vFirst) || string.IsNullOrWhiteSpace(__vLast) || branch.Length == 0)
        {
            __toast = new() { ToastType = ToastTypeModel.Warning, Message = "Please enter the first name, last name and choose a branch." };
            return;
        }

        __visitBusy = true;
        try
        {
            __toast = await VisitingRepo.AddVisitingAttendance(__service.flngKey, __vTitle, __vFirst, __vLast, branch, "Manual", AppConstants.Who, __cts.Token);
            if (__toast.IsSuccess)
            {
                __visitOpen = false;
                await RefreshAttendanceAsync();
            }
        }
        finally { __visitBusy = false; }
    }

    private async Task RemoveVisitingAsync(VisitingAttendanceModel visit)
    {
        __toast = await VisitingRepo.DeleteVisitingAttendance(visit.flngKey, AppConstants.Who, __cts.Token);
        if (__toast.IsSuccess) await RefreshAttendanceAsync();
    }

    #endregion
}
