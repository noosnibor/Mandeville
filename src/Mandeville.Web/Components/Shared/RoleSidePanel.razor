@implements IDisposable
@using System.Security.Claims
@using global::Mandeville.Web.Dashboards
@inject RoleStatsService Stats

@* Summary panel for the page's role,  *@
<div class="side-stack">
    @if (__loading)
    {
        <div class="side-card"><p class="hint">Loading...</p></div>
    }
    else if (__data is not null)
    {
        <div class="side-card @(Data is not null || Kind.StartsWith("visit") || Kind.StartsWith("connect") || Kind == "incoming" ? "plain" : "")">
            <h3><span class="h2-ico"><Icon Name="@(Kind == "care" || Data is not null ? "heart" : Kind.StartsWith("visit") || Kind.StartsWith("connect") || Kind == "incoming" ? "users" : "layers")" Size="22" Stroke="1.6" /></span>@__data.Title summary</h3>
            <div class="side-tiles">
                @{
                    var tileIcons = Kind switch
                    {
                        "visit-add" => new[] { "check", "clock", "church", "users" },
                        "visit-return" => new[] { "refresh", "users", "heart", "clock" },
                        "visit-thank" => new[] { "clock", "check", "phone", "users" },
                        _ => new[] { "users", "clock", "check", "gift" }
                    };
                    var i = 0;
                }
                @foreach (var t in __data.Tiles)
                {
                    <div class="side-tile t@(i % 4) @(t.Warn ? "warn" : "")"><span class="st-ico"><Icon Name="@tileIcons[i % 4]" Size="20" Stroke="1.5" /></span><span class="st-text"><b>@t.Value</b><small>@t.Label</small></span></div>
                    i++;
                }
            </div>

            @if (__data.Highlight is not null)
            {
                <div class="side-strip"><span class="st-ico"><Icon Name="userplus" Size="20" Stroke="1.5" /></span><span class="st-text"><b>@__data.Highlight.Value</b><small>@__data.Highlight.Label</small></span></div>
            }

            @foreach (var b in __data.Bars.Where(b => b.Total > 0))
            {
                <div class="side-bar-row"><span>@b.Label</span><span>@b.Done of @b.Total</span></div>
                <div class="side-bar"><i style="width:@(Math.Min(100, b.Done * 100 / b.Total))%"></i></div>
            }
        </div>

        @if (__data.PerService.Count > 0)
        {
        <div class="side-card">
            <h3><span class="h2-ico"><Icon Name="church" Size="22" Stroke="1.6" /></span>@__data.PerServiceTitle</h3>
            @foreach (var s in __data.PerService)
            {
                <div class="side-li"><span>@s.Label<small class="side-sub">@s.Male male &middot; @s.Female female</small></span><span class="side-tag">@s.Total</span></div>
            }
            @if (__data.PerServiceTotal is { } sum)
            {
                <div class="side-li"><span><b>@sum.Label</b><small class="side-sub">@sum.Male male &middot; @sum.Female female</small></span><span class="side-tag">@sum.Total</span></div>
            }
        </div>
        }

        @if (Data is null || __data.Attention.Count > 0)
        {
        <div class="side-card">
            <h3><span class="h2-ico"><Icon Name="bell" Size="22" Stroke="1.6" /></span>Needs Attention</h3>
            @if (__data.Attention.Count == 0)
            {
                <p class="hint" style="margin:0">Nothing waiting. Well done.</p>
            }
            @foreach (var a in __data.Attention)
            {
                <div class="side-li"><span>@a.Text</span><span class="side-tag @(a.Warn ? "warn" : "")">@a.Tag</span></div>
            }
        </div>
        }
    }
</div>

@code {
    #region Private Fields

    private readonly CancellationTokenSource __cts = new();
    private RolePanelData? __data;
    private bool __loading = true;
    private string? __loadedKind;

    #endregion

    #region Parameters

    /// <summary>Which role summary to show: "care", "connect" or "pastoral".</summary>
    [Parameter, EditorRequired] public string Kind { get; set; } = "care";

    /// <summary>For the visitor summary: the service being viewed ("yyyy-MM-dd"); blank or "all" means the current service.</summary>
    [Parameter] public string? ServiceDate { get; set; }

    /// <summary>For the team summary: the team member whose list is on screen.</summary>
    [Parameter] public Guid? MemberKey { get; set; }

    /// <summary>Figures worked out by the page itself (for example one summary per tab). When set, nothing is loaded for Kind.</summary>
    [Parameter] public RolePanelData? Data { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    #endregion

    #region Lifecycle

    protected override async Task OnParametersSetAsync()
    {
        // The page supplied its own figures: show them, and 
        if (Data is not null)
        {
            __data = Data;
            __loading = false;
            return;
        }

        // The Visitors page changes Kind when the tab changes, so the numbers are loaded again for the new tab.
        if (__loadedKind == Kind) return;
        __loadedKind = Kind;
        __loading = true;
        try
        {
            var user = AuthState is null ? null : (await AuthState).User;
            Guid? myKey = Guid.TryParse(user?.FindFirstValue(AppClaims.MemberKey), out var k) ? k : null;

            __data = Kind switch
            {
                "connect" => await Stats.GetConnectionsAsync(__cts.Token),
                "connect-lead" => await Stats.GetConnectLeadAsync(DateTime.TryParse(ServiceDate, out var cd) ? cd.Date : null, __cts.Token),
                "incoming" => await Stats.GetIncomingAsync(__cts.Token),
                "connect-team" => await Stats.GetConnectTeamAsync(MemberKey, __cts.Token),
                "visit-add" => await Stats.GetVisitorAddAsync(DateTime.TryParse(ServiceDate, out var sd) ? sd.Date : null, __cts.Token),
                "visit-return" => await Stats.GetVisitorReturningAsync(__cts.Token),
                "visit-thank" => await Stats.GetVisitorThankAsync(__cts.Token),
                // A role limited to "own records only" sees just its own caseload
                "pastoral" => await Stats.GetPastoralAsync(user is not null && user.OwnOnly(PageKeys.Pastoral) ? myKey : null, __cts.Token),
                _ => await Stats.GetMembersCareAsync(__cts.Token)
            };

        }
        catch (OperationCanceledException) { }
        catch { __data = null; }
        finally { __loading = false; }
    }

    public void Dispose() { __cts.Cancel(); __cts.Dispose(); }

    #endregion
}
