@* Page banner: soft blue gradient card with an icon chip on the left, a title and a subtitle. *@
<div class="pbanner">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <div class="pbanner-icon"><Icon Name="@Icon" Size="26" Stroke="1.5" /></div>
    }
    <div class="pbanner-text">
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Subtitle)) { <p>@Subtitle</p> }
    </div>
</div>

@code {
    #region Parameters

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Name of an icon known to <see cref="Icon"/>.</summary>
    [Parameter] public string? Icon { get; set; }

    #endregion
}
