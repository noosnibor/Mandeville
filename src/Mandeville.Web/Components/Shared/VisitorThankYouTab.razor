@implements IDisposable
@inject IServiceRepository ServiceRepo
@inject IVisitorRepository VisitorRepo
@inject IVisitorAttendanceRepository AttendanceRepo
@inject IVisitorNoteRepository NoteRepo
@inject IMessageTemplateRepository TemplateRepo

<ToastBar Toast="__toast" />

<div class="card">
    <h2><span class="h2-ico"><Icon Name="mail" Size="22" Stroke="1.6" /></span>Thank You Messages</h2>
    <p class="hint ty-sub">Pick the service, check the messages, then tap WhatsApp beside each visitor. WhatsApp opens with the message ready to send.</p>

    <div class="form-grid">
        <div class="field icon-field">
            <label>Service the visitors attended</label>
            <span class="if-wrap"><Icon Name="calendar" Size="18" Stroke="1.5" />
            <select @onchange="OnServiceChanged">
                @foreach (var s in __past)
                {
                    <option value="@s.flngKey" selected="@(s.flngKey == __serviceKey)">@s.fstrServiceName - @s.fdtmServiceDate.ToString("dd MMM yyyy")</option>
                }
            </select></span>
        </div>
        <div class="field icon-field">
            <label>Invite them to</label>
            <span class="if-wrap"><Icon Name="church" Size="18" Stroke="1.5" /><input type="text" readonly value="@(__next is null ? "No upcoming service found" : NextText())" /></span>
        </div>
        <div class="field icon-field"><label>Your name (signature)</label><span class="if-wrap"><Icon Name="user" Size="18" Stroke="1.5" /><input type="text" maxlength="80" @bind="__yourName" /></span></div>
    </div>
    @if (__next is null)
    {
        <p class="hint">No later service has been added, so the invitation line is left out. Add the next service on the Services page.</p>
    }
</div>

<div class="card">
    <h2><span class="h2-ico"><Icon Name="edit" Size="20" Stroke="1.6" /></span>Messages</h2>
    <p class="hint" style="margin-top:0">Use {name}, {date}, {next} and {sender}; they are filled in for each visitor.</p>
    <div class="field"><label>First visit</label><textarea rows="5" maxlength="@MessageTemplateCodes.MaxLength" @bind="__firstTemplate" @bind:event="oninput"></textarea></div>
    <div class="field"><label>Returning (2nd visit)</label><textarea rows="5" maxlength="@MessageTemplateCodes.MaxLength" @bind="__returnTemplate" @bind:event="oninput"></textarea></div>
    <div class="field"><label>Returning (3rd visit onward, invites to membership class or a cell group)</label><textarea rows="6" maxlength="@MessageTemplateCodes.MaxLength" @bind="__thirdTemplate" @bind:event="oninput"></textarea></div>
    <div class="ty-save">
        <button class="btn btn-primary btn-sm" disabled="@(__saving || !TemplatesChanged)" @onclick="SaveTemplatesAsync">Save messages</button>
        <button class="btn btn-sm" disabled="@(__saving || !DiffersFromStandard)" @onclick="ResetTemplates">Reset to standard wording</button>
        @if (TemplatesChanged) { <span class="hint">Unsaved changes</span> }
    </div>
    @if (__savedOn is not null)
    {
        <p class="hint" style="margin:.7rem 0 0">Last saved by @__savedBy, @__savedOn.Value.ToString("d MMM HH:mm"). Everyone who sends thank-yous uses these messages.</p>
    }
</div>

<div class="card">
    <h2><span class="h2-ico"><Icon Name="eye" Size="20" Stroke="1.6" /></span>Message Preview</h2>
    <p class="hint ty-sub">This is how the message looks on WhatsApp for the first visitor in the list.</p>
    @if (__rows.Count == 0)
    {
        <p class="empty">Nothing to preview yet.</p>
    }
    else
    {
        <div class="wa-bubble">@BuildMessage(__rows[0])<span class="wa-time">@AppClock.Today.ToString("h:mm tt")</span></div>
    }
</div>

<div class="card">
    <h2><span class="h2-ico"><Icon Name="users" Size="20" Stroke="1.6" /></span>Visitors <span>@__rows.Count at this service</span></h2>
    @if (__loading)
    {
        <p class="hint">Loading...</p>
    }
    else if (__rows.Count == 0)
    {
        <p class="empty">No visitors were recorded for this service.</p>
    }
    else
    {
        <div class="mtable-wrap flat"><table class="mtable ty-table">
            <thead><tr><th>Name</th><th>Phone</th><th>Status</th><th>Thank-you</th><th></th></tr></thead>
            <tbody>
                @foreach (var r in __rows)
                {
                    <tr>
                        <td class="who"><span class="av" style="background:@AvatarStyle.Colour(r.Visitor.flngKey)">@AvatarStyle.Initials(r.Visitor.fstrFirstname, r.Visitor.fstrLastname)</span><span class="who-text"><b>@r.Visitor.FullName</b></span></td>
                        <td data-label="Phone">@(string.IsNullOrWhiteSpace(r.Visitor.fstrPhoneNumber) ? "-" : r.Visitor.fstrPhoneNumber)</td>
                        <td data-label="Status"><span class="chip @(r.Visits <= 1 ? "g" : "v")">@VisitLabel(r.Visits)</span></td>
                        <td data-label="Thank-you">
                            @if (r.Pending)
                            {
                                <span class="ty-ask">
                                    <span class="ty-ask-q">Did it send?</span>
                                    <span class="ty-ask-btns">
                                        <button type="button" class="ty-yes" @onclick="() => ConfirmSentAsync(r)">Yes, sent</button>
                                        <button type="button" class="ty-no" @onclick="() => MarkFailedAsync(r)">Didn't send</button>
                                    </span>
                                </span>
                            }
                            else if (r.FailedOn.HasValue)
                            {
                                <span class="ty-bad">&#10005; Not sent - call instead</span>
                                <small class="ty-by">Marked @r.FailedOn.Value.ToString("dd MMM") by @r.FailedBy</small>
                            }
                            else if (r.ThankedOn.HasValue) { <span class="ty-ok" title="Thanked @r.ThankedOn.Value.ToString("dd MMM")">&#10003; @r.ThankedBy</span> }
                            else { <text>-</text> }
                        </td>
                        <td>
                            @if (r.Link is null)
                            {
                                <span class="btn-wa off"><Icon Name="message" Size="16" />Can't send</span>
                            }
                            else
                            {
                                <a class="btn-wa @(r.Pending ? "ghost" : "")" href="@r.Link" target="_blank" rel="noopener" @onclick="() => r.Pending = true"><Icon Name="message" Size="16" />@(r.Pending ? "Open again" : r.FailedOn.HasValue ? "Try again" : r.ThankedOn.HasValue ? "Send again" : "WhatsApp")</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table></div>
    }
</div>

@code {
    #region Private Fields

    private readonly CancellationTokenSource __cts = new();

    /// <summary>Raised after a thank-you is logged so the page summary can refresh.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }
    private ToastMessageModel? __toast;
    private List<ServiceModel> __past = [], __all = [];
    private ServiceModel? __next;
    private Guid __serviceKey;
    private bool __loading;
    private List<Row> __rows = [];
    private string __yourName = AppConstants.Who;

        private const string Team = "Members Care Team, WAFIF Mandeville";
    private const string Behalf = "on behalf of our Apostle, Dr. Courtney McLean, First Lady Reverend Nadine McLean, and our campus pastors, Pastors Christopher Samuels and Nickiann Samuels";

    private string __firstTemplate = $"Hello {{name}}, {Behalf}, we thank you for coming and worshipping with us on {{date}}. We were truly blessed to have you. We would love to see you again.{{next}} Please join us, and feel free to bring someone with you. God bless you.\n{{sender}}, {Team}";
    private string __returnTemplate = $"Hello {{name}}, it was so good to see you again on {{date}}! {char.ToUpper(Behalf[0])}{Behalf[1..]}, thank you for worshipping with us again. We are glad you are growing with us.{{next}} If there is anything we can pray about with you, or if you would like to know more about becoming part of the church family, just reply to this message. God bless you.\n{{sender}}, {Team}";
    private string __thirdTemplate = $"Hello {{name}}, it was so good to see you again on {{date}}! {char.ToUpper(Behalf[0])}{Behalf[1..]}, thank you for worshipping with us again. We are glad you are growing with us.{{next}} We would love to invite you to our membership class, or to join a cell group, so you can connect more closely with the church family. Just reply to this message and we will share the details. God bless you.\n{{sender}}, {Team}";

    // What the boxes held when they were last loaded or saved, and the built-in wording to go back to
    private string __savedFirst = string.Empty, __savedReturn = string.Empty, __savedThird = string.Empty;
    private string __standardFirst = string.Empty, __standardReturn = string.Empty, __standardThird = string.Empty;
    private string? __savedBy;
    private DateTime? __savedOn;
    private bool __saving;

    private sealed class Row
    {
        public VisitorModel Visitor { get; set; } = new();
        public int Visits { get; set; }
        public string? Link { get; set; }
        public DateTime? ThankedOn { get; set; }
        public string? ThankedBy { get; set; }
        /// <summary>WhatsApp was opened and we are waiting to hear whether the message went out.</summary>
        public bool Pending { get; set; }
        public DateTime? FailedOn { get; set; }
        public string? FailedBy { get; set; }
    }

    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadTemplatesAsync();
            __all = (await ServiceRepo.SelectService(cancellationToken: __cts.Token)).OrderBy(s => s.fdtmServiceDate).ToList();
            __past = __all.Where(s => s.fdtmServiceDate.Date <= AppClock.Today).OrderByDescending(s => s.fdtmServiceDate).ToList();
            if (__past.Count > 0)
            {
                __serviceKey = __past[0].flngKey;
                await LoadAsync();
            }
        }
        catch (OperationCanceledException) { }
    }

    public void Dispose() { __cts.Cancel(); __cts.Dispose(); }

    #endregion

    #region Saved messages

    /// <summary>True when the boxes hold wording that has not been saved yet.</summary>
    private bool TemplatesChanged => __firstTemplate != __savedFirst || __returnTemplate != __savedReturn || __thirdTemplate != __savedThird;

    /// <summary>True when the boxes are not the built-in wording.</summary>
    private bool DiffersFromStandard => __firstTemplate != __standardFirst || __returnTemplate != __standardReturn || __thirdTemplate != __standardThird;

    /// <summary>Remembers the built-in wording, then replaces it with whatever was saved before (if anything).</summary>
    private async Task LoadTemplatesAsync()
    {
        __standardFirst = __firstTemplate;
        __standardReturn = __returnTemplate;
        __standardThird = __thirdTemplate;

        try
        {
            var saved = await TemplateRepo.SelectMessageTemplate(cancellationToken: __cts.Token);
            string Pick(string code, string fallback) => saved.FirstOrDefault(t => t.fstrCode == code)?.fstrText ?? fallback;

            __firstTemplate = Pick(MessageTemplateCodes.ThankFirst, __firstTemplate);
            __returnTemplate = Pick(MessageTemplateCodes.ThankSecond, __returnTemplate);
            __thirdTemplate = Pick(MessageTemplateCodes.ThankThird, __thirdTemplate);

            var latest = saved.OrderByDescending(t => t.fdtmWhen).FirstOrDefault();
            __savedBy = latest?.fstrWho;
            __savedOn = latest?.fdtmWhen;
        }
        catch (OperationCanceledException) { throw; }
        catch { /* the built-in wording is used when the saved messages cannot be read */ }

        RememberSaved();
    }

    private void RememberSaved()
    {
        __savedFirst = __firstTemplate;
        __savedReturn = __returnTemplate;
        __savedThird = __thirdTemplate;
    }

    private async Task SaveTemplatesAsync()
    {
        if (__saving) return;

        if (string.IsNullOrWhiteSpace(__firstTemplate) || string.IsNullOrWhiteSpace(__returnTemplate) || string.IsNullOrWhiteSpace(__thirdTemplate))
        {
            __toast = new() { ToastType = ToastTypeModel.Warning, Message = "Each message needs some text before it can be saved" };
            return;
        }

        __saving = true;
        try
        {
            var who = AppConstants.Who;
            __toast = await TemplateRepo.SaveMessageTemplates(
            [
                new() { fstrCode = MessageTemplateCodes.ThankFirst, fstrText = __firstTemplate.Trim() },
                new() { fstrCode = MessageTemplateCodes.ThankSecond, fstrText = __returnTemplate.Trim() },
                new() { fstrCode = MessageTemplateCodes.ThankThird, fstrText = __thirdTemplate.Trim() }
            ], who, __cts.Token);

            if (__toast.IsSuccess)
            {
                __firstTemplate = __firstTemplate.Trim();
                __returnTemplate = __returnTemplate.Trim();
                __thirdTemplate = __thirdTemplate.Trim();
                RememberSaved();
                __savedBy = who;
                __savedOn = AppClock.Now;
            }
        }
        catch (OperationCanceledException) { }
        finally { __saving = false; }
    }

    /// <summary>Puts the built-in wording back in the boxes. It is only saved when Save messages is pressed.</summary>
    private void ResetTemplates()
    {
        __firstTemplate = __standardFirst;
        __returnTemplate = __standardReturn;
        __thirdTemplate = __standardThird;
    }

    #endregion

    #region Loading

    private async Task OnServiceChanged(ChangeEventArgs e)
    {
        if (Guid.TryParse(e.Value?.ToString(), out var key)) { __serviceKey = key; await LoadAsync(); }
    }

    private async Task LoadAsync()
    {
        __loading = true;
        __rows = [];
        try
        {
            var service = __past.First(s => s.flngKey == __serviceKey);
            var date = service.fdtmServiceDate.Date;

            // Next upcoming service: the first one after the chosen service that has not happened yet
            __next = __all.Where(s => s.fdtmServiceDate.Date > date && s.fdtmServiceDate.Date >= AppClock.Today)
                          .OrderBy(s => s.fdtmServiceDate).FirstOrDefault();

            var attended = await AttendanceRepo.SelectVisitorAttendance(serviceDate: date, cancellationToken: __cts.Token);
            var every = await AttendanceRepo.SelectVisitorAttendance(cancellationToken: __cts.Token);
            var visitors = (await VisitorRepo.SelectVisitor(cancellationToken: __cts.Token)).ToDictionary(v => v.flngKey);

            foreach (var a in attended)
            {
                if (!visitors.TryGetValue(a.flngVisitorKey, out var v)) continue;
                var row = new Row { Visitor = v, Visits = every.Count(x => x.flngVisitorKey == v.flngKey && x.fdtmServiceDate.Date <= date) };

                // A thank-you note for this service means they were already messaged
                var notes = await NoteRepo.SelectVisitorNote(visitorKey: v.flngKey, cancellationToken: __cts.Token);
                // The newest note decides: a later "not sent" replaces an earlier "sent", and a later send replaces a failure
                var latest = ThankYouNotes.Latest(notes, date);
                if (latest is not null && ThankYouNotes.IsFailedFor(latest.fstrNote, date)) { row.FailedOn = latest.fdtmNoteDate; row.FailedBy = latest.fstrWho; }
                else if (latest is not null) { row.ThankedOn = latest.fdtmNoteDate; row.ThankedBy = latest.fstrWho; }
                __rows.Add(row);
            }
            __rows = __rows.OrderBy(r => r.Visitor.fstrFirstname).ToList();
        }
        catch (OperationCanceledException) { }
        finally { __loading = false; }
    }

    #endregion

    #region Message building

    private string NextText() => __next is null ? "" :
        $"{__next.fstrServiceName} is, {__next.fdtmServiceDate:MMMM dd}" +
        (__next.ftimStartTime.HasValue ? $" at {DateTime.Today.Add(__next.ftimStartTime.Value):h:mm tt}" : "") +
        (string.IsNullOrWhiteSpace(__next.fstrLocation) ? "" : $", {__next.fstrLocation}");

    private string BuildMessage(Row r)
    {
        var template = r.Visits <= 1 ? __firstTemplate : r.Visits == 2 ? __returnTemplate : __thirdTemplate;
        var date = __past.First(s => s.flngKey == __serviceKey).fdtmServiceDate;
        var next = __next is null ? "" : $"{NextText()}";
        return template.Replace("{name}", r.Visitor.fstrFirstname).Replace("{date}", date.ToString("MMMM dd"))
                       .Replace("{next}", next).Replace("{sender}", __yourName);
    }

    private static string VisitLabel(int visits) => visits <= 1 ? "First visit" : $"Returning ({Ordinal(visits)} visit)";

    private static string Ordinal(int n) => n % 100 is 11 or 12 or 13 ? $"{n}th" : (n % 10) switch { 1 => $"{n}st", 2 => $"{n}nd", 3 => $"{n}rd", _ => $"{n}th" };

    /// <summary>Turns a local Jamaican number (876 555 0101) into the international form WhatsApp needs.</summary>
    private static string? Normalise(string? phone)
    {
        var d = new string((phone ?? "").Where(char.IsDigit).ToArray());
        if (d.StartsWith("00")) d = d[2..];
        if (d.Length == 7) return "1876" + d;
        if (d.Length == 10) return "1" + d;
        return d.Length >= 11 ? d : null;
    }

    #endregion

    #region Sending

    // Builds the links just before rendering so edits to the messages are always used
    protected override bool ShouldRender() { foreach (var r in __rows) { var n = Normalise(r.Visitor.fstrPhoneNumber); r.Link = n is null ? null : $"https://wa.me/{n}?text={Uri.EscapeDataString(BuildMessage(r))}"; } return true; }

    /// <summary>The person confirmed the message went out, so the thank-you is logged now.</summary>
    private async Task ConfirmSentAsync(Row r)
    {
        var date = __past.First(s => s.flngKey == __serviceKey).fdtmServiceDate.Date;
        var note = new VisitorNoteModel
        {
            flngVisitorKey = r.Visitor.flngKey,
            fdtmNoteDate = AppClock.Now,
            fstrNote = ThankYouNotes.Text(date),
            fstrWho = AppConstants.Who
        };
        __toast = await NoteRepo.AddVisitorNote(note, __cts.Token);
        if (__toast.IsSuccess)
        {
            r.Pending = false; r.FailedOn = null; r.FailedBy = null;
            r.ThankedOn = note.fdtmNoteDate; r.ThankedBy = note.fstrWho;
            await OnChanged.InvokeAsync();
        }
    }

    /// <summary>The message did not go out (wrong number, not on WhatsApp...): flag the visitor for a call.</summary>
    private async Task MarkFailedAsync(Row r)
    {
        var date = __past.First(s => s.flngKey == __serviceKey).fdtmServiceDate.Date;
        var note = new VisitorNoteModel
        {
            flngVisitorKey = r.Visitor.flngKey,
            fdtmNoteDate = AppClock.Now,
            fstrNote = ThankYouNotes.FailedText(date),
            fstrWho = AppConstants.Who
        };
        __toast = await NoteRepo.AddVisitorNote(note, __cts.Token);
        if (__toast.IsSuccess)
        {
            r.Pending = false; r.ThankedOn = null; r.ThankedBy = null;
            r.FailedOn = note.fdtmNoteDate; r.FailedBy = note.fstrWho;
            await OnChanged.InvokeAsync();
        }
    }

    #endregion
}
