@implements IDisposable
@inject IVisitorRepository VisitorRepo
@inject IVisitorNoteRepository NoteRepo
@inject IVisitorAttendanceRepository AttendanceRepo
@inject IMemberRepository MemberRepo
@inject IDepartmentRepository DepartmentRepo
@inject IConfiguration Configuration

<ToastBar Toast="__toast" />

<div class="tm-line">
@if (CanPick)
{
    <div class="cl-pickwrap">
        <div class="svc-pick tm">
            <span class="sp-ic"><Icon Name="user" Size="17" Stroke="1.9" /></span>
            <span class="sp-tx"><small>Viewing the list of</small><b>@(__team.FirstOrDefault(m => m.flngKey == __viewKey)?.FullName ?? "Choose a team member")</b></span>
            <span class="sp-ch"><Icon Name="chevron" Size="16" Stroke="2" /></span>
            <select class="cl-pick" aria-label="Team member" @bind="__viewKey" @bind:after="LoadAsync">
                <option value="">-- choose a team member --</option>
                @foreach (var m in __team) { <option value="@m.flngKey">@m.FullName</option> }
            </select>
        </div>
    </div>
    <span class="cl-note"><Icon Name="info" Size="16" Stroke="1.6" />A team member only sees their own list when they sign in.</span>
}
@if (__formUrl is not null)
{
    @* The WAFIF Connection HQ Log button. It opens the Google Form in a new tab. *@
    <a class="cl-formbtn" href="@__formUrl" target="_blank" rel="noopener noreferrer"><Icon Name="note" Size="16" Stroke="1.8" />WAFIF Connection HQ Log<span aria-hidden="true">&nearr;</span></a>
}
</div>

@if (__viewKey is null)
{
    <div class="empty-state">
        <div class="empty-ico"><Icon Name="users" Size="30" Stroke="1.6" /></div>
        <h3>@(CanPick ? "Choose a team member" : "Account not linked")</h3>
        <p>@(CanPick ? "Pick someone above to see who is assigned to them." : "Your account is not linked to a member yet. Ask the administrator.")</p>
    </div>
}
else
{
    <div class="vk">
        <div class="vkc" style="--c:#1c86f2"><div class="vk-h"><span>Assigned</span><span class="vk-i"><Icon Name="users" Size="17" Stroke="1.8" /></span></div><b>@__mine.Count</b><small>To them</small></div>
        <div class="vkc" style="--c:#f59e0b"><div class="vk-h"><span>Follow-ups due</span><span class="vk-i"><Icon Name="bell" Size="17" Stroke="1.8" /></span></div><b>@DueCount()</b><small>Call today</small></div>
        <div class="vkc" style="--c:#10b981"><div class="vk-h"><span>Contacted</span><span class="vk-i"><Icon Name="check" Size="17" Stroke="2" /></span></div><b>@(__mine.Count(v => v.fdtmLastContactDate is { } c && c.Date >= AppClock.Today.AddDays(-6)))</b><small>This week</small></div>
    </div>
    <div class="mgrid">
        @foreach (var p in __mine)
        {
            var person = p;
            var due = person.fdtmNextContactDate is { } d && d.Date <= AppClock.Today;
            <div class="vcard @(due ? "due" : "")">
                <div class="vcard-body">
                    <div class="vcard-head">
                        <div class="ucard-avatar" style="background:@AvatarStyle.Colour(person.flngKey)">@AvatarStyle.Initials(person.fstrFirstname, person.fstrLastname)</div>
                        <div class="ucard-text">
                            <b>@person.FullName</b>
                            <small>@(string.IsNullOrWhiteSpace(person.fstrPhoneNumber) ? "No phone" : person.fstrPhoneNumber)</small>
                        </div>
                        <span class="inc-path @(IsMembership(person) ? "join" : "new")">@(__reasons.GetValueOrDefault(person.flngKey) ?? "Visitor")</span>
                    </div>
                    <div class="vcard-line">
                        <span>Last contact<b>@LastContactText(person, "d MMM")</b></span>
                        <span class="@(due ? "vdue" : "")">Next@(due ? " · due" : "")<b>@(person.fdtmNextContactDate?.ToString("d MMM") ?? "Not set")</b></span>
                    </div>
                </div>
                @if (__pendingTexts.Contains(person.flngKey))
                {
                    @* A message was opened: the contact is only logged when the sender confirms it went out *@
                    <div class="txt-ask" role="status">
                        <b>Did your message to @person.fstrFirstname send?</b>
                        <div class="txt-btns">
                            <button type="button" class="txt-main" disabled="@__saving" @onclick="() => TextSentAsync(person)">Yes, sent</button>
                            <button type="button" class="txt-alt" disabled="@__saving" @onclick="() => TextNotSent(person)">No, not sent</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="vcard-foot has-text">
                        <button class="p" @onclick="() => CalledAsync(person)"><Icon Name="phone" Size="18" Stroke="1.6" />Called</button>
                        <button disabled="@(ContactLinks.Sms(person.fstrPhoneNumber) is null)" @onclick="() => OpenTextAsync(person)"><Icon Name="message" Size="18" Stroke="1.6" />Text</button>
                        <button @onclick="() => OpenAsync(person)"><Icon Name="edit" Size="18" Stroke="1.6" />Update</button>
                        @if (IsMembership(person))
                        {
                            <button class="acc" @onclick="() => AddToIncomingAsync(person)">Add to incoming</button>
                        }
                    </div>
                }
            </div>
        }
    </div>
    @if (__mine.Count == 0)
    {
        <div class="empty-state">
            <div class="empty-ico"><Icon Name="users" Size="30" Stroke="1.6" /></div>
            <h3>Nobody assigned yet</h3>
            <p>Nobody is assigned to this team member yet.</p>
        </div>
    }
}

@* ---------- Text message ---------- *@
@if (__texting is not null)
{
    var t = __texting;
    <Modal Title="@($"Message {t.fstrFirstname}")" Subtitle="@($"{t.fstrPhoneNumber} · you can edit before sending")" Icon="message" CssClass="txt-modal" OnClose="CloseText">
        <textarea class="txt-box" rows="8" maxlength="1000" aria-label="Message" @bind="__textMessage" @bind:event="oninput"></textarea>
        <div class="txt-btns">
            @if (WhatsAppLink(t) is { } wa && !string.IsNullOrWhiteSpace(__textMessage))
            {
                <a class="txt-main" href="@wa" target="_blank" rel="noopener noreferrer" @onclick="() => MessageOpened(t)"><Icon Name="message" Size="17" Stroke="1.8" />WhatsApp</a>
            }
            @if (SmsLink(t) is { } sms && !string.IsNullOrWhiteSpace(__textMessage))
            {
                <a class="txt-alt" href="@sms" @onclick="() => MessageOpened(t)"><Icon Name="message" Size="17" Stroke="1.8" />Text (SMS)</a>
            }
        </div>
        @if (string.IsNullOrWhiteSpace(__textMessage)) { <p class="hint">Write a message to send.</p> }
        <button type="button" class="txt-cancel" @onclick="CloseText">Cancel</button>
    </Modal>
}

@* ---------- Update drawer ---------- *@
@if (__open is not null)
{
    var e = __open;
    <div class="drawer-backdrop" @onclick="Close">
        <aside class="drawer" role="dialog" aria-modal="true" aria-label="Update contact" @onclick:stopPropagation="true">
            <div class="drawer-cover" style="background:@AvatarStyle.Cover(e.flngKey)">
                <button class="drawer-close" aria-label="Close" @onclick="Close">&#10005;</button>
            </div>
            <div class="drawer-top">
                <div class="drawer-avatar" style="background:@AvatarStyle.Colour(e.flngKey)">@AvatarStyle.Initials(e.fstrFirstname, e.fstrLastname)</div>
                <h3>@e.FullName</h3>
                <small>@(string.IsNullOrWhiteSpace(e.fstrPhoneNumber) ? "No phone" : e.fstrPhoneNumber)</small>
            </div>

            <div class="drawer-card">
                <h4><Icon Name="calendar" Size="20" Stroke="1.6" />Contact Dates</h4>
                <div class="ir"><span>Last contact</span><b>@LastContactText(e, "dd MMM yyyy")</b></div>
                <div class="ir"><span>Next contact</span><b>@(e.fdtmNextContactDate?.ToString("dd MMM yyyy") ?? "Not set")</b></div>
                <p class="hint">Press Called after you speak to them, or use Text if you cannot reach them. Either one sets the last contact to today and the next contact to a week later.</p>
            </div>

            <div class="drawer-card">
                <h4><Icon Name="layers" Size="20" Stroke="1.6" />Details</h4>
                <div class="field">
                    <label>Reason for going to the altar</label>
                    <select @bind="__editReason" disabled="@(__reasonVisit is null)">
                        <option value="">Not recorded</option>
                        @foreach (var r in ReasonChoices()) { <option value="@r">@r</option> }
                    </select>
                    @if (__reasonVisit is null) { <small class="hint">No altar visit is recorded for this person yet.</small> }
                </div>
                <div class="field"><label>Birthday (day and month)</label><DayMonthField @bind-Value="e.fdtmDateOfBirth" /></div>
                <div style="margin-top:.6rem"><button class="btn btn-primary btn-sm" @onclick="SaveDetailsAsync">Save</button></div>
            </div>

            <div class="drawer-card">
                <h4><Icon Name="note" Size="20" Stroke="1.6" />Notes for @e.fstrFirstname</h4>
                <div class="vnote-add">
                    <input type="text" maxlength="500" placeholder="Add a note about this contact" @bind="__newNote" @bind:event="oninput" @onkeydown="OnNoteKey" />
                    <button class="btn btn-primary btn-sm" @onclick="AddNoteAsync"><Icon Name="plus" Size="16" />Add</button>
                </div>
                @foreach (var n in __notes)
                {
                    <div class="ir vnote"><span>@n.fdtmNoteDate.ToString("d MMM")</span><b>@n.fstrNote</b></div>
                }
                @if (__notes.Count == 0) { <p class="hint">No notes yet.</p> }
            </div>
        </aside>
    </div>
}

@code {
    #region Private Fields

    /// <summary>The signed-in member whose list this is (a team member), or null for the lead and administrators.</summary>
    [Parameter] public Guid? MemberKey { get; set; }

    /// <summary>True for the lead and administrators, who can look at any team member's list.</summary>
    [Parameter] public bool CanPick { get; set; }

    /// <summary>Raised with the team member whose list is on screen after it loads or changes, so the summary refreshes.</summary>
    [Parameter] public EventCallback<Guid?> OnChanged { get; set; }

    private readonly CancellationTokenSource __cts = new();
    private List<MemberModel> __team = [];
    private List<VisitorModel> __mine = [];
    private Guid? __viewKey;
    private VisitorModel? __open;
    private List<VisitorNoteModel> __notes = [];
    private Dictionary<Guid, string> __reasons = [];
    private VisitorAttendanceModel? __reasonVisit;
    private string __editReason = string.Empty;
    private string? __newNote;
    private ToastMessageModel? __toast;

    // The notes that record how a contact was made
    private const string CallNote = "Called.";
    private const string TextNote = "Texted.";

    /// <summary>Call or Text for each person's latest contact.</summary>
    private Dictionary<Guid, string> __methods = [];

    /// <summary>People whose message was opened and is waiting for "Did it send?".</summary>
    private readonly HashSet<Guid> __pendingTexts = [];
    private VisitorModel? __texting;
    private string __textMessage = string.Empty;
    private bool __saving;

    /// <summary>The Google Form address from the app settings (Church:ConnectionFormUrl); null when it is not set or not a web address.</summary>
    private string? __formUrl;

    #endregion

    protected override async Task OnInitializedAsync()
    {
        var url = Configuration["Church:ConnectionFormUrl"];
        __formUrl = Uri.TryCreate(url?.Trim(), UriKind.Absolute, out var formUri) && formUri.Scheme == Uri.UriSchemeHttps ? formUri.AbsoluteUri : null;

        if (CanPick)
        {
            var departments = await DepartmentRepo.SelectDepartment(active: true, cancellationToken: __cts.Token);
            var teamKey = departments.FirstOrDefault(d => d.fstrName.Contains("connect", StringComparison.OrdinalIgnoreCase))?.flngKey;
            __team = await MemberRepo.SelectMember(membershipStatus: "Active", departmentKey: teamKey, cancellationToken: __cts.Token);
            __viewKey = MemberKey;
        }
        else
        {
            // A team member can only ever see their own list.
            __viewKey = MemberKey;
        }

        await LoadAsync();
    }

    public void Dispose()
    {
        __cts.Cancel();
        __cts.Dispose();
    }

    #region Loading

    /// <summary>The people assigned to this team member (people who became members drop off the list).</summary>
    private int DueCount() => __mine.Count(v => v.fdtmNextContactDate is { } d && d.Date <= AppClock.Today);

    private bool __ready;

    private async Task LoadAsync()
    {
        await LoadListAsync();

        // Tell the page whose list is on screen so the summary follows it (not during the first load)
        if (__ready) await OnChanged.InvokeAsync(__viewKey);
        __ready = true;
    }

    private async Task LoadListAsync()
    {
        if (__viewKey is null)
        {
            __mine = [];
            return;
        }

        var list = await VisitorRepo.SelectVisitor(followUpMemberKey: __viewKey, cancellationToken: __cts.Token);
        // People added to Incoming members (or already members) leave this list: the incoming team follows them from there.
        __mine = list.Where(v => v.fstrStatus is "Visitor" or "Regular Visitor")
                     .OrderBy(v => v.fdtmNextContactDate ?? DateTime.MaxValue)
                     .ThenBy(v => v.fstrLastname).ToList();

        // The latest altar reason for each person (Member is the old name of Membership).
        __reasons = [];
        __methods = [];
        foreach (var v in __mine)
        {
            await LoadMethodAsync(v);

            var visits = await AttendanceRepo.SelectVisitorAttendance(visitorKey: v.flngKey, cancellationToken: __cts.Token);
            var reason = visits.Where(a => !string.IsNullOrWhiteSpace(a.fstrAltarReason))
                               .OrderByDescending(a => a.fdtmServiceDate).Select(a => a.fstrAltarReason).FirstOrDefault();
            if (reason is not null) __reasons[v.flngKey] = FixedLists.IsMembershipReason(reason) ? "Membership" : reason;
            else if (!string.IsNullOrWhiteSpace(v.fstrReferralReason)) __reasons[v.flngKey] = FixedLists.IsMembershipReason(v.fstrReferralReason) ? "Membership" : v.fstrReferralReason; // referred by Member care
        }
    }

    #endregion

    #region Add to incoming

    /// <summary>True when the person came to the altar for membership, so the team member can add them to Incoming members.</summary>
    private bool IsMembership(VisitorModel v) => __reasons.GetValueOrDefault(v.flngKey) == "Membership";

    /// <summary>After the call confirms they want to join, moves the person to Incoming members and off this list.</summary>
    private async Task AddToIncomingAsync(VisitorModel v)
    {
        if (!Owns(v) || !IsMembership(v)) return;

        v.fstrStatus = "Incoming Member";
        if (string.IsNullOrWhiteSpace(v.fstrPath)) v.fstrPath = "Joining the church";
        v.fstrWho = AppConstants.Who;

        __toast = await VisitorRepo.AddOrUpdateVisitor(v, false, __cts.Token);
        if (!__toast.IsSuccess) return;

        await NoteRepo.AddVisitorNote(new VisitorNoteModel
        {
            flngVisitorKey = v.flngKey,
            fdtmNoteDate = AppClock.Today,
            fstrNote = "Confirmed they want to join. Added to Incoming members.",
            fstrWho = AppConstants.Who
        }, __cts.Token);

        __toast = new() { ToastType = ToastTypeModel.Success, Message = $"{v.FullName} was added to Incoming members and removed from your list" };
        __open = null;
        await LoadAsync();
    }

    #endregion

    #region Called

    /// <summary>Logs a call for today.</summary>
    private async Task CalledAsync(VisitorModel v)
    {
        if (await LogContactAsync(v, CallNote, "Called")) __pendingTexts.Remove(v.flngKey);
    }

    /// <summary>Logs a contact for today: last contact is today, next contact is a week later, and a note records how.</summary>
    private async Task<bool> LogContactAsync(VisitorModel v, string noteText, string done)
    {
        if (__saving || !Owns(v)) return false;

        __saving = true;
        try
        {
            var previousLast = v.fdtmLastContactDate;
            var previousNext = v.fdtmNextContactDate;
            v.fdtmLastContactDate = AppClock.Today;
            v.fdtmNextContactDate = AppClock.Today.AddDays(7);
            v.fstrWho = AppConstants.Who;

            __toast = await VisitorRepo.AddOrUpdateVisitor(v, false, __cts.Token);
            if (!__toast.IsSuccess)
            {
                // Nothing was saved, so the card keeps showing the old dates
                v.fdtmLastContactDate = previousLast;
                v.fdtmNextContactDate = previousNext;
                return false;
            }

            var noted = await NoteRepo.AddVisitorNote(new VisitorNoteModel
            {
                flngVisitorKey = v.flngKey,
                fdtmNoteDate = AppClock.Today,
                fstrNote = noteText,
                fstrWho = AppConstants.Who
            }, __cts.Token);

            __toast = noted.IsSuccess
                ? new() { ToastType = ToastTypeModel.Success, Message = $"{done}. Next contact with {v.fstrFirstname} is {v.fdtmNextContactDate:d MMM}" }
                : new() { ToastType = ToastTypeModel.Warning, Message = "The contact dates were saved, but the note was not" };
            await LoadAsync();
            return true;
        }
        finally { __saving = false; }
    }

    /// <summary>A team member may only change people on their own list.</summary>
    private bool Owns(VisitorModel v) => v.flngFollowUpMemberKey is not null && v.flngFollowUpMemberKey == __viewKey && (CanPick || __viewKey == MemberKey);

    #endregion

    #region Text message

    /// <summary>Opens the message box with a ready-written message for a person who could not be reached by phone.</summary>
    private async Task OpenTextAsync(VisitorModel v)
    {
        if (!Owns(v)) return;

        var visits = await AttendanceRepo.SelectVisitorAttendance(visitorKey: v.flngKey, cancellationToken: __cts.Token);
        var lastVisit = visits.OrderByDescending(a => a.fdtmServiceDate).FirstOrDefault();

        __textMessage = BuildTextMessage(v, await SenderNameAsync(), lastVisit?.fdtmServiceDate);
        __texting = v;
    }

    /// <summary>The first name of the person signed in; their sign-in name when no member is linked to the account.</summary>
    private async Task<string> SenderNameAsync()
    {
        if (MemberKey is not null)
        {
            var me = (await MemberRepo.SelectMember(key: MemberKey, cancellationToken: __cts.Token)).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(me?.fstrFirstname)) return TidyName(me.fstrFirstname);
        }

        return TidyName(AppConstants.Who);
    }

    /// <summary>Turns a name stored in capitals (MIGUEL) into normal writing (Miguel); other names are left as typed.</summary>
    private static string TidyName(string name)
    {
        var trimmed = name.Trim();
        return trimmed.Any(char.IsLower) ? trimmed : System.Globalization.CultureInfo.InvariantCulture.TextInfo.ToTitleCase(trimmed.ToLowerInvariant());
    }

    private string BuildTextMessage(VisitorModel v, string sender, DateTime? visit)
    {
        var church = Configuration["Church:GroupName"] ?? "WAFIF Mandeville";
        var glad = visit is null
            ? "We were glad to have you with us."
            : $"We were glad to have you with us on {visit.Value.ToString("MMMM d", System.Globalization.CultureInfo.InvariantCulture)}.";

        return $"Hello {TidyName(v.fstrFirstname)}, this is {sender} from {church}. I tried calling but couldn't reach you. {glad} " +
               "Is there anything we can pray with you about? Please reply, or let me know a good time to call. God bless you.";
    }

    private string? WhatsAppLink(VisitorModel v) =>
        ContactLinks.WhatsApp(v.fstrPhoneNumber) is { } url ? $"{url}?text={Uri.EscapeDataString(__textMessage)}" : null;

    private string? SmsLink(VisitorModel v) =>
        ContactLinks.Sms(v.fstrPhoneNumber) is { } url ? $"{url}?body={Uri.EscapeDataString(__textMessage)}" : null;

    /// <summary>WhatsApp or the text app was opened: close the box and ask on the card whether it was sent.</summary>
    private void MessageOpened(VisitorModel v)
    {
        __pendingTexts.Add(v.flngKey);
        CloseText();
    }

    private void CloseText() => __texting = null;

    /// <summary>The sender confirmed the message went out, so it counts as today's contact.</summary>
    private async Task TextSentAsync(VisitorModel v)
    {
        if (await LogContactAsync(v, TextNote, "Text sent")) __pendingTexts.Remove(v.flngKey);
    }

    /// <summary>The message did not go out: nothing is saved, so a follow-up that is due stays due.</summary>
    private void TextNotSent(VisitorModel v) => __pendingTexts.Remove(v.flngKey);

    #endregion

    #region Last contact

    /// <summary>Finds whether the latest contact was a call or a text, from the note saved with it.</summary>
    private async Task LoadMethodAsync(VisitorModel v)
    {
        if (v.fdtmLastContactDate is not { } last) return;

        var notes = await NoteRepo.SelectVisitorNote(visitorKey: v.flngKey, cancellationToken: __cts.Token);
        var latest = notes.Where(n => n.fdtmNoteDate.Date == last.Date && n.fstrNote is CallNote or TextNote)
                          .OrderByDescending(n => n.fdtmWhen)
                          .FirstOrDefault();

        if (latest is not null) __methods[v.flngKey] = latest.fstrNote == TextNote ? "Text" : "Call";
    }

    /// <summary>The last contact date, followed by how it was made when that is known.</summary>
    private string LastContactText(VisitorModel v, string format)
    {
        if (v.fdtmLastContactDate is not { } last) return "Not yet";
        var date = last.ToString(format);
        return __methods.TryGetValue(v.flngKey, out var how) ? $"{date} · {how}" : date;
    }

    #endregion

    #region Update drawer

    private async Task OpenAsync(VisitorModel v)
    {
        __open = v;
        __newNote = null;
        await LoadNotesAsync();

        // The visit the altar reason belongs to: the latest one with a reason, otherwise the latest visit
        var visits = await AttendanceRepo.SelectVisitorAttendance(visitorKey: v.flngKey, cancellationToken: __cts.Token);
        __reasonVisit = visits.Where(a => !string.IsNullOrWhiteSpace(a.fstrAltarReason)).OrderByDescending(a => a.fdtmServiceDate).FirstOrDefault()
                        ?? visits.OrderByDescending(a => a.fdtmServiceDate).FirstOrDefault();
        __editReason = __reasonVisit?.fstrAltarReason ?? string.Empty;
    }

    private void Close() => __open = null;

    private async Task LoadNotesAsync()
    {
        if (__open is null) return;
        __notes = await NoteRepo.SelectVisitorNote(visitorKey: __open.flngKey, cancellationToken: __cts.Token);
    }

    private async Task SaveDetailsAsync()
    {
        if (__open is null || !Owns(__open)) return;
        __open.fstrWho = AppConstants.Who;
        __toast = await VisitorRepo.AddOrUpdateVisitor(__open, false, __cts.Token);
        if (!__toast.IsSuccess) return;

        // Save a changed altar reason on the visit it belongs to
        if (__reasonVisit is not null && (__reasonVisit.fstrAltarReason ?? string.Empty) != __editReason)
        {
            __reasonVisit.fstrAltarReason = string.IsNullOrWhiteSpace(__editReason) ? null : __editReason;
            __reasonVisit.fstrWho = AppConstants.Who;
            __toast = await AttendanceRepo.AddOrUpdateVisitorAttendance(__reasonVisit, false, __cts.Token);
            if (!__toast.IsSuccess) return;

            // Show the new reason on the card (and the Add to Incoming members button when it is membership)
            if (__reasonVisit.fstrAltarReason is null) __reasons.Remove(__open.flngKey);
            else __reasons[__open.flngKey] = FixedLists.IsMembershipReason(__reasonVisit.fstrAltarReason) ? "Membership" : __reasonVisit.fstrAltarReason;
        }
    }

    /// <summary>The altar reasons to pick from, plus the current one when it is an old value no longer in the list.</summary>
    private IEnumerable<string> ReasonChoices() =>
        string.IsNullOrWhiteSpace(__reasonVisit?.fstrAltarReason) || FixedLists.AltarReasons.Contains(__reasonVisit.fstrAltarReason)
            ? FixedLists.AltarReasons
            : FixedLists.AltarReasons.Append(__reasonVisit.fstrAltarReason);

    private async Task OnNoteKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddNoteAsync();
    }

    private async Task AddNoteAsync()
    {
        if (__open is null || !Owns(__open)) return;
        if (string.IsNullOrWhiteSpace(__newNote))
        {
            __toast = new() { ToastType = ToastTypeModel.Warning, Message = "Write a note first" };
            return;
        }

        __toast = await NoteRepo.AddVisitorNote(new VisitorNoteModel
        {
            flngVisitorKey = __open.flngKey,
            fdtmNoteDate = AppClock.Today,
            fstrNote = __newNote.Trim(),
            fstrWho = AppConstants.Who
        }, __cts.Token);

        if (!__toast.IsSuccess) return;
        __newNote = null;
        await LoadNotesAsync();
    }

    #endregion
}
