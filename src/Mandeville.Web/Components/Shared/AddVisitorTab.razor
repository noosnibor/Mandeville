@implements IDisposable
@inject IVisitorRepository VisitorRepo
@inject IVisitorAttendanceRepository AttendanceRepo
@inject IServiceRepository ServiceRepo
@inject IVisitorNoteRepository NoteRepo

<ToastBar Toast="__toast" />

@* ---------- Summary ---------- *@
<div class="vk">
    <div class="vkc" style="--c:#1c86f2"><div class="vk-h"><span>Visitors</span><span class="vk-i"><Icon Name="users" Size="17" Stroke="1.8" /></span></div><b>@__visitors.Count</b><small>@(!string.IsNullOrWhiteSpace(__search) ? "Found" : __viewDate == "all" ? "All time" : "This service")</small></div>
    <div class="vkc" style="--c:#10b981"><div class="vk-h"><span>Here today</span><span class="vk-i"><Icon Name="check" Size="17" Stroke="2" /></span></div><b>@__hereToday</b><small>Checked in</small></div>
    <div class="vkc" style="--c:#f59e0b"><div class="vk-h"><span>Altar calls</span><span class="vk-i"><Icon Name="bell" Size="17" Stroke="1.8" /></span></div><b>@__todayReasons.Count</b><small>Today</small></div>
</div>

@* ---------- Service picker ---------- *@
<div class="svc-line" aria-label="Choose a service">
    <span class="svc-line-label">Service</span>
    <button type="button" class="svc-pick @(__moreOpen ? "open" : "")" aria-expanded="@(__moreOpen ? "true" : "false")" aria-haspopup="dialog" @onclick="() => __moreOpen = !__moreOpen">
        <span class="sp-ic"><Icon Name="calendar" Size="17" Stroke="1.9" /></span>
        <span class="sp-tx"><small>Service</small><b>@PickText()</b></span>
        <span class="sp-ch"><Icon Name="chevron" Size="16" Stroke="2" /></span>
    </button>
    <div class="svc-all" role="group" aria-label="Latest or all services">
        <button type="button" class="@(__viewDate != "all" ? "on" : "")" @onclick="PickLatestAsync">Latest</button>
        <button type="button" class="@(__viewDate == "all" ? "on" : "")" @onclick='() => PickServiceAsync("all")'>All</button>
    </div>

    @if (__moreOpen)
    {
        <div class="svc-more-backdrop" @onclick="() => __moreOpen = false"></div>
        <div class="svc-more" role="dialog" aria-label="All services">
            <label class="svc-more-search"><Icon Name="search" Size="16" Stroke="1.5" /><input type="text" placeholder="Search services..." aria-label="Search services" @bind="__moreSearch" @bind:event="oninput" /></label>
            <div class="svc-more-list">
                @foreach (var month in MoreGroups())
                {
                    <div class="svc-more-month">@month.Key</div>
                    @foreach (var s in month)
                    {
                        var d = s.fdtmServiceDate.ToString("yyyy-MM-dd");
                        <button type="button" class="svc-more-item @(d == __viewDate ? "on" : "")" @onclick="() => PickServiceAsync(d)"><span>@s.fstrServiceName.Replace(" - ", " · ")</span><small>@s.fdtmServiceDate.ToString("dd MMM")</small></button>
                    }
                }
                @if (!MoreGroups().Any()) { <p class="empty" style="margin:.6rem">No services found.</p> }
            </div>
        </div>
    }
</div>

@* ---------- Visitors card: search and filters on top, table below ---------- *@
<div class="vcard card">
    <div class="vtools">
        <label class="vsearch">
            <button type="button" class="vsearch-go" title="Search" aria-label="Search" @onclick="LoadAsync"><Icon Name="search" Size="18" Stroke="1.5" /></button>
            <input class="msearch" type="text" placeholder="Search all visitors by name, phone or email..." aria-label="Search visitors" @bind="__search" @bind:event="oninput" @onkeydown="OnSearchKey" />
        </label>
        <div class="vseg" role="group" aria-label="Age group">
            <button class="@(string.IsNullOrEmpty(__filterAge) ? "on" : "")" @onclick="() => SetAgeAsync(null)">All</button>
            @foreach (var g in FixedLists.AgeGroups)
            {
                var group = g;
                <button class="@(__filterAge == group ? "on" : "")" @onclick="() => SetAgeAsync(group)">@group</button>
            }
        </div>
    </div>

    @if (__visitors.Count > 0)
    {
        <div class="mtable-wrap">
            <table class="mtable vtable">
                <thead>
                    <tr><th>Visitor</th><th>Category</th><th class="c">Visits</th><th class="r">Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var v in PageItems())
                    {
                        <tr @onclick="() => OpenDetailAsync(v)">
                            <td class="who">
                                <span class="av" style="background:@AvatarStyle.Colour(v.flngKey)">@AvatarStyle.Initials(v.fstrFirstname, v.fstrLastname)</span>
                                <span class="who-text">
                                    <b>@v.FullName
                                        @if (__todayReasons.ContainsKey(v.flngKey)) { <span class="inc-path ret">Altar call</span> }
                                        else if (v.fstrStatus != "Visitor") { <span class="inc-path new">@v.fstrStatus</span> }
                                        @if (__noteCounts.TryGetValue(v.flngKey, out var noteCount)) { <span class="note-count" title="Notes"><Icon Name="note" Size="13" Stroke="1.6" />@noteCount</span> }
                                    </b>
                                    <small><Icon Name="phone" Size="13" Stroke="1.6" /> @(string.IsNullOrWhiteSpace(v.fstrPhoneNumber) ? "No phone" : v.fstrPhoneNumber)</small>
                                </span>
                            </td>
                            <td data-label="Category"><span class="chip @CategoryClass(v)">@v.fstrAgeGroup &middot; @v.fstrGender</span></td>
                            <td class="c" data-label="Visits"><span class="count-pill">@v.flngVisitCount</span></td>
                            <td class="act">
                                <button title="Profile" aria-label="Open profile of @v.FullName" @onclick="() => OpenDetailAsync(v)" @onclick:stopPropagation="true"><Icon Name="user" Size="17" Stroke="1.5" /></button>
                                <button title="Edit" aria-label="Edit @v.FullName" @onclick="() => EditVisitorAsync(v)" @onclick:stopPropagation="true"><Icon Name="edit" Size="17" Stroke="1.5" /></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <Pager Page="__page" PageSize="PageSize" Total="__visitors.Count" PageChanged="SetPage" />
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-ico"><Icon Name="userplus" Size="30" Stroke="1.6" /></div>
            @if (string.IsNullOrWhiteSpace(__search))
            {
                <h3>No visitors yet</h3>
                <p>No visitors have been recorded for this service yet.</p>
                <div class="empty-actions"><button type="button" class="empty-btn" @onclick="NewVisitor">Add Visitor</button></div>
            }
            else
            {
                <h3>No visitors found</h3>
                <p>We could not find anyone matching your search. Try a different name, phone number or email.</p>
            }
        </div>
    }
</div>

<button class="fab" @onclick="NewVisitor"><Icon Name="plus" Size="16" />Add Visitor</button>

@* ---------- Details panel ---------- *@
@if (__detail is not null)
{
    var d = __detail;
    <div class="drawer-backdrop" @onclick="CloseDetail">
        <aside class="drawer" role="dialog" aria-modal="true" aria-label="Visitor details" @onclick:stopPropagation="true">
            <div class="drawer-cover" style="background:@(d.fstrStatus == "Member" ? "var(--inactive-cover)" : AvatarStyle.Cover(d.flngKey))">
                <button class="drawer-close" aria-label="Close" @onclick="CloseDetail">&#10005;</button>
            </div>
            <div class="drawer-top">
                <div class="drawer-avatar" style="background:@(d.fstrStatus == "Member" ? "var(--inactive)" : AvatarStyle.Colour(d.flngKey))">@AvatarStyle.Initials(d.fstrFirstname, d.fstrLastname)</div>
                <h3>@d.FullName</h3>
                <small>@(string.IsNullOrWhiteSpace(d.fstrPhoneNumber) ? "No phone" : d.fstrPhoneNumber)</small>
                <div class="drawer-stats">
                    <div><b>@d.flngVisitCount</b><span>Visits</span></div>
                    <div><b>@(d.fdtmLastAttended?.ToString("dd MMM") ?? "-")</b><span>Last attended</span></div>
                </div>
            </div>

            <div class="drawer-card">
                <h4>Contact</h4>
                <div class="ir"><span>Phone</span><b>@(d.fstrPhoneNumber ?? "-")</b></div>
                <div class="ir"><span>Email</span><b>@(d.fstrEmailAddress ?? "-")</b></div>
                <div class="ir"><span>Address</span><b>@(d.fstrAddress ?? "-")</b></div>
            </div>

            <div class="drawer-card">
                <h4>Details</h4>
                <div class="ir"><span>Age group</span><b>@d.fstrAgeGroup</b></div>
                <div class="ir"><span>Gender</span><b>@d.fstrGender</b></div>
                @if (d.fstrStatus != "Visitor")
                {
                    <div class="ir"><span>Status</span><b>@d.fstrStatus</b></div>
                }
                @if (!string.IsNullOrWhiteSpace(d.fstrFollowUpName))
                {
                    <div class="ir"><span>Connected to</span><b>@d.fstrFollowUpName</b></div>
                }
            </div>

            <VisitorContactNotes Visitor="d" OnChanged="NotesChangedAsync" />
            <VisitorReferral Visitor="d" OnChanged="() => OnChanged.InvokeAsync()" />

            <div class="drawer-card">
                <h4>Recent visits</h4>
                @if (__detailVisits.Count == 0)
                {
                    <p class="hint" style="margin:0">No visits recorded yet.</p>
                }
                else
                {
                    foreach (var a in __detailVisits)
                    {
                        <div class="ir"><span>@a.fdtmServiceDate.ToString("dd MMM yyyy")</span><b>@(string.IsNullOrWhiteSpace(a.fstrAltarReason) ? "Attended" : a.fstrAltarReason)</b></div>
                    }
                }
            </div>

            <div class="drawer-foot">
                <button class="p" @onclick="() => EditFromDetailAsync(d)">Edit visitor</button>
                <button class="d" @onclick="() => DeleteFromDetailAsync(d)">Delete</button>
            </div>
        </aside>
    </div>
}

@* ---------- Add / edit popup ---------- *@
@if (__edit is not null)
{
    <Modal Title="@(__isNew ? "Add visitor" : "Edit visitor")" Subtitle="Just the basics. The Connections team adds the rest" Icon="userplus" OnClose="() => __edit = null">
        <ChildContent>
            <div class="modal-sec">Personal</div>
            <div class="form-grid">
                <div class="field"><label>First name</label><input type="text" maxlength="50" @bind="__edit.fstrFirstname" /></div>
                <div class="field"><label>Last name</label><input type="text" maxlength="50" @bind="__edit.fstrLastname" /></div>
                <div class="field">
                    <label>Gender</label>
                    <select @bind="__edit.fstrGender">@foreach (var g in FixedLists.Genders) { <option value="@g">@g</option> }</select>
                </div>
                <div class="field">
                    <label>Adult / Child</label>
                    <select @bind="__edit.fstrAgeGroup">@foreach (var g in FixedLists.AgeGroups) { <option value="@g">@g</option> }</select>
                </div>
            </div>

            <div class="modal-sec">Contact</div>
            <div class="form-grid">
                <div class="field"><label>Phone number</label><input type="text" maxlength="30" @bind="__edit.fstrPhoneNumber" /></div>
                <div class="field"><label>Email address (optional)</label><input type="text" maxlength="150" @bind="__edit.fstrEmailAddress" /></div>
                <div class="field" style="grid-column:1/-1"><label>Address</label><input type="text" maxlength="250" @bind="__edit.fstrAddress" /></div>
            </div>

            <div class="modal-sec">Service</div>
            <div class="field">
                <label>Service attended</label>
                <select @bind="__serviceDate">
                    <option value="">Not attached to a service</option>
                    @foreach (var s in __services)
                    {
                        <option value="@s.fdtmServiceDate.ToString("yyyy-MM-dd")">@s.fstrServiceName - @s.fdtmServiceDate.ToString("dd MMM yyyy")@(!__isNew && __origAttendance?.fdtmServiceDate.Date == s.fdtmServiceDate.Date ? " (current)" : "")</option>
                    }
                </select>
                @if (!__isNew && __origAttendance is not null)
                {
                    <small class="hint">Changing this moves @__edit.fstrFirstname's attendance from @__origAttendance.fdtmServiceDate.ToString("dd MMM yyyy") to the service you pick.</small>
                }
            </div>

        </ChildContent>
        <Footer>
            <button class="btn btn-primary btn-sm" @onclick="SaveAsync">Save visitor</button>
            <button class="btn btn-sm" @onclick="() => __edit = null">Cancel</button>
        </Footer>
    </Modal>
}

@code {
    #region Private Fields

    private readonly CancellationTokenSource __cts = new();
    private List<VisitorModel> __visitors = [];
    private Dictionary<Guid, string> __todayReasons = [];
    private VisitorModel? __edit;
    private bool __isNew;
    private string __serviceDate = "";
    private List<ServiceModel> __services = [];
    private ServiceModel? __current;

    /// <summary>Raised after a visitor is saved or deleted, so the page can refresh its summary panel.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Raised with the chosen service date ("yyyy-MM-dd" or "all") so the page summary follows the list.</summary>
    [Parameter] public EventCallback<string> OnServiceChosen { get; set; }
    private string __viewDate = "";
    private VisitorAttendanceModel? __origAttendance;
    private bool __moreOpen;
    private string __moreSearch = "";
    private const int PillCount = 4;
    private string? __search;
    private string? __filterAge;
    private int __hereToday;
    private int __page = 1;
    private const int PageSize = 5;
    private ToastMessageModel? __toast;

    // Details panel
    private VisitorModel? __detail;
    private List<VisitorAttendanceModel> __detailVisits = [];
    private Dictionary<Guid, int> __noteCounts = [];

    #endregion

    protected override async Task OnInitializedAsync()
    {
        __services = (await ServiceRepo.SelectService(cancellationToken: __cts.Token))
            .Where(s => s.fdtmServiceDate.Date <= AppClock.Today)
            .OrderByDescending(s => s.fdtmServiceDate)
            .Take(150)
            .ToList();
        __current = __services.FirstOrDefault();
        __viewDate = __current?.fdtmServiceDate.ToString("yyyy-MM-dd") ?? "all";
        await LoadAsync();
    }

    public void Dispose()
    {
        __cts.Cancel();
        __cts.Dispose();
    }

    private void SetPage(int page) => __page = page;

    /// <summary>The visitors on the current page.</summary>
    private List<VisitorModel> PageItems()
    {
        var pages = Math.Max(1, (__visitors.Count + PageSize - 1) / PageSize);
        __page = Math.Clamp(__page, 1, pages);
        return __visitors.Skip((__page - 1) * PageSize).Take(PageSize).ToList();
    }

    /// <summary>Colour of the category chip: children violet, men amber, everyone else green.</summary>
    private static string CategoryClass(VisitorModel v) =>
        v.fstrAgeGroup == "Child" ? "v" : v.fstrGender == "Male" ? "w" : "g";

    private async Task SetAgeAsync(string? ageGroup)
    {
        __filterAge = ageGroup;
        await LoadAsync();
    }

    #region Details panel

    private async Task OpenDetailAsync(VisitorModel v)
    {
        __detail = v;
        var visits = await AttendanceRepo.SelectVisitorAttendance(visitorKey: v.flngKey, cancellationToken: __cts.Token);
        __detailVisits = visits.OrderByDescending(a => a.fdtmServiceDate).Take(5).ToList();
    }

    /// <summary>Refreshes the note counts after Member care adds a note.</summary>
    private async Task NotesChangedAsync()
    {
        await LoadNoteCountsAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task LoadNoteCountsAsync()
    {
        __noteCounts = (await NoteRepo.SelectVisitorNote(cancellationToken: __cts.Token))
            .GroupBy(n => n.flngVisitorKey)
            .ToDictionary(g => g.Key, g => g.Count());
    }

    private void CloseDetail() => __detail = null;

    private async Task EditFromDetailAsync(VisitorModel v)
    {
        __detail = null;
        await EditVisitorAsync(v);
    }

    private async Task DeleteFromDetailAsync(VisitorModel v)
    {
        __detail = null;
        await DeleteAsync(v);
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadAsync();
    }

    #endregion

    /// <summary>Reloads the list and tells the page so the summary panel is refreshed too.</summary>
    private async Task RefreshAsync()
    {
        __detail = null;
        await LoadAsync();
        await OnChanged.InvokeAsync();
    }

    private async Task LoadAsync()
    {
        __page = 1;
        var all = await VisitorRepo.SelectVisitor(
            ageGroup: string.IsNullOrEmpty(__filterAge) ? null : __filterAge,
            search: string.IsNullOrWhiteSpace(__search) ? null : __search.Trim(),
            cancellationToken: __cts.Token);

        // The list shows the people who attended the chosen service (the latest by default), or everyone for "All services".
        // Typing in the search box looks across everyone.
        var today = AppClock.Today;
        var serviceDate = DateTime.TryParse(__viewDate, out var picked) ? picked.Date : __current?.fdtmServiceDate.Date ?? today;
        var atService = await AttendanceRepo.SelectVisitorAttendance(serviceDate: serviceDate, cancellationToken: __cts.Token);

        // Visits of deleted visitors no longer count in the totals
        var active = (await VisitorRepo.SelectVisitor(cancellationToken: __cts.Token)).Select(v => v.flngKey).ToHashSet();
        atService = atService.Where(a => active.Contains(a.flngVisitorKey)).ToList();
        var here = atService.Select(a => a.flngVisitorKey).ToHashSet();
        __visitors = string.IsNullOrWhiteSpace(__search) && __viewDate != "all" ? all.Where(x => here.Contains(x.flngKey)).ToList() : all;

        __todayReasons = atService.Where(a => !string.IsNullOrEmpty(a.fstrAltarReason)).GroupBy(a => a.flngVisitorKey).ToDictionary(g => g.Key, g => g.First().fstrAltarReason!);
        var todays = serviceDate == today ? atService : await AttendanceRepo.SelectVisitorAttendance(serviceDate: today, cancellationToken: __cts.Token);
        __hereToday = todays.Select(a => a.flngVisitorKey).Distinct().Count();
        await LoadNoteCountsAsync();
    }

    /// <summary>The latest few services, plus the chosen one when it is an older service picked from "More".</summary>
    private IEnumerable<ServiceModel> PillServices()
    {
        var pills = __services.Take(PillCount).ToList();
        var chosen = __services.FirstOrDefault(s => s.fdtmServiceDate.ToString("yyyy-MM-dd") == __viewDate);
        if (chosen is not null && !pills.Contains(chosen)) pills.Add(chosen);
        return pills;
    }

    private static string PillText(ServiceModel s)
    {
        var parts = s.fstrServiceName.Split(" - ", 2);
        return $"{s.fdtmServiceDate:dd MMM} \u00b7 {(parts.Length > 1 ? parts[1] : parts[0])}";
    }

    /// <summary>Every past service for the "More" list, filtered by the search text and grouped by month (newest first).</summary>
    private IEnumerable<IGrouping<string, ServiceModel>> MoreGroups()
    {
        var q = __moreSearch?.Trim() ?? "";
        return __services
            .Where(s => q.Length == 0 || s.fstrServiceName.Contains(q, StringComparison.OrdinalIgnoreCase) || s.fdtmServiceDate.ToString("dd MMM yyyy").Contains(q, StringComparison.OrdinalIgnoreCase))
            .GroupBy(s => s.fdtmServiceDate.ToString("MMMM yyyy"));
    }

    /// <summary>The text on the service picker: the chosen service, or "All services".</summary>
    private string PickText()
    {
        if (__viewDate == "all") return "All services";
        var chosen = __services.FirstOrDefault(s => s.fdtmServiceDate.ToString("yyyy-MM-dd") == __viewDate);
        return chosen is null ? "Choose a service" : PillText(chosen);
    }

    /// <summary>Jumps to the most recent service.</summary>
    private async Task PickLatestAsync()
    {
        var latest = __services.FirstOrDefault();
        if (latest is not null) await PickServiceAsync(latest.fdtmServiceDate.ToString("yyyy-MM-dd"));
    }

    private async Task PickServiceAsync(string viewDate)
    {
        __moreOpen = false;
        __moreSearch = "";
        __viewDate = viewDate;
        await LoadAsync();
        await OnServiceChosen.InvokeAsync(__viewDate);
    }

    private void NewVisitor()
    {
        __origAttendance = null;
        __edit = new VisitorModel { fstrGender = "Male", fstrAgeGroup = "Adult", fstrStatus = "Visitor" };
        // Pre-select today's service if there is one, otherwise the most recent.
        var current = __services.FirstOrDefault(s => s.fdtmServiceDate.Date == AppClock.Today) ?? __services.FirstOrDefault();
        __serviceDate = current?.fdtmServiceDate.ToString("yyyy-MM-dd") ?? "";
        __isNew = true;
    }

    private async Task EditVisitorAsync(VisitorModel v)
    {
        // Find the attendance being edited: the one at the service being viewed, otherwise the visitor's latest.
        var visits = await AttendanceRepo.SelectVisitorAttendance(visitorKey: v.flngKey, cancellationToken: __cts.Token);
        var viewed = DateTime.TryParse(__viewDate, out var vd) ? visits.FirstOrDefault(a => a.fdtmServiceDate.Date == vd.Date) : null;
        __origAttendance = viewed ?? visits.OrderByDescending(a => a.fdtmServiceDate).FirstOrDefault();
        __serviceDate = __origAttendance?.fdtmServiceDate.ToString("yyyy-MM-dd") ?? "";

        __edit = new VisitorModel
        {
            flngKey = v.flngKey, fstrFirstname = v.fstrFirstname, fstrLastname = v.fstrLastname, fstrGender = v.fstrGender,
            fstrAgeGroup = v.fstrAgeGroup, fstrPhoneNumber = v.fstrPhoneNumber, fstrEmailAddress = v.fstrEmailAddress,
            fstrAddress = v.fstrAddress, fdtmLastContactDate = v.fdtmLastContactDate, fdtmNextContactDate = v.fdtmNextContactDate,
            fstrStatus = v.fstrStatus, fstrJoinedChurch = v.fstrJoinedChurch, fstrMembershipTransferNote = v.fstrMembershipTransferNote,
            fdtmBaptisedOn = v.fdtmBaptisedOn, fdtmClassStartedOn = v.fdtmClassStartedOn, fdtmTier2On = v.fdtmTier2On, fdtmInterviewOn = v.fdtmInterviewOn, fdtmInauguratedOn = v.fdtmInauguratedOn, fdtmDateOfBirth = v.fdtmDateOfBirth, fstrPath = v.fstrPath,
            flngMemberKey = v.flngMemberKey, fblnActive = v.fblnActive
        };
        __isNew = false;
    }

    private async Task SaveAsync()
    {
        if (__edit is null) return;
        if (string.IsNullOrWhiteSpace(__edit.fstrFirstname) || string.IsNullOrWhiteSpace(__edit.fstrLastname))
        {
            __toast = new() { ToastType = ToastTypeModel.Warning, Message = "First name and last name are required" };
            return;
        }

        __edit.fstrWho = AppConstants.Who;
        __toast = await VisitorRepo.AddOrUpdateVisitor(__edit, __isNew, __cts.Token);
        if (!__toast.IsSuccess) return;

        // A brand-new visitor linked to a service gets that service's attendance recorded straight away.
        if (__isNew && DateTime.TryParse(__serviceDate, out var serviceDate))
        {
            var attendance = new VisitorAttendanceModel { flngVisitorKey = __edit.flngKey, fdtmServiceDate = serviceDate.Date, fstrWho = AppConstants.Who };
            var result = await AttendanceRepo.AddOrUpdateVisitorAttendance(attendance, true, __cts.Token);
            if (!result.IsSuccess) __toast = result;
        }
        else if (!__isNew && !await MoveAttendanceAsync())
        {
            return;
        }

        __edit = null;
        await RefreshAsync();
    }

    /// <summary>
    /// Moves the visitor's attendance to the service picked in the popup: the new service is recorded first, then the old
    /// record is switched off, so a clash (already recorded for that date) leaves everything as it was.
    /// </summary>
    /// <returns>False when the move failed and the popup should stay open.</returns>
    private async Task<bool> MoveAttendanceAsync()
    {
        if (__edit is null) return true;
        var picked = DateTime.TryParse(__serviceDate, out var pickedDate) ? pickedDate.Date : (DateTime?)null;
        var original = __origAttendance;
        if (picked == original?.fdtmServiceDate.Date) return true;

        if (picked is DateTime newDate)
        {
            var added = new VisitorAttendanceModel { flngVisitorKey = __edit.flngKey, fdtmServiceDate = newDate, fstrNotes = original?.fstrNotes, fstrWho = AppConstants.Who };
            var result = await AttendanceRepo.AddOrUpdateVisitorAttendance(added, true, __cts.Token);
            if (!result.IsSuccess)
            {
                __toast = new() { ToastType = ToastTypeModel.Warning, Message = $"{__edit.fstrFirstname} is already recorded for {newDate:dd MMM yyyy}, or the service could not be changed" };
                return false;
            }

            // The altar reason is only stored when a record is updated, so carry it across with a second step
            if (!string.IsNullOrEmpty(original?.fstrAltarReason))
            {
                added.fstrAltarReason = original.fstrAltarReason;
                await AttendanceRepo.AddOrUpdateVisitorAttendance(added, false, __cts.Token);
            }
        }

        if (original is not null)
        {
            // The visit at the old service is deleted, so it no longer counts anywhere
            await AttendanceRepo.DeleteVisitorAttendance(original.flngKey, AppConstants.Who, __cts.Token);
        }

        return true;
    }

    private async Task DeleteAsync(VisitorModel v)
    {
        __toast = await VisitorRepo.DeleteVisitor(v.flngKey, AppConstants.Who, __cts.Token);
        if (!__toast.IsSuccess) return;

        // Their visits go with them, so no total or summary keeps counting a deleted visitor
        foreach (var visit in await AttendanceRepo.SelectVisitorAttendance(visitorKey: v.flngKey, cancellationToken: __cts.Token))
            await AttendanceRepo.DeleteVisitorAttendance(visit.flngKey, AppConstants.Who, __cts.Token);

        await RefreshAsync();
    }
}
