@* Light / dark switch. wwwroot/theme.js does the work, so this is plain markup and also works on the static sign-in pages.
   The sun shows in the light theme and the moon in the dark theme (chosen by CSS). *@
<button type="button" class="theme-toggle @Class" data-theme-toggle title="Switch between light and dark" aria-label="Switch between light and dark theme">
    <svg class="icon-sun" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
    <svg class="icon-moon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.6 6.6 0 0 0 10.7 10.7z" /></svg>
</button>

@code {
    /// <summary>Extra CSS classes, for example "floating" to pin the button to the top right corner.</summary>
    [Parameter] public string? Class { get; set; }

    /// <summary>Icon width and height in pixels.</summary>
    [Parameter] public int Size { get; set; } = 18;
}
