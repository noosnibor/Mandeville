@implements IDisposable
@inject IServiceRepository ServiceRepo

<ToastBar Toast="__toast" />

<div class="card">
    <h2>@(__editing is null ? "Add service" : "Edit service")</h2>
    @if (__editing is null)
    {
        <p class="hint" style="margin-top:0">Create a service members can check in to. Visitors, attendance and the thank you messages all use this list.</p>
    }
    else
    {
        <p class="hint" style="margin-top:0">Change this service, then press Save changes.</p>
    }
    <div class="field" style="margin-bottom:.6rem"><label>Service name</label><input type="text" maxlength="100" @bind="__new.fstrServiceName" /></div>
    <div class="form-grid">
        <div class="field">
            <label>Date</label>
            <input type="date" @bind="__new.fdtmServiceDate" />
            @if (__editing is not null && __new.fdtmServiceDate.Date != __editing.fdtmServiceDate.Date)
            {
                <small class="hint">Visitors already recorded for this service stay on the old date (@__editing.fdtmServiceDate.ToString("d MMM yyyy")).</small>
            }
        </div>
        <div class="field"><label>Start time</label><input type="time" @bind="__startTime" /></div>
    </div>
    <div class="field"><label>Location</label><input type="text" maxlength="150" @bind="__new.fstrLocation" /></div>
    <div class="actions" style="margin-top:.8rem">
        <button class="btn btn-primary btn-sm" @onclick="SaveAsync">@(__editing is null ? "Add service" : "Save changes")</button>
        @if (__editing is not null) { <button class="btn btn-sm" @onclick="CancelEdit">Cancel</button> }
    </div>
</div>

<div class="card">
    <h2>Services <span>@__services.Count</span></h2>
    @if (__services.Count == 0)
    {
        <p class="empty">No services yet. Add the first one above.</p>
    }
    else
    {
        <div class="fin-list inner">
            @foreach (var s in __services)
            {
                <div class="fin-row">
                    <div class="evg-date"><b>@s.fdtmServiceDate.Day</b><span>@s.fdtmServiceDate.ToString("MMM")</span></div>
                    <div class="fin-nm">
                        <b>@s.fstrServiceName @if (s.fdtmServiceDate.Date > AppClock.Today) { <span class="chip g">Upcoming</span> }@if (__editing?.flngKey == s.flngKey) { <span class="chip">Editing</span> }</b>
                        <small>@s.fdtmServiceDate.ToString("dddd, d MMM yyyy") &middot; @(s.ftimStartTime.HasValue ? DateTime.Today.Add(s.ftimStartTime.Value).ToString("h:mm tt") : "-") &middot; @(string.IsNullOrWhiteSpace(s.fstrLocation) ? "-" : s.fstrLocation)</small>
                    </div>
                    <div class="fin-act">
                        <button class="btn btn-sm" @onclick="() => StartEdit(s)">Edit</button>
                        <button class="btn btn-sm care-del" @onclick="() => __deleting = s">Delete</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ---------- Delete confirmation ---------- *@
@if (__deleting is not null)
{
    <Modal Title="Delete this service?" Subtitle="@($"{__deleting.fstrServiceName} - {__deleting.fdtmServiceDate:ddd d MMM yyyy}")" Icon="trash" OnClose="() => __deleting = null">
        <ChildContent>
            <p>It will no longer appear in the service lists, check-in or the Visitors pages.</p>
            <p class="hint">Attendance and visitor records already saved for that day are kept.</p>
        </ChildContent>
        <Footer>
            <button class="btn btn-sm care-del" disabled="@__busy" @onclick="DeleteAsync">Delete service</button>
            <button class="btn btn-sm" @onclick="() => __deleting = null">Cancel</button>
        </Footer>
    </Modal>
}

@code {
    #region Private Fields

    private readonly CancellationTokenSource __cts = new();
    private ToastMessageModel? __toast;
    private List<ServiceModel> __services = [];
    private ServiceModel __new = NewService();
    private TimeOnly? __startTime = new TimeOnly(9, 0);
    private ServiceModel? __editing;
    private ServiceModel? __deleting;
    private bool __busy;

    #endregion

    #region Lifecycle

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public void Dispose() { __cts.Cancel(); __cts.Dispose(); }

    #endregion

    #region Loading, adding, editing and deleting

    private static ServiceModel NewService() => new() { fdtmServiceDate = AppClock.Today, fstrServiceName = "Sunday service" };

    private async Task LoadAsync()
    {
        try { __services = (await ServiceRepo.SelectService(cancellationToken: __cts.Token)).OrderByDescending(s => s.fdtmServiceDate).ToList(); }
        catch (OperationCanceledException) { }
    }

    /// <summary>Fills the form with the chosen service so it can be changed.</summary>
    private void StartEdit(ServiceModel s)
    {
        __editing = s;
        __new = new ServiceModel
        {
            flngKey = s.flngKey, fstrServiceName = s.fstrServiceName, fdtmServiceDate = s.fdtmServiceDate,
            ftimStartTime = s.ftimStartTime, fstrLocation = s.fstrLocation, fblnActive = true
        };
        __startTime = s.ftimStartTime.HasValue ? TimeOnly.FromTimeSpan(s.ftimStartTime.Value) : null;
    }

    private void CancelEdit()
    {
        __editing = null;
        __new = NewService();
        __startTime = new TimeOnly(9, 0);
    }

    /// <summary>Adds a new service, or saves the changes when an existing one is being edited.</summary>
    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(__new.fstrServiceName)) { __toast = new() { ToastType = ToastTypeModel.Warning, Message = "Service name is required" }; return; }
        __new.fstrWho = AppConstants.Who;
        __new.ftimStartTime = __startTime?.ToTimeSpan();
        __toast = await ServiceRepo.AddOrUpdateService(__new, insert: __editing is null, __cts.Token);
        if (!__toast.IsSuccess) return;

        CancelEdit();
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (__deleting is null || __busy) return;

        __busy = true;
        try
        {
            var key = __deleting.flngKey;
            __toast = await ServiceRepo.DeleteService(key, AppConstants.Who, __cts.Token);
            if (!__toast.IsSuccess) return;

            // Do not leave a deleted service open in the form
            if (__editing?.flngKey == key) CancelEdit();
            __deleting = null;
            await LoadAsync();
        }
        catch (OperationCanceledException) { }
        finally { __busy = false; }
    }

    #endregion
}
