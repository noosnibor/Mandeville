@implements IDisposable
@inject IVisitorRepository VisitorRepo
@inject IMemberRepository MemberRepo
@inject IMemberTypeRepository MemberTypeRepo
@inject IVisitorAttendanceRepository AttendanceRepo

<ToastBar Toast="__toast" />

@* ---------- Summary cards ---------- *@
<div class="vk">
    <div class="vkc" style="--c:#1c86f2"><div class="vk-h"><span>Incoming</span><span class="vk-i"><Icon Name="users" Size="17" Stroke="1.8" /></span></div><b>@__list.Count</b><small>All stages</small></div>
    <div class="vkc" style="--c:#f59e0b"><div class="vk-h"><span>In progress</span><span class="vk-i"><Icon Name="clock" Size="17" Stroke="1.8" /></span></div><b>@__list.Count(v => StageOf(v) is >= 1 and <= 3)</b><small>Underway</small></div>
    <div class="vkc" style="--c:#10b981"><div class="vk-h"><span>Ready to add</span><span class="vk-i"><Icon Name="check" Size="17" Stroke="2" /></span></div><b>@__list.Count(v => StageOf(v) == 4)</b><small>Inaugurated</small></div>
</div>

@* ---------- Stage filter (tap to filter) ---------- *@
<div class="svc-pick tm in-pick">
    <span class="sp-ic"><Icon Name="layers" Size="17" Stroke="1.9" /></span>
    <span class="sp-tx"><small>Stage</small><b>@(__filter is int fs ? Stages[fs] : "All stages")</b></span>
    <span class="sp-cnt">@(__filter is int fc ? __list.Count(v => StageOf(v) == fc) : __list.Count)</span>
    <span class="sp-ch"><Icon Name="chevron" Size="16" Stroke="2" /></span>
    <select class="cl-pick" aria-label="Filter by stage" @onchange="e => __filter = int.TryParse(e.Value?.ToString(), out var v) ? v : null">
        <option value="" selected="@(__filter is null)">All stages (@__list.Count)</option>
        @for (var stage = 0; stage < Stages.Length; stage++)
        {
            var s2 = stage;
            <option value="@s2" selected="@(__filter == s2)">@Stages[s2] (@__list.Count(v => StageOf(v) == s2))</option>
        }
    </select>
</div>

<div class="in-seg" role="group" aria-label="Filter by stage">
    <button class="@(__filter is null ? "on" : "")" @onclick="() => __filter = null">All<i>@__list.Count</i></button>
    @for (var stage = 0; stage < Stages.Length; stage++)
    {
        var s = stage;
        <button class="@(__filter == s ? "on" : "")" @onclick="() => __filter = s">@Stages[s]<i>@__list.Count(v => StageOf(v) == s)</i></button>
    }
</div>

<div class="cl-line">
    <label class="vsearch inc-search">
        <Icon Name="search" Size="18" Stroke="1.5" />
        <input class="msearch" type="text" placeholder="Search name or phone..." aria-label="Search incoming members" @bind="__listSearch" @bind:event="oninput" />
    </label>
</div>

@* ---------- Cards ---------- *@
<div class="mgrid">
    @foreach (var v in Shown())
    {
        var stage = StageOf(v);
        <div class="icard @(stage == 4 ? "ready" : "")" @onclick="() => Open(v)">
            <div class="vcard-head">
                <div class="ucard-avatar" style="background:@AvatarStyle.Colour(v.flngKey)">@AvatarStyle.Initials(v.fstrFirstname, v.fstrLastname)</div>
                <div class="ucard-text">
                    <b>@v.FullName</b>
                    <small>@(string.IsNullOrWhiteSpace(v.fstrFollowUpName) ? "Waiting for a connector" : "Connector: " + v.fstrFollowUpName)</small>
                </div>
                <span class="inc-path @(stage == 4 ? "join" : "new")">@Stages[stage]</span>
            </div>
            <div class="in-steps">
                @for (var n = 1; n < Stages.Length; n++)
                {
                    <div class="in-step @(n <= stage ? "done" : "") @(n == stage ? "cur" : "")"><i></i>@Stages[n]</div>
                }
            </div>
            <div class="vcard-foot soft">
                <button @onclick="() => Open(v)" @onclick:stopPropagation="true">Update dates</button>
                @if (stage == 4)
                {
                    <button class="p" @onclick="() => ConvertFromListAsync(v)" @onclick:stopPropagation="true">Add to members</button>
                }
            </div>
        </div>
    }
</div>
@if (Shown().Count == 0)
{
    <div class="empty-state">
        <div class="empty-ico"><Icon Name="userplus" Size="30" Stroke="1.6" /></div>
        <h3>No incoming members here</h3>
        <p>People appear when their team member adds them after confirming by phone.</p>
    </div>
}

<button class="fab" @onclick="OpenAdd"><Icon Name="plus" Size="16" />Add incoming</button>

@* ---------- Details drawer ---------- *@
@if (__edit is not null)
{
    var e = __edit;
    var stage = StageOf(e);
    <div class="drawer-backdrop" @onclick="Close">
        <aside class="drawer" role="dialog" aria-modal="true" aria-label="Incoming member" @onclick:stopPropagation="true">
            <div class="drawer-cover" style="background:@AvatarStyle.Cover(e.flngKey)">
                <button class="drawer-close" aria-label="Close" @onclick="Close">&#10005;</button>
            </div>
            <div class="drawer-top">
                <div class="drawer-avatar" style="background:@AvatarStyle.Colour(e.flngKey)">@AvatarStyle.Initials(e.fstrFirstname, e.fstrLastname)</div>
                <h3>@e.FullName</h3>
                <small>@(string.IsNullOrWhiteSpace(e.fstrPhoneNumber) ? "No phone" : e.fstrPhoneNumber)</small>
                <div class="drawer-status"><span class="inc-path @(stage == 4 ? "join" : "new")">@Stages[stage]</span></div>
            </div>

            <div class="drawer-card">
                <h4>Membership stage</h4>
                <div class="stg big">
                    @for (var n = 1; n < Stages.Length; n++)
                    {
                        <span class="stg-step @(n <= stage ? "done" : "") @(n == stage ? "cur" : "")">@Stages[n]</span>
                    }
                </div>
                <p class="hint">The stage follows the dates below. Add a Tier 1 date and the person moves to Tier 1, and so on.</p>
            </div>

            <div class="drawer-card">
                <h4>Dates</h4>
                <div class="form-grid">
                    <div class="field"><label>Baptised on</label><input type="date" @bind="e.fdtmBaptisedOn" /></div>
                    <div class="field"><label>Tier 1 on</label><input type="date" @bind="e.fdtmClassStartedOn" /></div>
                    <div class="field"><label>Tier 2 on</label><input type="date" @bind="e.fdtmTier2On" /></div>
                    <div class="field"><label>Interview on</label><input type="date" @bind="e.fdtmInterviewOn" /></div>
                    <div class="field"><label>Inauguration on</label><input type="date" @bind="e.fdtmInauguratedOn" /></div>
                </div>
            </div>

            <div class="drawer-card">
                <h4>Details</h4>
                <div class="ir"><span>Connector</span><b>@(string.IsNullOrWhiteSpace(e.fstrFollowUpName) ? "Not assigned" : e.fstrFollowUpName)</b></div>
                <div class="ir"><span>Last attended</span><b>@(e.fdtmLastAttended?.ToString("dd MMM yyyy") ?? "-")</b></div>
                <div class="ir"><span>Visits</span><b>@e.flngVisitCount</b></div>
            </div>

            <div class="drawer-foot">
                <button class="p" @onclick="SaveAsync">Save</button>
            </div>
            @if (stage == 4)
            {
                <div class="drawer-foot" style="padding-top:0">
                    <button class="p" @onclick="ConvertAsync">Add to members</button>
                </div>
            }
            <div class="drawer-foot solo" style="padding-top:0">
                <button class="d" @onclick="() => __confirmDelete = true"><Icon Name="trash" Size="16" Stroke="1.6" /> Delete</button>
            </div>
        </aside>
    </div>
}

@* ---------- Delete confirmation ---------- *@
@if (__confirmDelete && __edit is not null)
{
    <Modal Title="@DeleteTitle" Subtitle="This cannot be undone from the app" Icon="trash" OnClose="() => __confirmDelete = false">
        <ChildContent>
            <p class="hint" style="margin:0">They will be removed from Incoming members and from the Visitors list, and their visits are deleted with them.</p>
        </ChildContent>
        <Footer>
            <button class="btn btn-sm" @onclick="() => __confirmDelete = false">Cancel</button>
            <button class="btn btn-danger btn-sm" @onclick="DeleteAsync">Yes, delete</button>
        </Footer>
    </Modal>
}

@* ---------- Add incoming popup ---------- *@
@if (__adding)
{
    <Modal Title="Add incoming member" Subtitle="Pick a visitor who wants to join the church" Icon="userplus" OnClose="() => __adding = false">
        <ChildContent>
            <div class="mfilter" style="margin-bottom:.6rem">
                <input type="text" placeholder="Search visitor by name or phone" @bind="__search" @bind:event="oninput" @onkeydown="OnSearchKey" />
                <button class="btn btn-dark btn-sm" @onclick="SearchAsync">Search</button>
            </div>
            @foreach (var v in __results)
            {
                <div class="ucard pick @(__picked?.flngKey == v.flngKey ? "selected" : "")" @onclick="() => __picked = v">
                    <div class="ucard-avatar" style="background:@AvatarStyle.Colour(v.flngKey)">@AvatarStyle.Initials(v.fstrFirstname, v.fstrLastname)</div>
                    <div class="ucard-text"><b>@v.FullName</b><small>@v.fstrPhoneNumber</small></div>
                    <span class="tag">@v.fstrStatus</span>
                </div>
            }
            @if (__searched && __results.Count == 0) { <p class="empty">No visitor found. Register them on the Visitors page first.</p> }
        </ChildContent>
        <Footer>
            <button class="btn btn-primary btn-sm" disabled="@(__picked is null)" @onclick="AddIncomingAsync">Add to incoming</button>
            <button class="btn btn-sm" @onclick="() => __adding = false">Cancel</button>
        </Footer>
    </Modal>
}

@code {
    #region Private Fields

    private readonly CancellationTokenSource __cts = new();

    /// <summary>Raised after the list changes (save, add, convert) so the page summary refreshes.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<VisitorModel> __list = [];
    private int? __filter;
    private string? __listSearch;
    private VisitorModel? __edit;
    private bool __confirmDelete;
    private string DeleteTitle => $"Delete {__edit?.FullName}?";
    private ToastMessageModel? __toast;

    // Add popup
    private bool __adding, __searched;
    private string? __search;
    private List<VisitorModel> __results = [];
    private VisitorModel? __picked;

    /// <summary>The membership stages in order. Stage 0 means no class date has been added yet.</summary>
    private static readonly string[] Stages = ["Not started", "Tier 1", "Tier 2", "Interview", "Inauguration"];

    #endregion

    protected override async Task OnInitializedAsync() => await LoadAsync();

    public void Dispose()
    {
        __cts.Cancel();
        __cts.Dispose();
    }

    #region Display helpers

    /// <summary>The stage follows the dates: the latest date filled in decides it.</summary>
    private static int StageOf(VisitorModel v) =>
        v.fdtmInauguratedOn.HasValue ? 4
        : v.fdtmInterviewOn.HasValue ? 3
        : v.fdtmTier2On.HasValue ? 2
        : v.fdtmClassStartedOn.HasValue ? 1
        : 0;

    private List<VisitorModel> Shown()
    {
        var q = string.IsNullOrWhiteSpace(__listSearch) ? null : __listSearch.Trim();
        return __list
            .Where(v => __filter is null || StageOf(v) == __filter)
            .Where(v => q is null
                || v.FullName.Contains(q, StringComparison.OrdinalIgnoreCase)
                || (v.fstrPhoneNumber ?? string.Empty).Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();
    }

    #endregion

    #region Loading and editing

    private async Task LoadAsync()
    {
        __list = await VisitorRepo.SelectVisitor(status: "Incoming Member", active: true, cancellationToken: __cts.Token);
        if (__ready) await OnChanged.InvokeAsync();
        __ready = true;
    }

    private bool __ready;

    private void Open(VisitorModel v) => __edit = CopyOf(v);

    private void Close() => __edit = null;

    /// <summary>A full copy so the drawer can be edited and cancelled without touching the list.</summary>
    private static VisitorModel CopyOf(VisitorModel v) => new()
    {
        flngKey = v.flngKey, fstrFirstname = v.fstrFirstname, fstrLastname = v.fstrLastname, fstrGender = v.fstrGender,
        fstrAgeGroup = v.fstrAgeGroup, fstrPhoneNumber = v.fstrPhoneNumber, fstrEmailAddress = v.fstrEmailAddress,
        fstrAddress = v.fstrAddress, fdtmLastContactDate = v.fdtmLastContactDate, fdtmNextContactDate = v.fdtmNextContactDate,
        fstrStatus = v.fstrStatus, fstrJoinedChurch = v.fstrJoinedChurch, fstrMembershipTransferNote = v.fstrMembershipTransferNote,
        fdtmBaptisedOn = v.fdtmBaptisedOn, fdtmClassStartedOn = v.fdtmClassStartedOn, fdtmTier2On = v.fdtmTier2On,
        fdtmInterviewOn = v.fdtmInterviewOn, fdtmInauguratedOn = v.fdtmInauguratedOn, fdtmDateOfBirth = v.fdtmDateOfBirth, fstrPath = v.fstrPath,
        flngMemberKey = v.flngMemberKey, fblnActive = v.fblnActive, fstrFollowUpName = v.fstrFollowUpName,
        fdtmLastAttended = v.fdtmLastAttended, flngVisitCount = v.flngVisitCount
    };

    private async Task SaveAsync()
    {
        if (__edit is null) return;
        __edit.fstrWho = AppConstants.Who;
        __toast = await VisitorRepo.AddOrUpdateVisitor(__edit, false, __cts.Token);
        if (!__toast.IsSuccess) return;
        __toast = new() { ToastType = ToastTypeModel.Success, Message = $"Saved. {__edit.FullName} is now at {Stages[StageOf(__edit)]}" };
        __edit = null;
        await LoadAsync();
    }

    #endregion

    #region Convert to member

    /// <summary>Finds the member type named "Member"; creates it when the church has not set one up yet.</summary>
    private async Task<Guid?> EnsureMemberTypeAsync()
    {
        var types = await MemberTypeRepo.SelectMemberType(active: true, cancellationToken: __cts.Token);
        var existing = types.FirstOrDefault(t => string.Equals(t.fstrName.Trim(), "Member", StringComparison.OrdinalIgnoreCase));
        if (existing is not null) return existing.flngKey;

        var created = new MemberTypeModel { flngKey = Guid.NewGuid(), fstrName = "Member", fstrWho = AppConstants.Who };
        var result = await MemberTypeRepo.AddOrUpdateMemberType(created, true, __cts.Token);
        if (!result.IsSuccess)
        {
            __toast = result;
            return null;
        }
        return created.flngKey;
    }

    /// <summary>The Add to members button on a list row.</summary>
    private async Task ConvertFromListAsync(VisitorModel v)
    {
        __edit = CopyOf(v);
        await ConvertAsync();
    }

    /// <summary>Creates the member record from the visitor and marks the visitor as a Member. Only offered once the person is at Inauguration.</summary>
    private async Task ConvertAsync()
    {
        if (__edit is null || StageOf(__edit) != 4) return;

        // The new member starts with the member type "Member" (created once if it does not exist yet).
        var typeKey = await EnsureMemberTypeAsync();
        if (typeKey is null) return;

        var member = new MemberModel
        {
            flngMemberTypeKey = typeKey,
            fstrFirstname = __edit.fstrFirstname,
            fstrLastname = __edit.fstrLastname,
            fstrGender = __edit.fstrGender,
            fstrEmailAddress = __edit.fstrEmailAddress,
            fstrPhoneNumber = __edit.fstrPhoneNumber,
            fstrHomeAddress = __edit.fstrAddress,
            fdtmJoinDate = __edit.fdtmInauguratedOn ?? AppClock.Today,
            fstrMembershipStatus = "Active",
            fblnActive = true,
            fstrWho = AppConstants.Who
        };

        var created = await MemberRepo.AddOrUpdateMember(member, true, __cts.Token);
        if (!created.IsSuccess)
        {
            __toast = created;
            return;
        }

        __edit.fstrStatus = "Member";
        __edit.flngMemberKey = member.flngKey;
        __edit.fstrWho = AppConstants.Who;
        var linked = await VisitorRepo.AddOrUpdateVisitor(__edit, false, __cts.Token);

        __toast = linked.IsSuccess
            ? new() { ToastType = ToastTypeModel.Success, Message = $"{__edit.FullName} is now a member. Their join date is {member.fdtmJoinDate:d MMM yyyy}. Add their service on the Members page" }
            : linked;

        __edit = null;
        await LoadAsync();
    }

    #endregion

    #region Delete

    /// <summary>Deletes the visitor record and their visits, so no list, total or summary keeps counting them.</summary>
    private async Task DeleteAsync()
    {
        if (__edit is null) return;
        var person = __edit;

        __toast = await VisitorRepo.DeleteVisitor(person.flngKey, AppConstants.Who, __cts.Token);
        __confirmDelete = false;
        if (!__toast.IsSuccess) return;

        foreach (var visit in await AttendanceRepo.SelectVisitorAttendance(visitorKey: person.flngKey, cancellationToken: __cts.Token))
            await AttendanceRepo.DeleteVisitorAttendance(visit.flngKey, AppConstants.Who, __cts.Token);

        __edit = null;
        await LoadAsync();
    }

    #endregion

    #region Add incoming

    private void OpenAdd()
    {
        __adding = true;
        __search = null;
        __results = [];
        __picked = null;
        __searched = false;
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SearchAsync();
    }

    private async Task SearchAsync()
    {
        var found = await VisitorRepo.SelectVisitor(search: string.IsNullOrWhiteSpace(__search) ? null : __search.Trim(), active: true, cancellationToken: __cts.Token);
        __results = found.Where(v => v.fstrStatus is "Visitor" or "Regular Visitor").Take(8).ToList();
        __searched = true;
    }

    private async Task AddIncomingAsync()
    {
        if (__picked is null) return;

        var v = CopyOf(__picked);
        v.fstrStatus = "Incoming Member";
        if (string.IsNullOrWhiteSpace(v.fstrPath)) v.fstrPath = "Joining the church";
        v.fstrWho = AppConstants.Who;

        __toast = await VisitorRepo.AddOrUpdateVisitor(v, false, __cts.Token);
        if (!__toast.IsSuccess) return;

        __adding = false;
        await LoadAsync();
    }

    #endregion
}
