@inject NavigationManager Navigation

@code {
    /// <summary>Not signed in: go to the sign-in page and come back to this address afterwards.</summary>
    protected override void OnInitialized()
    {
        var back = Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri));
        Navigation.NavigateTo($"account/signin?returnUrl={back}", forceLoad: true);
    }
}
